# .env.example.local
# --- Frontend ---
FRONTEND_URL=http://127.0.0.1:8888

# --- WebApi ---
ASPNETCORE_ENVIRONMENT=Development
DB_PROVIDER=MySql
ConnectionStrings__DbConnectionString=Server=localhost;Port=3306;Database=spotifylibrarybasic;User=spotify;Password=TwojeHaslo;SslMode=None;AllowPublicKeyRetrieval=True;;

# --- Spotify ---
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_API_URL=https://api.spotify.com/v1/

# Klucze i ustawienia AI konfigurujesz po pierwszym logowaniu administratora w panelu /ai-settings.

# --- Docker (opcjonalnie przy compose) ---
MYSQL_ROOT_PASSWORD=example
MYSQL_DATABASE=spotifybasic
DB_CONNECTION_STRING=Server=db;Port=3306;Database=spotifybasic;User=root;Password=example;SslMode=None;

# Podmiana pliku appsettings frontu (opcjonalnie)
# FRONTEND_APPSETTINGS_PATH=./Frontend/wwwroot/appsettings.json
