# .env.example.prod
# --- Frontend ---
FRONTEND_URL=https://your-frontend.example.com

# --- WebApi ---
ASPNETCORE_ENVIRONMENT=Production
DB_PROVIDER=MySql
# Format połączenia zależny od infrastruktury (np. RDS/Azure/MySQL)
ConnectionStrings__DbConnectionString=Server=db;Port=3306;Database=spotifybasic;User=root;Password=change_me;SslMode=None;AllowPublicKeyRetrieval=True;

# --- Spotify ---
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
SPOTIFY_REDIRECT_URI=https://your-frontend.example.com/callback
SPOTIFY_API_URL=https://api.spotify.com/v1/

# --- Docker ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=spotifybasic

# Podmiana pliku appsettings frontu (opcjonalnie)
FRONTEND_APPSETTINGS_PATH=./Frontend/wwwroot/appsettings.prod.json