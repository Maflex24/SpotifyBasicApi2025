<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Spotify Library</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Strona główna</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tags">Tagi</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ai">Asystent AI</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sync">Synchronizacja</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="artists">Artyści</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="albums">Albumy</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tracks">Utwory</NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="playlists">Playlisty</NavLink>
            <div class="px-2 py-1">
                @if (playlistFolders.Count == 0 && !foldersLoaded)
                {
                    <div class="text-secondary small">Wczytywanie…</div>
                }
                else
                {
                    @RenderFolderTree(null, 0)
                }
            </div>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<FolderItem> playlistFolders = new();
    private List<PlaylistNavItem> folderPlaylists = new();
    private bool foldersLoaded = false;
    private HashSet<long> expandedFolderIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFoldersAndPlaylists();
    }

    private async Task LoadFoldersAndPlaylists()
    {
        try
        {
            var folders = await Http.GetFromJsonAsync<List<FolderItem>>("api/playlist-folders");
            playlistFolders = folders ?? new List<FolderItem>();

            var pls = await Http.GetFromJsonAsync<PlaylistsResponse>("api/library/playlists?page=1&pageSize=500");
            folderPlaylists = pls?.items?.Select(p => new PlaylistNavItem { Id = p.Id, Name = p.Name, FolderId = p.FolderId, Images = p.Images ?? new List<SpotifyImage>() }).ToList() ?? new List<PlaylistNavItem>();
            foldersLoaded = true;
        }
        catch
        {
            foldersLoaded = true;
        }
    }

    private RenderFragment RenderFolderTree(long? parentId, int depth) => builder =>
    {
        int seq = 0;
        var children = playlistFolders.Where(f => f.ParentId == parentId).OrderBy(f => f.Name).ToList();
        foreach (var f in children)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", $"padding-left:{depth * 12}px");
            builder.OpenElement(seq++, "details");
            if (expandedFolderIds.Contains(f.Id))
                builder.AddAttribute(seq++, "open", true);
            builder.OpenElement(seq++, "summary");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => ToggleFolder(f.Id)));
            builder.AddAttribute(seq++, "onclick:stopPropagation", true);
            builder.AddAttribute(seq++, "onclick:preventDefault", true);
            builder.AddContent(seq++, f.Name);
            builder.CloseElement();

            // playlists in folder
            var pls = folderPlaylists.Where(p => p.FolderId == f.Id).OrderBy(p => p.Name).ToList();
            foreach (var p in pls)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "d-flex align-items-center gap-2 mb-1" );

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "cover-container");
                builder.OpenElement(seq++, "img");
                builder.AddAttribute(seq++, "class", "cover-img-56");
                builder.AddAttribute(seq++, "src", GetPlaylistThumbUrl(p.Id));
                builder.AddAttribute(seq++, "alt", "okładka");
                builder.CloseElement();
                builder.OpenElement(seq++, "button");
                builder.AddAttribute(seq++, "class", "cover-overlay");
                builder.AddAttribute(seq++, "title", "Odtwórz");
                builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => PlayPlaylist(p.Id)));
                builder.AddContent(seq++, "▶");
                builder.CloseElement();
                builder.CloseElement();

                builder.OpenElement(seq++, "a");
                builder.AddAttribute(seq++, "href", $"/playlists/{p.Id}");
                builder.AddContent(seq++, p.Name);
                builder.CloseElement();

                builder.CloseElement();
            }

            // child folders
            builder.AddContent(seq++, RenderFolderTree(f.Id, depth + 1));

            builder.CloseElement(); // details
            builder.CloseElement(); // div
        }
    };

    private async Task ToggleFolder(long folderId)
    {
        if (expandedFolderIds.Contains(folderId))
        {
            expandedFolderIds.Remove(folderId);
        }
        else
        {
            expandedFolderIds.Add(folderId);
            await RefreshPlaylistsForFolderAsync(folderId);
        }
        StateHasChanged();
    }

    private async Task RefreshPlaylistsForFolderAsync(long folderId)
    {
        try
        {
            var res = await Http.GetFromJsonAsync<PlaylistsResponse>("api/library/playlists?page=1&pageSize=500");
            var list = (res?.items ?? new List<PlaylistDto>())
                .Where(p => p.FolderId == folderId)
                .Select(p => new PlaylistNavItem { Id = p.Id, Name = p.Name, FolderId = p.FolderId, Images = p.Images ?? new List<SpotifyImage>() })
                .OrderBy(p => p.Name)
                .ToList();

            // usuń stare wpisy tego folderu i dodaj aktualne
            folderPlaylists = folderPlaylists.Where(p => p.FolderId != folderId).ToList();
            folderPlaylists.AddRange(list);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("folderSync.register", selfRef, nameof(OnFolderChanged));
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnFolderChanged(long? folderId)
    {
        if (folderId.HasValue)
        {
            if (expandedFolderIds.Contains(folderId.Value))
            {
                await RefreshPlaylistsForFolderAsync(folderId.Value);
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            // odśwież wszystkie otwarte foldery jeśli brak wskazania
            foreach (var fid in expandedFolderIds.ToList())
                await RefreshPlaylistsForFolderAsync(fid);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayPlaylist(string playlistId)
    {
        var res = await Http.GetAsync($"api/library/playlists/{Uri.EscapeDataString(playlistId)}/tracks?page=1&pageSize=500");
        if (!res.IsSuccessStatusCode) return;
        var payload = await res.Content.ReadFromJsonAsync<TracksResponse>();
        var uris = payload?.items?.Where(t => !string.IsNullOrWhiteSpace(t.Uri)).Select(t => t.Uri!).ToList() ?? new List<string>();
        if (uris.Count == 0) return;
        var body = new { uris };
        var playRes = await Http.PutAsJsonAsync("api/player/play", body);
        if (!playRes.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();
            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private string? GetPlaylistThumbUrl(string playlistId)
    {
        var pl = folderPlaylists.FirstOrDefault(x => x.Id == playlistId);
        if (pl != null && pl.Images != null && pl.Images.Count > 0)
        {
            var best = pl.Images.Where(i => !string.IsNullOrWhiteSpace(i.Url)).OrderBy(i => i.Width ?? int.MaxValue).ThenBy(i => i.Height ?? int.MaxValue).FirstOrDefault();
            return best?.Url ?? pl.Images.FirstOrDefault()?.Url;
        }
        return null;
    }

    private sealed class FolderItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public long? ParentId { get; set; } }
    private sealed class PlaylistsResponse { public int total { get; set; } public int page { get; set; } public int pageSize { get; set; } public List<PlaylistDto> items { get; set; } = new(); }
    private sealed class PlaylistDto { public string Id { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public long? FolderId { get; set; } public List<SpotifyImage>? Images { get; set; } }
    private sealed class PlaylistNavItem { public string Id { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public long? FolderId { get; set; } public List<SpotifyImage> Images { get; set; } = new(); }
    private sealed class SpotifyImage { public string Url { get; set; } = string.Empty; public int? Height { get; set; } public int? Width { get; set; } }
    private sealed class TracksResponse { public int total { get; set; } public int page { get; set; } public int pageSize { get; set; } public List<TrackItem> items { get; set; } = new(); }
    private sealed class TrackItem { public string Id { get; set; } = string.Empty; public string? Uri { get; set; } }
    private sealed class DevicesResponse { public List<DeviceItem> Devices { get; set; } = new(); }
    private sealed class DeviceItem { public string Id { get; set; } = string.Empty; public bool IsActive { get; set; } }
}
