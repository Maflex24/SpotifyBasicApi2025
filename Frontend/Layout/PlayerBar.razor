@using Microsoft.JSInterop
@using System.Net.Http.Json
@inject IJSRuntime JS
@inject HttpClient Http
@inject BlindModeService BlindMode
@inject NavigationManager Navigation
@implements IDisposable
@code {

    private PlaybackState? state;
    private System.Timers.Timer? timer;

    protected override async Task OnInitializedAsync()
    {
        BlindMode.Changed += HandleBlindModeChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        await BlindMode.InitializeAsync();
        await RefreshState();

        timer = new System.Timers.Timer(5000);
        timer.Elapsed += async (_, __) => await InvokeAsync(RefreshState);
        timer.AutoReset = true;
        timer.Enabled = true;
    }

    private bool IsBlindMode => BlindMode.IsEnabled && IsAlbumsRoute();

    private bool IsAlbumsRoute()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        return path.Equals("albums", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("albums/", StringComparison.OrdinalIgnoreCase);
    }

    private void HandleBlindModeChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        BlindMode.Changed -= HandleBlindModeChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
        timer?.Dispose();
    }

    private async Task RefreshState()
    {
        try
        {
            var res = await Http.GetAsync("api/player/state");
            if (!res.IsSuccessStatusCode)
                return;
            state = await res.Content.ReadFromJsonAsync<PlaybackState>();
            await RefreshLibraryFlags();
            StateHasChanged();
        }
        catch { }
    }

    private async Task TogglePlay()
    {
        if (state?.is_playing == true)
            await Http.PutAsync("api/player/pause", null);
        else
            await Http.PutAsync("api/player/play", null);
        await RefreshState();
    }

    private async Task Next() { await Http.PostAsync("api/player/next", null); await RefreshState(); }
    private async Task Prev() { await Http.PostAsync("api/player/previous", null); await RefreshState(); }

    private bool isCurrentInLibrary = false;
    private bool showTagging = false;
    private List<TagItem> userTrackTags = new();
    private List<TagBadge> currentTrackAssigns = new();
    private string? lastAssignsTrackId;

    private string? GetCurrentTrackId()
    {
        return state?.item?.id;
    }

    private async Task RefreshLibraryFlags()
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId))
        {
            isCurrentInLibrary = false;
            currentTrackAssigns = new();
            lastAssignsTrackId = null;
            return;
        }

        var exists = await Http.GetFromJsonAsync<ExistsResponse>($"api/library/tracks/{trackId}/exists");

        if (exists != null)
            isCurrentInLibrary = exists.exists;

        if (isCurrentInLibrary)
        {
            var curId = trackId;

            if (lastAssignsTrackId != curId)
            {
                await LoadTagsForTrack();
                lastAssignsTrackId = curId;
            }
        }
        else
        {
            currentTrackAssigns = new();
            lastAssignsTrackId = null;
        }
    }

    private async Task ToggleLibrary()
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId))
            return;

        if (!isCurrentInLibrary)
        {
            var res = await Http.PostAsync($"api/library/tracks/{trackId}", null);

            if (res.IsSuccessStatusCode)
                isCurrentInLibrary = true;
        }
        else
        {
            var res = await Http.DeleteAsync($"api/library/tracks/{trackId}");

            if (res.IsSuccessStatusCode)
            {
                isCurrentInLibrary = false;
                showTagging = false;
            }
        }
    }

    private async Task ToggleTagging()
    {
        if (!isCurrentInLibrary)
            return;

        showTagging = !showTagging;

        if (showTagging)
            await LoadTagsForTrack();
    }

    private async Task LoadTagsForTrack()
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId))
            return;

        var tags = await Http.GetFromJsonAsync<List<TagItem>>("api/tags");
        userTrackTags = tags?.Where(t => true).ToList() ?? new List<TagItem>();

        var assigns = await Http.GetFromJsonAsync<List<TagBadge>>($"api/tags/assign/track/{trackId}");
        currentTrackAssigns = assigns ?? new List<TagBadge>();
    }

    private async Task RefreshCurrentTrackAssigns(string trackId)
    {
        var assigns = await Http.GetFromJsonAsync<List<TagBadge>>($"api/tags/assign/track/{Uri.EscapeDataString(trackId)}");
        currentTrackAssigns = assigns ?? new List<TagBadge>();
    }

    private Task ApplyCurrentTrackTagState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "track", StringComparison.OrdinalIgnoreCase)
            || !string.Equals(state.SpotifyItemId, GetCurrentTrackId(), StringComparison.Ordinal))
            return Task.CompletedTask;

        currentTrackAssigns = state.Tags;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnTagSelected(long? tagId)
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId) || tagId is null)
            return;

        var body = new TagAssignModel { TagId = tagId.Value, SpotifyItemId = trackId, ItemType = "track", Strength = 3.0f };
        var res = await Http.PostAsJsonAsync("api/tags/assign", body);

        if (res.IsSuccessStatusCode)
        {
            await RefreshCurrentTrackAssigns(trackId);
            try { await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "tagSync.notify", "track", trackId); } catch { }
        }
    }

    private async Task AdjustAssignStrength(long tagId, float delta)
    {
        var current = currentTrackAssigns.FirstOrDefault(a => a.TagId == tagId)?.Strength ?? 0.0f;
        var next = Math.Clamp(current + delta, 0.0f, 6.0f);

        if (Math.Abs(next - current) < 0.001f)
            return;

        await SetAssignStrength(tagId, next);
    }

    private async Task SetAssignStrength(long tagId, float strength)
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId))
            return;

        var body = new TagAssignModel { TagId = tagId, SpotifyItemId = trackId, ItemType = "track", Strength = strength };
        var res = await Http.PutAsJsonAsync("api/tags/assign", body);

        if (res.IsSuccessStatusCode)
        {
            await RefreshCurrentTrackAssigns(trackId);
            try { await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "tagSync.notify", "track", trackId); } catch { }
        }
    }

    private async Task RemoveAssign(long tagId)
    {
        var trackId = GetCurrentTrackId();

        if (string.IsNullOrWhiteSpace(trackId))
            return;

        var model = new TagAssignModel { TagId = tagId, SpotifyItemId = trackId, ItemType = "track", Strength = 0 };
        var req = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "api/tags/assign")
        {
            Content = JsonContent.Create(model)
        });

        if (!req.IsSuccessStatusCode)
            return;

        await RefreshCurrentTrackAssigns(trackId);
        try { await Microsoft.JSInterop.JSRuntimeExtensions.InvokeVoidAsync(JS, "tagSync.notify", "track", trackId); } catch { }
    }

    private List<TagBadge> GetCurrentTrackTagBadges()
    {
        return currentTrackAssigns.Select(assign => new TagBadge
        {
            TagId = assign.TagId,
            TagName = assign.TagName,
            TagGroupName = assign.TagGroupName,
            Strength = assign.Strength
        }).ToList();
    }

    private string? GetItemImageUrl()
    {
        var images = state?.item?.album?.images;
        if (images == null || images.Length == 0) return null;
        return images.OrderByDescending(i => i.width ?? 0).First().url;
    }

    private string GetArtists()
    {
        var artists = state?.item?.artists;
        if (artists == null || artists.Length == 0) return string.Empty;
        return string.Join(", ", artists.Select(a => a.name));
    }

    private string GetBlindTrackLabel() => state?.item?.id ?? "Brak odtwarzanego utworu";

    private string GetBlindAlbumLabel() => state?.item?.album?.id ?? "Brak identyfikatora albumu";

    private string GetProgressPercent()
    {
        var duration = state?.item?.duration_ms ?? 0;
        var progress = state?.progress_ms ?? 0;
        if (duration <= 0) return "0%";
        var p = Math.Clamp((int)(progress * 100.0 / duration), 0, 100);
        return $"{p}%";
    }

    private string FormatTime(int ms)
    {
        if (ms <= 0) return "0:00";
        var ts = TimeSpan.FromMilliseconds(ms);
        return $"{(int)ts.TotalMinutes}:{ts.Seconds:00}";
    }
}

<div class="player-bar bg-dark text-light">
    <div class="container d-flex align-items-center justify-content-between py-2 gap-3">
        <div class="d-flex align-items-center gap-2 text-truncate" style="min-width: 0;">
            @if (IsBlindMode)
            {
                <div class="player-blind-artwork" aria-label="Anonimowa okładka">@GetBlindAlbumLabel()</div>
            }
            else if (!string.IsNullOrEmpty(GetItemImageUrl()))
            {
                <img src="@GetItemImageUrl()" alt="cover" style="width:40px;height:40px;object-fit:cover;border-radius:4px;" />
            }
            <div class="text-truncate" style="min-width:0;">
                @if (IsBlindMode)
                {
                    <div class="small text-light text-truncate">Utwór: @GetBlindTrackLabel()</div>
                    <div class="small text-secondary text-truncate">Album: @GetBlindAlbumLabel()</div>
                }
                else
                {
                    <div class="small text-light text-truncate">@state?.item?.name</div>
                    <div class="small text-secondary text-truncate">@GetArtists()</div>
                }
                @if (isCurrentInLibrary && currentTrackAssigns.Count > 0)
                {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var assign in currentTrackAssigns.Take(3))
                        {
                            <span class="badge bg-primary" style="font-size: 0.65rem;">@assign.TagName (@assign.Strength.ToString("0.0"))</span>
                        }
                        @if (currentTrackAssigns.Count > 3)
                        {
                            <span class="badge bg-outline-primary text-primary" style="font-size: 0.65rem;">+@(currentTrackAssigns.Count - 3)</span>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-light" title="Poprzedni" @onclick="Prev">⏮</button>
            <button class="btn btn-sm btn-outline-light" title="Odtwórz/Wstrzymaj" @onclick="TogglePlay">@(state?.is_playing == true ? "⏸" : "▶")</button>
            <button class="btn btn-sm btn-outline-light" title="Następny" @onclick="Next">⏭</button>
            <button class="btn btn-sm btn-outline-light" title="Biblioteka" @onclick="ToggleLibrary">@(isCurrentInLibrary ? "− Usuń z biblioteki" : "+ Dodaj do biblioteki")</button>
            @if (isCurrentInLibrary)
            {
                <button class="btn btn-sm btn-outline-light" title="Taguj utwór" @onclick="ToggleTagging">🏷 Taguj</button>
            }
        </div>
        <div class="flex-grow-1" style="max-width: 40%; min-width: 150px;">
            <div class="d-flex align-items-center gap-2">
                <small class="text-secondary">@FormatTime(state?.progress_ms ?? 0)</small>
                <div class="progress w-100" style="height:4px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @GetProgressPercent();"></div>
                </div>
                <small class="text-secondary">@FormatTime(state?.item?.duration_ms ?? 0)</small>
            </div>
            
        </div>
    </div>
</div>

@if (showTagging && isCurrentInLibrary)
{
    <TaggingPanel Title="Tagowanie utworu"
                  ItemType="track"
                  SpotifyItemId="@(GetCurrentTrackId() ?? string.Empty)"
                  Items="userTrackTags"
                  Tags="GetCurrentTrackTagBadges()"
                  Placeholder="Taguj utwór..."
                  OnChanged="ApplyCurrentTrackTagState"
                  OnClose="ToggleTagging" />
}

@code {
    private sealed class PlaybackState
    {
        public Device? device { get; set; }
        public bool is_playing { get; set; }
        public int progress_ms { get; set; }
        public Item? item { get; set; }
        public string? currently_playing_type { get; set; }
    }

    private sealed class Device
    {
        public string? id { get; set; }
        public string? name { get; set; }
        public bool? is_active { get; set; }
        public int? volume_percent { get; set; }
    }

    private sealed class Item
    {
        public string name { get; set; } = string.Empty;
        public int duration_ms { get; set; }
        public Artist[]? artists { get; set; }
        public Album? album { get; set; }
        public string? id { get; set; }
    }

    private sealed class Artist { public string name { get; set; } = string.Empty; }

    private sealed class Album { public string? id { get; set; } public Img[]? images { get; set; } }

    private sealed class Img
    {
        public string url { get; set; } = string.Empty;
        public int? width { get; set; }
        public int? height { get; set; }
    }

    private sealed class ExistsResponse { public bool exists { get; set; } }

    private sealed class AssignDto { public long TagId { get; set; } public float Strength { get; set; } }

    private sealed class TagAssignModel { public long TagId { get; set; } public string SpotifyItemId { get; set; } = string.Empty; public string ItemType { get; set; } = string.Empty; public float Strength { get; set; } }
}




