@implements IDisposable
@inject AiChatDrawerService Drawer
@inject HttpClient Http

@if (Drawer.IsOpen && Drawer.Context != null)
{
    <div class="ai-chat-backdrop" @onclick="Close"></div>
    <aside class="ai-chat-drawer" aria-label="Czat AI dla wybranego elementu">
        <header class="ai-chat-drawer-header">
            <div><span class="ai-chat-context-label">@Drawer.Context.Label</span><strong>@Drawer.Context.DisplayName</strong><small>Pozostało: @Drawer.RemainingRequestsToday zapytań</small></div>
            <button type="button" class="btn btn-sm btn-outline-light" title="Zamknij czat AI" @onclick="Close">×</button>
        </header>
        <section class="ai-chat-messages" aria-live="polite">
            @if (Drawer.Messages.Count == 0)
            {
                <p class="ai-chat-empty">Zapytaj o gatunki, podobnych artystów, albumy lub propozycje tagów.</p>
            }
            @foreach (var message in Drawer.Messages)
            {
                <div class="ai-chat-message ai-chat-message-@message.Role">
                    <div class="ai-chat-message-label">@(message.Role == "user" ? "Ty" : "AI")</div>
                    <div class="ai-chat-message-text">@message.Text</div>
                    @if (message.Response != null)
                    {
                        @if (message.Response.Items.Count > 0)
                        {
                            <ul class="ai-chat-results">@foreach (var item in message.Response.Items) { <li>@if (!string.IsNullOrWhiteSpace(item.Url)) { <a href="@item.Url" target="_blank" rel="noopener">@item.Name</a> } else { @item.Name } @if (!string.IsNullOrWhiteSpace(item.Subtitle)) { <span> — @item.Subtitle</span> } @if (!string.IsNullOrWhiteSpace(item.Metric)) { <small>@item.Metric@(item.Score.HasValue ? $": {item.Score}" : string.Empty)</small> }</li> }</ul>
                        }
                        @if (message.Response.TagProposals.Count > 0)
                        {
                            <div class="ai-chat-tags">@foreach (var tag in message.Response.TagProposals) { <div><strong>@tag.Name</strong><small>@tag.Reason</small>@if (tag.Assigned) { <span class="badge text-bg-success">Przypisano</span> } else if (tag.ExistingTagId.HasValue) { <button class="btn btn-sm btn-success" @onclick="() => AssignTag(message, tag)">Przypisz</button> }</div> }</div>
                        }
                        @if (message.Response.Sources.Count > 0)
                        {
                            <div class="ai-chat-sources">Źródła: @foreach (var source in message.Response.Sources) { <a href="@source.Url" target="_blank" rel="noopener">@source.Name</a> }</div>
                        }
                    }
                </div>
            }
        </section>
        <footer class="ai-chat-composer">
            <div class="ai-chat-presets">
                <button @onclick='@(() => UsePreset("Jakie gatunki reprezentuje ten element?"))'>Gatunki</button>
                <button @onclick='@(() => UsePreset("Poleć podobnych artystów"))'>Podobni</button>
                <button @onclick='@(() => UsePreset("Jakie są najpopularniejsze albumy tego artysty?"))'>Albumy</button>
                <button @onclick='@(() => UsePreset("Zaproponuj tagi dla tego element"))'>Tagi</button>
            </div>
            <textarea class="form-control" rows="3" placeholder="O co chcesz zapytać?" @bind="draft" @bind:event="oninput" @onkeydown="OnKeyDown" disabled="@sending"></textarea>
            <button class="btn btn-primary w-100 mt-2" disabled="@(sending || string.IsNullOrWhiteSpace(draft))" @onclick="Send">@(sending ? "Sprawdzanie…" : "Zapytaj")</button>
        </footer>
    </aside>
}

@code {
    private string draft = string.Empty;
    private bool sending;

    protected override async Task OnInitializedAsync()
    {
        Drawer.Changed += OnDrawerChanged;
        await Drawer.InitializeAsync();
    }
    public void Dispose() => Drawer.Changed -= OnDrawerChanged;
    private void OnDrawerChanged() => _ = InvokeAsync(StateHasChanged);
    private Task Close() => Drawer.CloseAsync();
    private async Task UsePreset(string question) { draft = question; await Send(); }
    private async Task OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter" && !args.ShiftKey) { await Send(); } }

    private async Task Send()
    {
        if (Drawer.Context == null || string.IsNullOrWhiteSpace(draft) || sending) return;
        var question = draft.Trim();
        var history = Drawer.Messages.TakeLast(6).Select(message => new { role = message.Role, text = message.Text }).ToList();
        draft = string.Empty;
        sending = true;
        await Drawer.AddMessageAsync(new AiDrawerMessage { Role = "user", Text = question });
        try
        {
            var response = await Http.PostAsJsonAsync("api/ai/chat", new { message = question, itemType = Drawer.Context.ItemType, spotifyItemId = Drawer.Context.SpotifyItemId, conversation = history });
            var payload = await response.Content.ReadFromJsonAsync<AiDrawerResponse>();
            var text = payload?.Answer ?? payload?.Notice ?? (response.IsSuccessStatusCode ? "Brak odpowiedzi." : "Nie udało się uzyskać odpowiedzi AI.");
            await Drawer.AddMessageAsync(new AiDrawerMessage { Role = "assistant", Text = text, Response = payload });
        }
        catch
        {
            await Drawer.AddMessageAsync(new AiDrawerMessage { Role = "assistant", Text = "Nie udało się połączyć z asystentem." });
        }
        finally
        {
            sending = false;
            await Drawer.RefreshAccessAsync();
            await Drawer.PersistAsync();
        }
    }

    private async Task AssignTag(AiDrawerMessage message, AiDrawerTagProposal tag)
    {
        if (Drawer.Context == null || !tag.ExistingTagId.HasValue) return;
        var result = await Http.PostAsJsonAsync("api/tags/assign", new { tagId = tag.ExistingTagId.Value, spotifyItemId = Drawer.Context.SpotifyItemId, itemType = Drawer.Context.ItemType, strength = 3.0f });
        if (result.IsSuccessStatusCode) { tag.Assigned = true; await Drawer.PersistAsync(); }
    }
}
