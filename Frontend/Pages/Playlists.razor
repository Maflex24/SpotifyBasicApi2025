@page "/playlists"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 sticky-toolbar">
        <h4 class="mb-0">Playlisty</h4>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <input class="form-control form-control-sm input-dark" style="width: 220px;" type="text" placeholder="Szukaj (AND)" @bind="search" @bind:event="oninput" />
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortKey">
                <option value="name">Nazwa</option>
                <option value="tracks">Liczba utworów</option>
            </select>
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortOrder">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>
            <button class="btn btn-sm btn-outline-light" @onclick="LoadPlaylists">Zastosuj</button>
        </div>
    </div>

    <div class="mt-4">
        <div class="d-flex justify-content-between align-items-center mb-2" @onclick="ToggleFoldersSection" style="cursor:pointer;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(foldersExpanded ? "bi-chevron-down" : "bi-chevron-right")"></i>
                <h6 class="mb-0">Foldery (zwiń/rozwiń)</h6>
            </div>
            <button class="btn btn-sm btn-outline-light" @onclick:stopPropagation="true" @onclick="OpenCreateFolder">+ Nowy folder</button>
        </div>

        @if (foldersExpanded)
        {
            <div>
                @if (folders.Count == 0)
                {
                    <div class="text-secondary">Brak folderów</div>
                }
                else
                {
                    <ul>
                        @foreach (var f in folders)
                        {
                            <li>
                                @f.Name
                                <button class="btn btn-sm btn-outline-light ms-2" @onclick="() => OpenEditFolder(f)">Edytuj</button>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (showEditFolderPanel && editingFolder != null)
            {
                <div class="mt-3 p-2" style="background:#0f1117;border:1px solid #1f2937;border-radius:6px;max-width:520px;">
                    <div class="mb-2"><strong>Edycja folderu</strong></div>
                    <div class="mb-2 d-flex gap-2 align-items-center">
                        <label class="form-label mb-0" style="width:120px;">Nazwa</label>
                        <input class="form-control form-control-sm input-dark" style="max-width:360px;" @bind="editingName" />
                    </div>
                    <div class="mb-2 d-flex gap-2 align-items-center">
                        <label class="form-label mb-0" style="width:120px;">Rodzic</label>
                        <select class="form-select form-select-sm select-dark" style="max-width:360px;" @bind="editingParentId">
                            <option value="">— brak —</option>
                            @foreach (var opt in GetFolderOptions())
                            {
                                if (opt.Id == editingFolder.Id)
                                    continue;

                                <option value="@opt.Id">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-light" @onclick="SaveEditFolder">Zapisz</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditFolder">Anuluj</button>
                    </div>
                </div>
            }
        }
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3" id="playlists-container">
        @foreach (var p in playlists)
        {
            <div class="col">
                <div class="card bg-dark text-light h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">

                                @if (p.Images != null && p.Images.Count > 0)
                                {
                                    <img src="@GetBestImageUrl(p.Images)" alt="cover" style="width:60px;height:60px;object-fit:cover;border-radius:4px;" />
                                }
                                <h6 class="card-title mb-1">@p.Name</h6>
                            </div>
                            <span class="badge bg-secondary">@p.TotalTracks</span>
                        </div>
                        @if (p.FolderId.HasValue)
                        {
                            <div class="small text-secondary mb-2">Folder: @GetFolderName(p.FolderId.Value)</div>
                        }
                        <div class="mt-auto d-flex gap-2">
                            <a class="btn btn-sm btn-outline-light" href="/playlists/@p.Id">Otwórz</a>
                            <button class="btn btn-sm btn-outline-light" @onclick="() => OpenAssignFolder(p.Id)">Folder</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDelete(p.Id, p.Name)">Usuń</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="infinite-sentinel" @ref="sentinelRef" style="height: 1px;"></div>
</div>

@if (showAssignPanel && assigningPlaylistId != null)
{
    <div class="shadow" style="position:fixed; left:50%; transform:translateX(-50%); bottom:64px; z-index:2000; background-color:#0f1117; border:1px solid #1f2937; border-radius:8px; padding:10px; width:min(520px, 92vw)">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <strong>Przypisz playlistę do folderu</strong>
            <button class="btn btn-sm btn-outline-light" @onclick="CancelAssign">✕</button>
        </div>
        <div class="mb-2 d-flex gap-2 align-items-center">
            <label class="form-label mb-0" style="width:120px;">Folder</label>
            <select class="form-select form-select-sm select-dark" style="max-width:360px;" @bind="assigningFolderId">
                <option value="">— brak —</option>
                @foreach (var opt in GetFolderOptions())
                {
                    <option value="@opt.Id">@opt.Label</option>
                }
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-light" @onclick="SaveAssign">Zapisz</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAssign">Anuluj</button>
        </div>
    </div>
}

@code {
    private const string StoreKey = "playlists.filters.v1";
    private int currentPage = 1;
    private const int PageSize = 200;
    private bool isLoading = false;
    private bool hasMore = true;
    private DotNetObjectReference<Playlists>? dotNetRef;
    private ElementReference sentinelRef;
    private bool foldersExpanded = true;

    private string sortKeyField = "name";
    private string sortOrderField = "asc";
    private string? searchField;

    private string sortKey
    {
        get => sortKeyField;
        set
        {
            if (sortKeyField == value)
                return;

            sortKeyField = value;
            _ = SaveToStore();
        }
    }

    private string sortOrder
    {
        get => sortOrderField;
        set
        {
            if (sortOrderField == value)
                return;

            sortOrderField = value;
            _ = SaveToStore();
        }
    }

    private string? search
    {
        get => searchField;
        set
        {
            if (searchField == value)
                return;

            searchField = value;
            _ = SaveToStore();
        }
    }
    private long? selectedFolderId;
    private List<PlaylistItem> playlists = new();
    private List<FolderItem> folders = new();
    private bool showEditFolderPanel = false;
    private FolderItem? editingFolder;
    private string editingName = string.Empty;
    private long? editingParentId;
    private bool showAssignPanel = false;
    private string? assigningPlaylistId;
    private long? assigningFolderId;

    protected override async Task OnInitializedAsync()
    {
        // Odczytaj folderId z query string
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var fid = query["folderId"];
            if (!string.IsNullOrWhiteSpace(fid) && long.TryParse(fid, out var f))
                selectedFolderId = f;
        }
        catch { }
        await LoadFromStore();
        playlists.Clear();
        currentPage = 1;
        hasMore = true;
        await LoadPlaylists();
        await LoadFolders();
    }

    private async Task LoadPlaylists()
    {
        if (isLoading || !hasMore)
            return;

        isLoading = true;

        var query = new List<string>();
        query.Add($"sort={sortKey}");
        query.Add($"order={sortOrder}");

        if (!string.IsNullOrWhiteSpace(search))
            query.Add($"search={Uri.EscapeDataString(search)}");

        if (selectedFolderId.HasValue)
            query.Add($"folderId={selectedFolderId.Value}");
        query.Add($"page={currentPage}");
        query.Add($"pageSize={PageSize}");

        var res = await Http.GetAsync($"api/library/playlists?{string.Join('&', query)}");
        
        if (!res.IsSuccessStatusCode) return;
        var payload = await res.Content.ReadFromJsonAsync<PlaylistsResponse>();
        var items = payload?.items ?? new List<PlaylistItem>();

        if (items.Count < PageSize)
            hasMore = false;

        playlists.AddRange(items);
        currentPage++;

        isLoading = false;
    }

    private async Task LoadFolders()
    {
        var res = await Http.GetAsync("api/playlist-folders");
        if (!res.IsSuccessStatusCode) return;
        folders = await res.Content.ReadFromJsonAsync<List<FolderItem>>() ?? new List<FolderItem>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("infiniteScroll.observeWindow", sentinelRef, dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public async Task OnBottomReached()
    {
        await LoadPlaylists();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("infiniteScroll.disconnect"); } catch { }
        dotNetRef?.Dispose();
    }

    private string GetFolderName(long id)
    {
        var f = folders.FirstOrDefault(x => x.Id == id);
        return f?.Name ?? (id.ToString());
    }

    private async Task OpenCreateFolder()
    {
        var name = await JS.InvokeAsync<string>("prompt", "Nazwa folderu:");
        await CreateFolder(name, null);
    }

    private void OpenEditFolder(FolderItem f)
    {
        editingFolder = f;
        editingName = f.Name;
        editingParentId = f.ParentId;
        showEditFolderPanel = true;
    }

    private async Task CreateFolder(string? name, long? parentId)
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        var res = await Http.PostAsJsonAsync("api/playlist-folders", new { Name = name, ParentId = parentId });
        if (res.IsSuccessStatusCode) await LoadFolders();
    }

    private async Task UpdateFolder(long id, string? name, long? parentId)
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        var res = await Http.PutAsJsonAsync($"api/playlist-folders/{id}", new { Name = name, ParentId = parentId });
        if (res.IsSuccessStatusCode) await LoadFolders();
    }

    private void OpenAssignFolder(string playlistId)
    {
        assigningPlaylistId = playlistId;
        assigningFolderId = null;
        showAssignPanel = true;
    }

    private async Task SaveEditFolder()
    {
        if (editingFolder == null)
            return;

        await UpdateFolder(editingFolder.Id, editingName, editingParentId);
        showEditFolderPanel = false;
        editingFolder = null;
    }

    private void CancelEditFolder()
    {
        showEditFolderPanel = false;
        editingFolder = null;
    }

    private List<FolderOption> GetFolderOptions()
    {
        var result = new List<FolderOption>();

        var roots = folders.Where(f => !f.ParentId.HasValue).OrderBy(f => f.Name).ToList();
        var byParent = folders
            .Where(f => f.ParentId.HasValue)
            .GroupBy(f => f.ParentId!.Value)
            .ToDictionary(g => g.Key, g => g.OrderBy(x => x.Name).ToList());

        void WalkList(List<FolderItem> list, int depth)
        {
            foreach (var f in list)
            {
                var label = new string(' ', depth * 4) + f.Name;
                result.Add(new FolderOption { Id = f.Id, Label = label });

                if (byParent.TryGetValue(f.Id, out var children) && children.Count > 0)
                    WalkList(children, depth + 1);
            }
        }

        WalkList(roots, 0);

        return result;
    }

    private async Task LoadFromStore()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", StoreKey);

            if (string.IsNullOrWhiteSpace(json))
                return;

            var state = JsonSerializer.Deserialize<FiltersState>(json);

            if (state == null)
                return;

            sortKeyField = string.IsNullOrWhiteSpace(state.SortKey) ? sortKeyField : state.SortKey!;
            sortOrderField = string.IsNullOrWhiteSpace(state.SortOrder) ? sortOrderField : state.SortOrder!;
            searchField = state.Search;

            if (state.SelectedFolderId.HasValue)
                selectedFolderId = state.SelectedFolderId;
        }
        catch
        {
        }
    }

    private async Task SaveToStore()
    {
        try
        {
            var state = new FiltersState
            {
                SortKey = sortKey,
                SortOrder = sortOrder,
                Search = search,
                SelectedFolderId = selectedFolderId
            };

            var json = JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("localStorage.setItem", StoreKey, json);
        }
        catch
        {
        }
    }

    private async Task SaveAssign()
    {
        if (string.IsNullOrWhiteSpace(assigningPlaylistId))
            return;

        var res = await Http.PutAsJsonAsync($"api/library/playlists/{assigningPlaylistId}/folder-assign", new { FolderId = assigningFolderId });
        if (res.IsSuccessStatusCode)
        {
            playlists.Clear();
            currentPage = 1;
            hasMore = true;

            await LoadPlaylists();
        }

        showAssignPanel = false;
        assigningPlaylistId = null;
    }

    private async Task ConfirmDelete(string playlistId, string name)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"Usunąć playlistę '{name}'? Zostanie również usunięta z Twojego konta Spotify (unfollow)." );
        if (!ok)
            return;

        var res = await Http.DeleteAsync($"api/playlists/{Uri.EscapeDataString(playlistId)}");
        if (res.IsSuccessStatusCode)
        {
            playlists.Clear();
            currentPage = 1;
            hasMore = true;

            await LoadPlaylists();
        }
    }

    private void CancelAssign()
    {
        showAssignPanel = false;
        assigningPlaylistId = null;
    }

    private void ToggleFoldersSection()
    {
        foldersExpanded = !foldersExpanded;
    }

    private string ApiBase => string.Empty; // HttpClient.BaseAddress ustawione w Program.cs z appsettings

    private sealed class PlaylistsResponse { public int total { get; set; } public List<PlaylistItem> items { get; set; } = new(); }
    private sealed class PlaylistItem { public string Id { get; set; } = string.Empty; public string Name { get; set; } = string.Empty; public int TotalTracks { get; set; } public List<SpotifyImage> Images { get; set; } = new(); public long? FolderId { get; set; } }
    private sealed class SpotifyImage { public string Url { get; set; } = string.Empty; public int? Height { get; set; } public int? Width { get; set; } }

    private string? GetBestImageUrl(List<SpotifyImage> images)
    {
        if (images == null || images.Count == 0)
            return null;

        var ordered = images
            .Where(i => !string.IsNullOrWhiteSpace(i.Url))
            .OrderBy(i => i.Width ?? int.MaxValue)
            .ThenBy(i => i.Height ?? int.MaxValue)
            .ToList();

        return ordered.FirstOrDefault()?.Url ?? images.FirstOrDefault()?.Url;
    }
    private sealed class FolderItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public long? ParentId { get; set; } }
    private sealed class FolderOption { public long Id { get; set; } public string Label { get; set; } = string.Empty; }
    private sealed class FiltersState { public string? SortKey { get; set; } public string? SortOrder { get; set; } public string? Search { get; set; } public long? SelectedFolderId { get; set; } }
}



