@page "/artist/{Id}"
@inject HttpClient Http
@inject IJSRuntime JS
@using System.Text.Json

<div class="container-fluid py-3">
    @if (artist == null)
    {
        <div>Wczytywanie…</div>
    }
    else
    {
        <div class="d-flex align-items-start gap-3 mb-3">
            <img src="@GetBestImageUrl(artist.images)" alt="okładka" style="width:160px;height:160px;object-fit:cover;border-radius:8px;" />
            <div class="flex-fill">
                <h3 class="mb-1">@artist.name</h3>
                <button class="btn btn-sm btn-outline-light ms-2" @onclick="AddAllAlbumsClicked">Dodaj wszystkie albumy</button>
                @if (artist.genres != null && artist.genres.Length > 0)
                {
                    <div class="d-flex flex-wrap gap-1 mt-1">
                        @foreach (var g in artist.genres)
                        {
                            <span class="badge bg-outline-light text-light" style="font-size:0.75rem;">@g</span>
                        }
                    </div>
                }
            </div>
        </div>

        <h5>Najpopularniejsze utwory</h5>
        <div class="table-responsive mb-4" style="max-height: 50vh; overflow-y: auto;">
            <table class="table table-dark table-striped align-middle">
                <thead>
                    <tr>
                        <th style="width:56px;"></th>
                        <th>Nazwa</th>
                        <th>Album</th>
                        <th style="width:80px;">Rok</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in topTracks)
                    {
                        <tr>
                            <td>
                                <div class="cover-container">
                                    <img class="cover-img-56" src="@GetBestImageUrl(t.album?.images)" alt="okładka" />
                                    <button class="cover-overlay" title="Odtwórz" @onclick="() => PlayTrack(t.uri)">▶</button>
                                </div>
                            </td>
                            <td>@t.name</td>
                            <td>@t.album?.name</td>
                            <td>@(t.album?.release_date?.Length >=4 ? t.album.release_date.Substring(0,4) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h5>Albumy</h5>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-3">
            @foreach (var a in albums)
            {
                <div class="col">
                    <div class="card bg-dark text-light h-100">
                        <div class="artist-image-square" style="position:relative;">
                            <img src="@GetBestImageUrl(a.images)" alt="@a.name">
                            <button class="artist-play-overlay" title="Odtwórz album" @onclick="() => PlayAlbumById(a.id)">▶</button>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title mb-2 text-truncate">@a.name</h6>
                            <div class="small text-secondary">@(a.release_date)</div>
                            <div class="small text-secondary">Typ: @(a.album_type ?? "—"), utworów: @(a.total_tracks)</div>
                            <div class="mt-2 mt-auto">
                                <a class="btn btn-sm btn-outline-light" href="/album/@a.id">Otwórz album</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ArtistDto? artist;
    private List<TrackDto> topTracks = new();
    private List<AlbumDto> albums = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        var aTask = Http.GetFromJsonAsync<ArtistDto>($"api/artists/{Uri.EscapeDataString(Id)}");
        var tTask = Http.GetFromJsonAsync<List<TrackDto>>($"api/artists/{Uri.EscapeDataString(Id)}/top-tracks");
        var alTask = Http.GetFromJsonAsync<List<AlbumDto>>($"api/artists/{Uri.EscapeDataString(Id)}/albums");

        await Task.WhenAll(aTask!, tTask!, alTask!);

        artist = aTask?.Result;
        topTracks = tTask?.Result ?? new List<TrackDto>();
        albums = alTask?.Result ?? new List<AlbumDto>();
    }

    private async Task PlayTrack(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri)) return;
        var body = new { uris = new[] { uri } };
        var res = await Http.PutAsJsonAsync("api/player/play", body);
        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();
            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task PlayAlbum(string? contextUri)
    {
        if (string.IsNullOrWhiteSpace(contextUri)) return;
        var body = new { context_uri = contextUri };
        var res = await Http.PutAsJsonAsync("api/player/play", body);
        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();
            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private Task PlayAlbumById(string albumId)
    {
        var uri = $"spotify:album:{albumId}";
        return PlayAlbum(uri);
    }

    private string? GetBestImageUrl(ImgDto[]? images)
    {
        if (images == null || images.Length == 0) return null;
        return images.OrderByDescending(i => i.width ?? 0).First().url;
    }

    private bool addingAlbums = false;

    private async Task AddAllAlbumsClicked()
    {
        if (addingAlbums) return;

        addingAlbums = true;

        var res = await Http.PostAsync($"api/spotify/artists/{Uri.EscapeDataString(Id)}/add-albums", null);

        if (res.IsSuccessStatusCode)
        {
            var result = await res.Content.ReadFromJsonAsync<JsonElement>();
            // prosta informacja użytkownikowi
            await JS.InvokeVoidAsync("alert", $"Dodano: {result.GetProperty("added").GetInt32()}, już w bibliotece: {result.GetProperty("alreadyInLibrary").GetInt32()}");
        }
        else
        {
            var txt = await res.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Błąd: {res.StatusCode} - {txt}");
        }

        addingAlbums = false;
    }

    private sealed class DevicesResponse { public List<DeviceItem> Devices { get; set; } = new(); }
    private sealed class DeviceItem { public string Id { get; set; } = string.Empty; public bool IsActive { get; set; } }

    private sealed class ArtistDto { public string id { get; set; } = string.Empty; public string name { get; set; } = string.Empty; public string[] genres { get; set; } = Array.Empty<string>(); public ImgDto[] images { get; set; } = Array.Empty<ImgDto>(); }
    private sealed class TrackDto { public string id { get; set; } = string.Empty; public string name { get; set; } = string.Empty; public string? uri { get; set; } public AAlbum? album { get; set; } }
    private sealed class AAlbum { public string? name { get; set; } public string? release_date { get; set; } public ImgDto[]? images { get; set; } }
    private sealed class AlbumDto { public string id { get; set; } = string.Empty; public string name { get; set; } = string.Empty; public string? release_date { get; set; } public ImgDto[] images { get; set; } = Array.Empty<ImgDto>(); public string? album_type { get; set; } public int total_tracks { get; set; } }
    private sealed class ImgDto { public string url { get; set; } = string.Empty; public int? width { get; set; } public int? height { get; set; } }
}


