    private string? currentPlayingTrackId;

    private async Task PlayTrack(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri))

            return;
        
        var body = new { uris = new[] { uri } };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();
            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }

        // Ustal bieżące ID utworu z URI (spotify:track:XYZ)
        var lastColon = uri.LastIndexOf(':');
        if (lastColon > -1 && lastColon < uri.Length - 1)
            currentPlayingTrackId = uri.Substring(lastColon + 1);
        else
            currentPlayingTrackId = null;
    }

    private async Task PlayFiltered()
    {
        // Dociągnij wszystkie strony, aby odtwarzanie objęło pełny wynik filtrowania
        while (hasMore && !isLoading)
            await LoadTracks(reset: false);

        ApplyLocalFilter();

        var uris = filteredTracks
            .Where(t => !string.IsNullOrWhiteSpace(t.Uri))
            .Select(t => t.Uri!)
            .ToList();

        if (uris.Count == 0)
            return;

        var body = new { uris };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task PlayTrackAndFollowing(string? trackId)
    {
        if (string.IsNullOrWhiteSpace(trackId))

            return;

        // Upewnij się, że mamy wszystkie strony wyników
        while (hasMore && !isLoading)
            await LoadTracks(reset: false);

        // Zbuduj listę URI od klikniętego utworu do końca widocznej listy (filteredTracks)
        var startIndex = filteredTracks.FindIndex(t => string.Equals(t.Id, trackId, StringComparison.OrdinalIgnoreCase));

        if (startIndex < 0)
            return;

        var uris = filteredTracks
            .Skip(startIndex)
            .Where(t => !string.IsNullOrWhiteSpace(t.Uri))
            .Select(t => t.Uri!)
            .ToList();

        if (uris.Count == 0)
            return;

        var body = new { uris };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }

        // ustaw bieżące ID na pierwszy z listy
        var firstUri = uris.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(firstUri))
        {
            var lastColon = firstUri.LastIndexOf(':');
            if (lastColon > -1 && lastColon < firstUri.Length - 1)
                currentPlayingTrackId = firstUri.Substring(lastColon + 1);
            else
                currentPlayingTrackId = null;
        }
    }

    private CancellationTokenSource? pollCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        pollCts = new CancellationTokenSource();
        _ = Task.Run(async () =>
        {
            var token = pollCts.Token;
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await FetchPlaybackState();
                }
                catch { }

                try
                {
                    await Task.Delay(3000, token);
                }
                catch (TaskCanceledException) { break; }
            }
        });

        try
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("infiniteScroll.observe", containerRef, sentinelRef, dotNetRef);
            await JS.InvokeVoidAsync("tagSync.register", dotNetRef, nameof(OnTagsEvent));
            await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, dotNetRef);
        }
        catch { }
    }

    public void Dispose()
    {
        try { pollCts?.Cancel(); } catch { }
        pollCts?.Dispose();
        try { _ = JS.InvokeVoidAsync("infiniteScroll.disconnect"); } catch { }
        try { _ = JS.InvokeVoidAsync("libraryControls.disconnect"); } catch { }
        try { if (dotNetRef != null) { _ = JS.InvokeVoidAsync("tagSync.unregister", dotNetRef); } } catch { }
        try { dotNetRef?.Dispose(); } catch { }
    }

