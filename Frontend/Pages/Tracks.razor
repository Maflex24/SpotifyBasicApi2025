    private async Task RefreshTrackTags(string trackId)
    {
        var response = await Http.GetAsync($"api/tags/assign/track/{Uri.EscapeDataString(trackId)}");
        if (!response.IsSuccessStatusCode)
            return;

        var tags = await response.Content.ReadFromJsonAsync<List<TagBadge>>() ?? new List<TagBadge>();
        await ApplyTaggedTrackState(new TagAssignmentState { ItemType = "track", SpotifyItemId = trackId, Tags = tags });
    }

    private async Task ApplyTaggedTrackState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "track", StringComparison.OrdinalIgnoreCase))
            return;

        var track = tracks.FirstOrDefault(item => item.Id == state.SpotifyItemId);
        if (track == null)
            return;

        var previousTagIds = track.Tags.Select(tag => tag.TagId).ToHashSet();
        track.Tags = state.Tags.Select(tag => new TrackTag
        {
            TagId = tag.TagId,
            TagName = tag.TagName,
            TagGroupName = tag.TagGroupName,
            Strength = tag.Strength
        }).ToList();

        if (!MatchesTrackTagFilters(track))
            tracks.Remove(track);

        SortTracksByTagStrength();
        ApplyLocalFilter();

        if (!previousTagIds.SetEquals(track.Tags.Select(tag => tag.TagId)))
            await LoadTrackTagCounts();

        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyTaggedTrackStateFromPanel(TagAssignmentState state)
    {
        lastPanelTagUpdateId = state.SpotifyItemId;
        await ApplyTaggedTrackState(state);
    }

    private bool MatchesTrackTagFilters(Track track)
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        var tagIds = track.Tags.Select(tag => tag.TagId).ToHashSet();
        if (long.TryParse(filters.SelectedTagFilter, out var selectedTagId) && !tagIds.Contains(selectedTagId))
            return false;

        if (filters.IncludeTagIds.Length > 0)
        {
            var matchesInclude = string.Equals(filters.IncludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.IncludeTagIds.All(tagIds.Contains)
                : filters.IncludeTagIds.Any(tagIds.Contains);
            if (!matchesInclude)
                return false;
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            var matchesExcluded = string.Equals(filters.ExcludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.ExcludeTagIds.All(tagIds.Contains)
                : filters.ExcludeTagIds.Any(tagIds.Contains);
            if (matchesExcluded)
                return false;
        }

        return true;
    }

    private void SortTracksByTagStrength()
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        if (!string.Equals(filters.SortKey, "weight", StringComparison.OrdinalIgnoreCase) || !long.TryParse(filters.SelectedTagSort, out var tagId))
            return;

        tracks = (string.Equals(filters.SortOrder, "asc", StringComparison.OrdinalIgnoreCase)
                ? tracks.OrderBy(track => track.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0)
                : tracks.OrderByDescending(track => track.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0))
            .ThenBy(track => track.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

