@page "/tracks"
@using Frontend.Components
@inject LocalStorageService Store
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable
@using Microsoft.JSInterop
@using System.Text.Json

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row"><button type="button" class="library-controls-toggle" title="Pokaż filtry utworów" aria-label="Pokaż filtry utworów" aria-expanded="false" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▼</span></button></div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row"><button type="button" class="library-controls-toggle" title="Zwiń filtry utworów" aria-label="Zwiń filtry utworów" aria-expanded="true" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▲</span></button></div>
        }

    <section class="library-toolbar" aria-label="Filtry i akcje utworów">
        <div class="library-toolbar-heading"><h4 class="mb-0">Utwory <span class="library-results-count">@GetResultCountText(total, "utwór", "utwory", "utworów")</span></h4></div>
        <div class="library-search-group"><input class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj (AND)" @bind="LocalSearch" @bind:event="oninput" /></div>
        <div class="library-filter-fields">
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortKey">
                <option value="name">Nazwa</option>
                <option value="album">Album</option>
                <option value="artists">Wykonawcy</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
                <option value="year">Rok</option>
            </select>
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortOrder">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>

            <select class="form-select form-select-sm w-auto select-dark" @bind="selectedArtistId">
                <option value="">Wszyscy wykonawcy</option>
                @foreach (var ar in availableArtists)
                {
                    <option value="@ar.Id">@ar.Name</option>
                }
            </select>

            <select class="form-select form-select-sm select-dark" style="width: 160px;" @bind="selectedAlbumId">
                <option value="">Wszystkie albumy</option>
                @foreach (var al in availableAlbums)
                {
                    <option value="@al.Id">@al.Name</option>
                }
            </select>
            <input type="number" class="form-control form-control-sm input-dark" style="width: 110px;" placeholder="Rok" aria-label="Rok wydania" @bind="selectedYear" />


        </div>
        <div class="library-toolbar-actions">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść wszystkie filtry" @onclick="ResetFilters"><AppIcon Name="reset" /><span class="album-action-label">Resetuj</span></button>
            <button class="btn btn-sm album-action-button album-action-apply" title="Zastosuj filtry" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span></button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters"><AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span></button>
        </div>
        <div class="library-playback-actions"><button class="btn btn-sm album-action-button album-action-play-all" title="Odtwórz bieżące wyniki" @onclick="PlayFiltered"><AppIcon Name="play" /><span class="album-action-label">Odtwórz</span></button></div>
    </section>

    <section class="saved-filters-panel" aria-labelledby="tracks-saved-filters-heading">
            <h5 id="tracks-saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
            <div class="saved-filters-fields">
            <select class="form-select form-select-sm w-auto select-dark" @bind="selectedSavedFilterId">
                <option value="">Wybierz filtr...</option>
                @foreach (var f in savedFilters)
                {
                    <option value="@f.Id.ToString()">@f.Name</option>
                }
            </select>
            <input class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
            </div>
            <div class="saved-filters-actions">
            <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy" @onclick="SaveCurrentFilter"><AppIcon Name="save" /><span class="album-action-label">Zapisz</span></button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Zastosuj wybrany" @onclick="ApplySelectedFilter"><AppIcon Name="load" /><span class="album-action-label">Wczytaj</span></button>
            <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę / nadpisz" @onclick="RenameSelectedFilter"><AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span></button>
            <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany" @onclick="DeleteSelectedFilter"><AppIcon Name="delete" /><span class="album-action-label">Usuń</span></button>
            </div>
    </section>

        @if (showTagFilters)
        {
            <section class="library-tag-filters" aria-label="Filtry tagów">
                <div class="input-group input-group-sm tag-filter-search">
                    <input class="form-control input-dark" type="search" placeholder="Szukaj tagu" aria-label="Szukaj w filtrach tagów" @bind="tagSearch" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(tagSearch))
                    {
                        <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie tagów" aria-label="Wyczyść wyszukiwanie tagów" @onclick="ClearTagSearch">×</button>
                    }
                </div>
                <div class="d-flex flex-column gap-1 flex-fill">
                    @if (showTagsGrouped)
                    {
                        <div class="tag-groups-container mt-2">
                        @foreach (var group in GetGroupedTags())
                        {
                            <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                                <h6 class="tag-group-heading">@if (group.IsPinnedGroup) { <AppIcon Name="pin" Class="tag-pin-icon" /> }@group.Name</h6>
                                <div class="tag-chips-container">
                                @foreach (var t in group.Tags)
                                {
                                    var state = GetTagState(t.Id);
                                    var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                    var count = GetTagCount(t.Id);
                                    <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@group.IsPinnedGroup" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                                }
                                </div>
                            </section>
                        }
                        </div>
                    }
                    else
                    {
                    <div class="tag-chips-container mt-2">
                    @foreach (var t in GetVisibleTags())
                            {
                                var state = GetTagState(t.Id);
                                var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                var count = GetTagCount(t.Id);
                                <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@t.IsPinnedShortcut" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                            }
                        </div>
                    }
                    <div class="tag-filter-controls">
                        <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                        <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                        <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
                        <label class="tag-visibility-toggle"><input type="checkbox" @bind="showUnassignedTags" @bind:after="SaveTagVisibility" /> <span>Pokaż nieprzypisane tagi</span></label>
                    </div>
                    </div>
                </section>
            }
    }
    </div>

    @{
        var activeFilterChips = GetActiveFilterChips();
    }
    @if (activeFilterChips.Count > 0 || FiltersPending)
    {
        <section class="active-library-filters mb-3" aria-label="Aktywne filtry utworów">
            <span class="active-library-filters-label">@(FiltersPending ? "Oczekuje zastosowania:" : "Aktywne filtry:")</span>
            <div class="active-library-filter-chips">
                @foreach (var chip in activeFilterChips)
                {
                    <button type="button" class="@chip.CssClass" title="Usuń filtr: @chip.Label" @onclick="chip.ClearAsync"><span>@chip.Label</span><span class="active-library-filter-chip-remove" aria-hidden="true">×</span></button>
                }
            </div>
            @if (FiltersPending)
            {
                <button type="button" class="btn btn-sm album-action-button album-action-apply active-library-filters-apply" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span>Filtruj</span></button>
            }
        </section>
    }

    @if (showTrackTagging && taggingTrackId != null)
    {
        <TaggingPanel Title="Tagowanie utworu"
                                 ItemType="track"
                                 SpotifyItemId="@taggingTrackId"
                                 Items="trackTagItems"
                                 Tags="@(tracks.FirstOrDefault(x => x.Id == taggingTrackId)?.Tags?.Select(t => new Frontend.Components.TagBadge{ TagId=t.TagId, TagName=t.TagName, TagGroupName=t.TagGroupName, Strength=t.Strength}).ToList() ?? new List<Frontend.Components.TagBadge>())"
                                 Placeholder="Taguj utwór..."
                                 OnChanged="ApplyTaggedTrackStateFromPanel"
                                 OnClose="CloseTrackTagging" />
    }

    @if (!isLoading && total == 0)
    {
        <section class="library-empty-results" role="status">
            <p>Żaden utwór nie spełnia zastosowanych filtrów.</p>
            <button type="button" class="btn btn-sm album-action-button album-action-muted" @onclick="ResetAndApplyFiltersAsync"><AppIcon Name="reset" /><span>Resetuj filtry</span></button>
        </section>
    }

    <div class="table-responsive" style="max-height: calc(100vh - 240px); overflow-y: auto; position: relative;" @ref="containerRef">
        <table class="table table-dark table-striped align-middle" style="table-layout: fixed;">
            <thead>
                <tr>
                    <th style="width:64px; position:sticky; top:0; background-color:#0b0b0f; z-index:1;"></th>
                    <th style="width:30%; position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer; white-space:normal;" @onclick='@(() => OnServerSortClick("name"))'>Nazwa @GetSortArrow("name")</th>
                    <th style="width:16%; position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer; white-space:normal;" @onclick='@(() => OnServerSortClick("artists"))'>Wykonawcy @GetSortArrow("artists")</th>
                    <th style="width:16%; position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer; white-space:normal;" @onclick='@(() => OnServerSortClick("album"))'>Album @GetSortArrow("album")</th>
                    <th style="width:6%; position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer;" @onclick='@(() => OnServerSortClick("year"))'>Rok @GetSortArrow("year")</th>
                    <th style="width:26%; position:sticky; top:0; background-color:#0b0b0f; z-index:1; white-space:normal; cursor:pointer;" @onclick='@(() => OnServerSortClick("tags"))'>Tagi @GetSortArrow("tags")</th>
                    <th style="width:90px; position:sticky; top:0; background-color:#0b0b0f; z-index:1;">Tagowanie</th>
                    <th style="width:56px; position:sticky; top:0; background-color:#0b0b0f; z-index:1;"></th>
                </tr>
            </thead>
                        <tbody>
                @foreach (var t in filteredTracks)
                {
                    var rowClass = (string.Equals(currentPlayingTrackId, t.Id, StringComparison.OrdinalIgnoreCase)) ? "playing-track" : string.Empty;
                    <tr class="@rowClass">
                        <td class="trackTd">
                            <div class="cover-container">
                                <img class="cover-img-56" src="@(t.AlbumImage64 ?? GetBestImageUrl(t.Images) ?? string.Empty)" alt="okładka" />
                                <button class="cover-overlay" title="Odtwórz" @onclick="() => PlayTrackAndFollowing(t.Id)">▶</button>
                            </div>
                        </td>
                        <td class="trackTd">@t.Name</td>
                        <td class="trackTd">
                            @foreach (var a in t.Artists)
                            {
                                <a class="badge bg-outline-light text-light me-1 text-decoration-none" style="font-size: 0.7rem;" href="/artist/@a.Id">@a.Name</a>
                            }
                        </td>
                        <td class="trackTd">
                            @if (!string.IsNullOrWhiteSpace(t.AlbumId))
                            {
                                <a href="/album/@t.AlbumId" class="link-light text-decoration-none">@t.AlbumName</a>
                            }
                            else
                            {
                                @t.AlbumName
                            }
                        </td>
                        <td class="trackTd">@(t.ReleaseYear?.ToString() ?? "—")</td>
                        <td class="trackTd">
                            @foreach (var tag in (t.Tags ?? new List<TrackTag>()).Take(3))
                            {
                                <span class="badge badge-tag me-1">@tag.TagName (@tag.Strength)</span>
                            }
                            @if ((t.Tags?.Count ?? 0) > 3)
                            {
                                <span class="badge badge-tag bg-outline-primary text-primary">+@((t.Tags?.Count ?? 0) - 3)</span>
                            }
                        </td>
                        <td class="trackTd" style="overflow: visible; white-space: nowrap;">
                            <div class="d-flex align-items-center justify-content-center h-100 gap-2" style="min-height:56px;">
                                <button class="btn btn-sm btn-outline-light" style="display:inline-block;" @onclick="() => OpenTrackTagging(t.Id)">Taguj</button>
                            </div>
                        </td>
                        <td class="d-flex gap-2 trackTd">
                            <button class="btn btn-sm btn-outline-danger" title="Usuń z biblioteki" @onclick="() => ConfirmRemoveTrack(t.Id)">✖</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="height: 1px;" @ref="sentinelRef"></div>
    </div>
</div>

@code {
    private string _sortKey = "name";
    private string sortKey
    {
        get => _sortKey;
        set
        {
            if (_sortKey == value)
                return;

            _sortKey = value;
        }
    }

    private string _sortOrder = "asc";
    private string sortOrder
    {
        get => _sortOrder;
        set
        {
            if (_sortOrder == value)
                return;

            _sortOrder = value;
        }
    }
    private string? selectedTagFilter;
    private string? selectedTagSort;
    private string? selectedArtistId;
    private string? selectedAlbumId;
    private int? selectedYear;
    private List<Track> tracks = new();
    private List<Track> filteredTracks = new();
    private bool showTagFilters = true;
    private bool showTrackTagging = false;
    private string? taggingTrackId;
    private string? lastPanelTagUpdateId;
    private int page = 1;
    private int pageSize = 100;
    private int total = 0;
    private bool isLoading = false;
    private bool hasMore => tracks.Count < total;
    private ElementReference containerRef;
    private ElementReference sentinelRef;
    private ElementReference controlsSentinel;
    private DotNetObjectReference<Tracks>? dotNetRef;
    private bool controlsPastAnchor;
    private bool controlsManuallyCollapsed;
    private bool ControlsCollapsed => controlsPastAnchor && controlsManuallyCollapsed;
    private List<TagDto> availableTags = new();
    private List<TagGroupDto> tagGroups = new();
    private Dictionary<long, int> tagCounts = new();
    private List<ArtistOption> availableArtists = new();
    private List<AlbumOption> availableAlbums = new();
    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private Dictionary<long, TagStrengthFilterState> tagStrengthFilters = new();
    private string GetTagStrengthsQuery(IEnumerable<long> tagIds) => TagStrengthFilters.ToQuery(tagIds.Select(id => new TagStrengthFilterRule { TagId = id, Operator = tagStrengthFilters.GetValueOrDefault(id)?.Operator ?? "all", Value = tagStrengthFilters.GetValueOrDefault(id)?.Value ?? 3f }));
    private string includeMode = "or";
    private string excludeMode = "or";
    private bool showTagsGrouped;
    private const string TagLayoutStoreKey = "tag-layout:grouped";
    private const string TagVisibilityStoreKey = "tag-visibility:show-unassigned";
    private bool showUnassignedTags;
    private string? tagSearch;
    private TrackFilterSnapshot? appliedFilters;
    private bool FiltersPending => appliedFilters is null || !CaptureCurrentFilters().Matches(appliedFilters);

    private Dictionary<string, long?> selectedTagByTrack = new();
    private Dictionary<string, float?> hoverByKey = new();
    private string? localSearch;
    private string? LocalSearch
    {
        get => localSearch;
        set
        {
            if (localSearch == value)
                return;

            localSearch = value;
        }
    }

    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;

    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string? ContextId { get; set; } public string Scope { get; set; } = string.Empty; public string PayloadJson { get; set; } = string.Empty; }

    protected override async Task OnInitializedAsync()
    {
        await LoadTagLayout();
        await LoadTagVisibility();
        await LoadFromStore();
        await LoadAvailableTags();
        await LoadArtistsOptions();
        await LoadAlbumsOptions();
        await ApplyFiltersAsync();
        await LoadSavedFilters();
    }

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync("api/library/filters?scope=tracks");
        if (!res.IsSuccessStatusCode) return;
        var list = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
        savedFilters = list;
    }

    private TracksState BuildCurrentState()
    {
        return new TracksState
        {
            sortKey = sortKey,
            sortOrder = sortOrder,
            selectedTagFilter = selectedTagFilter,
            selectedTagSort = selectedTagSort,
            selectedArtistId = selectedArtistId,
            selectedAlbumId = selectedAlbumId,
            selectedYear = selectedYear,
            localSearch = localSearch,
            includeMode = includeMode,
            excludeMode = excludeMode,
            includeTagIds = includeTagIds.ToArray(),
            excludeTagIds = excludeTagIds.ToArray(),
            showTagFilters = showTagFilters
        };
    }

    private List<ActiveFilterChip> GetActiveFilterChips()
    {
        var chips = new List<ActiveFilterChip>();
        if (!string.IsNullOrWhiteSpace(localSearch)) chips.Add(new($"Szukaj: {localSearch}", "active-library-filter-chip", () => { localSearch = null; return Task.CompletedTask; }));
        if (!string.IsNullOrWhiteSpace(selectedArtistId)) chips.Add(new($"Wykonawca: {availableArtists.FirstOrDefault(a => a.Id == selectedArtistId)?.Name ?? selectedArtistId}", "active-library-filter-chip", () => { selectedArtistId = null; return Task.CompletedTask; }));
        if (!string.IsNullOrWhiteSpace(selectedAlbumId)) chips.Add(new($"Album: {availableAlbums.FirstOrDefault(a => a.Id == selectedAlbumId)?.Name ?? selectedAlbumId}", "active-library-filter-chip", () => { selectedAlbumId = null; return Task.CompletedTask; }));
        if (selectedYear.HasValue) chips.Add(new($"Rok: {selectedYear}", "active-library-filter-chip", () => { selectedYear = null; return Task.CompletedTask; }));
        if (sortKey != "name" || sortOrder != "asc") chips.Add(new($"Sortowanie: {sortKey} ({sortOrder})", "active-library-filter-chip", () => { sortKey = "name"; sortOrder = "asc"; return Task.CompletedTask; }));
        foreach (var id in includeTagIds) { var name = availableTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Włącz: {name} ({includeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-include", () => { includeTagIds.Remove(id); return Task.CompletedTask; })); }
        foreach (var id in excludeTagIds) { var name = availableTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Wyklucz: {name} ({excludeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-exclude", () => { excludeTagIds.Remove(id); return Task.CompletedTask; })); }
        return chips;
    }

    private sealed record ActiveFilterChip(string Label, string CssClass, Func<Task> ClearAsync);
    private sealed record TrackFilterSnapshot(string SortKey, string SortOrder, string? SelectedTagFilter, string? SelectedTagSort, string? SelectedArtistId, string? SelectedAlbumId, int? SelectedYear, string? LocalSearch, string IncludeMode, string ExcludeMode, long[] IncludeTagIds, long[] ExcludeTagIds)
    {
        public bool Matches(TrackFilterSnapshot? other) => other is not null && SortKey == other.SortKey && SortOrder == other.SortOrder && SelectedTagFilter == other.SelectedTagFilter && SelectedTagSort == other.SelectedTagSort && SelectedArtistId == other.SelectedArtistId && SelectedAlbumId == other.SelectedAlbumId && SelectedYear == other.SelectedYear && LocalSearch == other.LocalSearch && IncludeMode == other.IncludeMode && ExcludeMode == other.ExcludeMode && IncludeTagIds.SequenceEqual(other.IncludeTagIds) && ExcludeTagIds.SequenceEqual(other.ExcludeTagIds);
    }

    private async Task SaveCurrentFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "tracks", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PostAsJsonAsync("api/library/filters", body);
        if (res.IsSuccessStatusCode)
        {
            newFilterName = string.Empty;
            await LoadSavedFilters();
        }
    }

    private async Task ApplySelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var item = savedFilters.FirstOrDefault(x => x.Id == id);
        if (item == null || string.IsNullOrWhiteSpace(item.PayloadJson)) return;
        var state = JsonSerializer.Deserialize<TracksState>(item.PayloadJson);
        if (state == null) return;

        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        selectedArtistId = state.selectedArtistId;
        selectedAlbumId = state.selectedAlbumId;
        selectedYear = state.selectedYear;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        showTagFilters = state.showTagFilters ?? showTagFilters;

        await ApplyFiltersAsync();
    }

    private async Task RenameSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "tracks", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PutAsJsonAsync($"api/library/filters/{id}", body);
        if (res.IsSuccessStatusCode)
        {
            await LoadSavedFilters();
        }
    }

    private async Task DeleteSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var res = await Http.DeleteAsync($"api/library/filters/{id}");
        if (res.IsSuccessStatusCode)
        {
            selectedSavedFilterId = null;
            await LoadSavedFilters();
        }
    }

    private TrackFilterSnapshot CaptureCurrentFilters() => new(sortKey, sortOrder, selectedTagFilter, selectedTagSort, selectedArtistId, selectedAlbumId, selectedYear, localSearch, includeMode, excludeMode, includeTagIds.OrderBy(id => id).ToArray(), excludeTagIds.OrderBy(id => id).ToArray());

    private async Task ApplyFiltersAsync()
    {
        var filters = CaptureCurrentFilters();
        if (await LoadTracks(true, filters))
            appliedFilters = filters;
    }

    private async Task<bool> LoadTracks(bool reset = true, TrackFilterSnapshot? requestedFilters = null)
    {
        if (isLoading)
            return false;

        var filters = requestedFilters ?? appliedFilters ?? CaptureCurrentFilters();

        isLoading = true;
        try
        {
            if (reset)
            {
                page = 1;
                total = 0;
                tracks = new List<Track>();
                filteredTracks = new List<Track>();
            }
            else
            {
                page++;
            }

        var query = new List<string>();
        query.Add($"sort={filters.SortKey}");
        query.Add($"order={filters.SortOrder}");

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter)) query.Add($"tags={filters.SelectedTagFilter}");

        if (!string.IsNullOrEmpty(filters.SelectedTagSort)) query.Add($"sortTagId={filters.SelectedTagSort}");

        if (!string.IsNullOrEmpty(filters.SelectedArtistId)) query.Add($"artistId={Uri.EscapeDataString(filters.SelectedArtistId)}");

        if (!string.IsNullOrEmpty(filters.SelectedAlbumId)) query.Add($"albumId={Uri.EscapeDataString(filters.SelectedAlbumId)}");

        if (filters.SelectedYear.HasValue) query.Add($"year={filters.SelectedYear.Value}");

        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
            var strengths = GetTagStrengthsQuery(filters.IncludeTagIds);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"includeTagStrengths={Uri.EscapeDataString(strengths)}");
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
            var strengths = GetTagStrengthsQuery(filters.ExcludeTagIds);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"excludeTagStrengths={Uri.EscapeDataString(strengths)}");
        }

        if (!string.IsNullOrWhiteSpace(filters.LocalSearch)) query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");

        query.Add($"page={page}");
        query.Add($"pageSize={pageSize}");

        var res = await Http.GetAsync($"api/library/tracks?{string.Join('&', query)}");
        if (!res.IsSuccessStatusCode)
            return false;

        var payload = await res.Content.ReadFromJsonAsync<TracksResponse>();
        total = payload?.total ?? 0;
        var received = payload?.items ?? new List<Track>();

        if (reset)
            tracks = received.ToList();
        else
            tracks.AddRange(received);

        filteredTracks = tracks.ToList();

        foreach (var tr in tracks)
        {
            if (!selectedTagByTrack.ContainsKey(tr.Id))
                selectedTagByTrack[tr.Id] = null;
        }

        // sortowanie serwerowe według sort/order, dodatkowe sortowanie klienta na klik kolumny pozostaje
        await LoadTrackTagCounts(filters);

        await SaveToStore();
        await InvokeAsync(StateHasChanged);
        return true;
        }
        finally
        {
            isLoading = false;
        }
    }

