    private int GetTagState(long tagId)
    {
        if (includeTagIds.Contains(tagId)) return 1;
        if (excludeTagIds.Contains(tagId)) return 2;
        return 0;
    }

    private void CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);
        
        if (state == 0) { includeTagIds.Add(tagId); tagStrengthFilters.TryAdd(tagId, new TagStrengthFilterState()); return; }
        
        if (state == 1) { includeTagIds.Remove(tagId); excludeTagIds.Add(tagId); return; }
        
        excludeTagIds.Remove(tagId);
        tagStrengthFilters.Remove(tagId);
    }

    private TagStrengthFilterState? GetTagStrengthRule(long tagId) => GetTagState(tagId) == 0 ? null : tagStrengthFilters.GetValueOrDefault(tagId) ?? (tagStrengthFilters[tagId] = new TagStrengthFilterState());
    private void CycleTagStrengthOperator(long tagId) { var rule = GetTagStrengthRule(tagId); if (rule is not null) rule.Operator = rule.Operator == "gte" ? "lte" : rule.Operator == "lte" ? "all" : "gte"; }
    private void SetTagStrength(TagStrengthValueChanged change) { var rule = GetTagStrengthRule(change.TagId); if (rule is not null) rule.Value = change.Value; }

    private void ToggleIncludeMode() { includeMode = includeMode == "and" ? "or" : "and"; }
    private void ToggleExcludeMode() { excludeMode = excludeMode == "and" ? "or" : "and"; }
    private async Task ToggleTagFilters() { showTagFilters = !showTagFilters; await SaveToStore(); }

    private async Task LoadTagLayout()
    {
        showTagsGrouped = await Store.GetItemAsync<bool?>(TagLayoutStoreKey) ?? false;
    }

    private async Task ToggleTagLayout()
    {
        showTagsGrouped = !showTagsGrouped;
        await Store.SetItemAsync(TagLayoutStoreKey, showTagsGrouped);
    }

    private async Task LoadTagVisibility()
    {
        showUnassignedTags = await Store.GetItemAsync<bool?>(TagVisibilityStoreKey) ?? false;
    }

    private Task SaveTagVisibility() => Store.SetItemAsync(TagVisibilityStoreKey, showUnassignedTags);

    private IEnumerable<TagDto> GetNormalVisibleTags() => ExpandTagVariants(showUnassignedTags
        ? availableTags
        : availableTags.Where(tag => GetTagCount(tag.Id) > 0 || includeTagIds.Contains(tag.Id) || excludeTagIds.Contains(tag.Id)))
        .Where(tag => string.IsNullOrWhiteSpace(tagSearch) || tag.Name.Contains(tagSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TagDto> GetVisibleTags()
    {
        var tags = GetNormalVisibleTags().ToList();
        return tags.Where(tag => tag.IsPinned).Select(CreatePinnedShortcut).Concat(tags);
    }

    private static IEnumerable<TagDto> ExpandTagVariants(IEnumerable<TagDto> tags) => tags.SelectMany(tag => new[] { tag }.Concat(tag.Aliases
        .Where(alias => !string.Equals(alias, tag.Name, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Select(alias => new TagDto { Id = tag.Id, Name = alias, ForTrack = tag.ForTrack, IsPinned = tag.IsPinned, TagGroupId = tag.TagGroupId })));

    private static TagDto CreatePinnedShortcut(TagDto tag) => new() { Id = tag.Id, Name = tag.Name, ForTrack = tag.ForTrack, IsPinned = true, IsPinnedShortcut = true, TagGroupId = tag.TagGroupId };

    private void ClearTagSearch() => tagSearch = null;

    private IEnumerable<TagGroupView> GetGroupedTags()
    {
        var groupedTagIds = tagGroups.Select(group => group.Id).ToHashSet();
        var visibleTags = GetNormalVisibleTags().ToList();
        var pinnedTags = visibleTags.Where(tag => tag.IsPinned).Select(CreatePinnedShortcut).ToList();
        var groups = tagGroups.OrderBy(group => group.Name).Select(group => new TagGroupView { Name = group.Name, Tags = visibleTags.Where(tag => tag.TagGroupId == group.Id).OrderBy(tag => tag.Name).ToList() }).Where(group => group.Tags.Count > 0).ToList();
        if (pinnedTags.Count > 0)
            groups.Insert(0, new TagGroupView { Name = "Przypięte", Tags = pinnedTags, IsPinnedGroup = true });
        var ungroupedTags = visibleTags.Where(tag => !groupedTagIds.Contains(tag.TagGroupId)).OrderBy(tag => tag.Name).ToList();
        if (ungroupedTags.Count > 0)
            groups.Add(new TagGroupView { Name = "Pozostałe tagi", Tags = ungroupedTags });
        return groups;
    }

    

    private string? GetBestImageUrl(List<SpotifyImage> images)
    {
        if (images == null || images.Count == 0) return null;
        var ordered = images.Where(i => !string.IsNullOrWhiteSpace(i.Url)).OrderByDescending(i => i.Width ?? 0).ThenByDescending(i => i.Height ?? 0).ToList();
        return ordered.FirstOrDefault()?.Url ?? images.FirstOrDefault()?.Url;
    }

    private async Task SaveToStore()
    {
        var state = new
        {
            sortKey,
            sortOrder,
            selectedTagFilter,
            selectedTagSort,
            selectedArtistId,
            selectedAlbumId,
            selectedYear,
            localSearch,
            includeTagIds = includeTagIds.ToArray(),
            excludeTagIds = excludeTagIds.ToArray(),
            includeMode,
            excludeMode,
            showTagFilters
        };
        await Store.SetItemAsync("filters:tracks", state);
    }

    private async Task LoadFromStore()
    {
        var state = await Store.GetItemAsync<TracksState>("filters:tracks");
        if (state == null) return;
        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        selectedArtistId = state.selectedArtistId;
        selectedAlbumId = state.selectedAlbumId;
        selectedYear = state.selectedYear;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : includeTagIds;
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : excludeTagIds;

        showTagFilters = state.showTagFilters ?? showTagFilters;

        ApplyLocalFilter();
    }

