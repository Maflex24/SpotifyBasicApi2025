    private async Task RefreshRelatedArtistLibraryStatesAsync()
    {
        if (relatedArtists.Count == 0)
            return;

        var response = await Http.PostAsJsonAsync("api/library/items/status", new ItemStatusesRequest
        {
            ItemType = "artist",
            SpotifyItemIds = relatedArtists.Select(artist => artist.Id).ToList()
        });
        if (!response.IsSuccessStatusCode)
            return;

        var states = await response.Content.ReadFromJsonAsync<List<LibraryItemStatus>>() ?? new List<LibraryItemStatus>();
        var inLibrary = states.ToDictionary(state => state.SpotifyItemId, state => state.IsInLibrary, StringComparer.Ordinal);
        foreach (var artist in relatedArtists)
            artist.IsInLibrary = inLibrary.TryGetValue(artist.Id, out var value) && value;
