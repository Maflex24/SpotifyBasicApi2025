    private sealed record AlbumFilterSnapshot(
        string SortKey,
        string SortOrder,
        string? SelectedTagFilter,
        string? SelectedTagSort,
        string? LocalSearch,
        string IncludeMode,
        string ExcludeMode,
        long[] IncludeTagIds,
        long[] ExcludeTagIds,
        TagStrengthFilterRule[] IncludeTagStrengths,
        TagStrengthFilterRule[] ExcludeTagStrengths,
        string[] IncludeArtistIds,
        string[] ExcludeArtistIds,
        string[] IncludeGenres,
        string[] ExcludeGenres,
        bool IncludeArtistTags,
        int? FromYear,
        int? ToYear)
    {
        public bool Matches(AlbumFilterSnapshot? other) => other is not null
            && string.Equals(SortKey, other.SortKey, StringComparison.Ordinal)
            && string.Equals(SortOrder, other.SortOrder, StringComparison.Ordinal)
            && string.Equals(SelectedTagFilter, other.SelectedTagFilter, StringComparison.Ordinal)
            && string.Equals(SelectedTagSort, other.SelectedTagSort, StringComparison.Ordinal)
            && string.Equals(LocalSearch, other.LocalSearch, StringComparison.Ordinal)
            && string.Equals(IncludeMode, other.IncludeMode, StringComparison.Ordinal)
            && string.Equals(ExcludeMode, other.ExcludeMode, StringComparison.Ordinal)
            && IncludeTagIds.SequenceEqual(other.IncludeTagIds)
            && ExcludeTagIds.SequenceEqual(other.ExcludeTagIds)
            && TagStrengthFilters.Equal(IncludeTagStrengths, other.IncludeTagStrengths)
            && TagStrengthFilters.Equal(ExcludeTagStrengths, other.ExcludeTagStrengths)
            && IncludeArtistIds.SequenceEqual(other.IncludeArtistIds, StringComparer.Ordinal)
            && ExcludeArtistIds.SequenceEqual(other.ExcludeArtistIds, StringComparer.Ordinal)
            && IncludeGenres.SequenceEqual(other.IncludeGenres, StringComparer.OrdinalIgnoreCase)
            && ExcludeGenres.SequenceEqual(other.ExcludeGenres, StringComparer.OrdinalIgnoreCase)
            && IncludeArtistTags == other.IncludeArtistTags
            && FromYear == other.FromYear
            && ToYear == other.ToYear;
    }
