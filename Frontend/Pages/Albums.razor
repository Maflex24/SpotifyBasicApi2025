    }

    private async Task<bool> LoadAlbumsAsync(AlbumFilterSnapshot filters, bool reset = true)
    {
        if (isLoadingAlbums || (!reset && !HasMoreAlbums))
            return false;

        var requestedPage = reset ? 1 : currentPage + 1;
        isLoadingAlbums = true;
        await InvokeAsync(StateHasChanged);

        try
        {
        var query = BuildAlbumQuery(filters);

        query.Add($"page={requestedPage}");
        query.Add($"pageSize={AlbumPageSize}");

        var res = await Http.GetAsync($"api/library/albums?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return false;

        var payload = await res.Content.ReadFromJsonAsync<AlbumsResponse>();
        var received = payload?.items ?? new List<Album>();

        if (reset)
        {
            albums = received;
            artistCatalogAlbumsByArtistId.Clear();
            artistCatalogErrors.Clear();
        }
        else
        {
            var existingIds = albums.Select(album => album.Id).ToHashSet();
            albums.AddRange(received.Where(album => existingIds.Add(album.Id)));
        }

        currentPage = payload?.page > 0 ? payload.page : requestedPage;
        totalRows = payload?.TotalRows ?? payload?.total ?? albums.Count;

        foreach (var a in albums)
        {
            if (!selectedTagByAlbum.ContainsKey(a.Id))
                selectedTagByAlbum[a.Id] = null;
        }

        filteredAlbums = albums.ToList();
        if (reset)
        {
            await Task.WhenAll(LoadAlbumTagCounts(filters), LoadAlbumArtists(filters), LoadAlbumGenres(filters));
            await SaveToStore();
        }

        return true;
        }
        finally
        {
            isLoadingAlbums = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnBottomReached()
    {
        if (!isLoadingAlbums && HasMoreAlbums)
            await LoadAlbumsAsync(appliedFilters ?? CaptureCurrentFilters(), reset: false);
    }

    private static List<string> BuildAlbumQuery(AlbumFilterSnapshot filters)
    {
        var query = new List<string>
        {
            $"sort={filters.SortKey}",
            $"order={filters.SortOrder}"
        };

        AppendAlbumScopeQuery(query, filters, includeArtists: true, includeGenres: true);
        return query;
    }

    private static List<string> BuildAlbumArtistQuery(AlbumFilterSnapshot filters)
    {
        var query = new List<string>();
        AppendAlbumScopeQuery(query, filters, includeArtists: false, includeGenres: true);
        return query;
    }

    private static List<string> BuildAlbumGenreQuery(AlbumFilterSnapshot filters)
    {
        var query = new List<string>();
        AppendAlbumScopeQuery(query, filters, includeArtists: true, includeGenres: false);
        return query;
    }

    private static void AppendAlbumScopeQuery(List<string> query, AlbumFilterSnapshot filters, bool includeArtists, bool includeGenres)
    {

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter))
            query.Add($"tags={filters.SelectedTagFilter}");

        if (!string.IsNullOrEmpty(filters.SelectedTagSort))
            query.Add($"sortTagId={filters.SelectedTagSort}");

        if (includeArtists && filters.IncludeArtistIds.Length > 0)
            query.Add($"includeArtists={string.Join(',', filters.IncludeArtistIds.Select(Uri.EscapeDataString))}");

        if (includeArtists && filters.ExcludeArtistIds.Length > 0)
            query.Add($"excludeArtists={string.Join(',', filters.ExcludeArtistIds.Select(Uri.EscapeDataString))}");

        if (includeGenres && filters.IncludeGenres.Length > 0)
            query.Add($"includeGenres={string.Join(',', filters.IncludeGenres.Select(Uri.EscapeDataString))}");

        if (includeGenres && filters.ExcludeGenres.Length > 0)
            query.Add($"excludeGenres={string.Join(',', filters.ExcludeGenres.Select(Uri.EscapeDataString))}");

        if (filters.FromYear.HasValue)
            query.Add($"fromYear={filters.FromYear.Value}");

        if (filters.ToYear.HasValue)
            query.Add($"toYear={filters.ToYear.Value}");

        if (!string.IsNullOrWhiteSpace(filters.LocalSearch))
            query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");

        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
            var strengths = TagStrengthFilters.ToQuery(filters.IncludeTagStrengths);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"includeTagStrengths={Uri.EscapeDataString(strengths)}");
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
            var strengths = TagStrengthFilters.ToQuery(filters.ExcludeTagStrengths);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"excludeTagStrengths={Uri.EscapeDataString(strengths)}");
        }
        if (filters.IncludeArtistTags)
            query.Add("includeArtistTags=true");
    }

    private AlbumsState BuildCurrentState() => new AlbumsState
    {
        sortKey = sortKey,
        sortOrder = sortOrder,
        groupByArtist = groupByArtist,
        selectedTagFilter = selectedTagFilter,
        selectedTagSort = selectedTagSort,
        localSearch = localSearch,
        includeMode = includeMode,
        excludeMode = excludeMode,
        includeTagIds = includeTagIds.ToArray(),
        excludeTagIds = excludeTagIds.ToArray(),
        includeTagStrengths = CaptureTagStrengthRules(includeTagIds),
        excludeTagStrengths = CaptureTagStrengthRules(excludeTagIds),
        includeArtistIds = includeArtistIds.ToArray(),
        excludeArtistIds = excludeArtistIds.ToArray(),
        includeGenres = includeGenres.ToArray(),
        excludeGenres = excludeGenres.ToArray(),
        includeArtistTags = includeArtistTags,
        showArtistFilters = showArtistFilters,
        showGenreFilters = showGenreFilters,
        collapsedArtistGroupIds = collapsedArtistGroupIds.ToArray(),
        fromYear = fromYear,
        toYear = toYear,
    };

    private async Task SaveCurrentFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "albums", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PostAsJsonAsync("api/library/filters", body);
        if (res.IsSuccessStatusCode)
        {
            newFilterName = string.Empty;
            await LoadSavedFilters();
        }
    }

    private async Task ApplySelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var item = savedFilters.FirstOrDefault(x => x.Id == id);
        if (item == null || string.IsNullOrWhiteSpace(item.PayloadJson)) return;
        var state = JsonSerializer.Deserialize<AlbumsState>(item.PayloadJson);
        if (state == null) return;

        ClearRandomSelection();
        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        groupByArtist = state.groupByArtist ?? groupByArtist;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        tagStrengthFilters = TagStrengthFilters.Restore((state.includeTagStrengths ?? Array.Empty<TagStrengthFilterRule>()).Concat(state.excludeTagStrengths ?? Array.Empty<TagStrengthFilterRule>()), includeTagIds, excludeTagIds);
        includeArtistIds = state.includeArtistIds != null
            ? new HashSet<string>(state.includeArtistIds, StringComparer.Ordinal)
            : string.IsNullOrWhiteSpace(state.selectedArtistId) ? new HashSet<string>(StringComparer.Ordinal) : new HashSet<string>(new[] { state.selectedArtistId }, StringComparer.Ordinal);
        excludeArtistIds = state.excludeArtistIds != null ? new HashSet<string>(state.excludeArtistIds, StringComparer.Ordinal) : new HashSet<string>(StringComparer.Ordinal);
        includeGenres = state.includeGenres != null ? new HashSet<string>(state.includeGenres, StringComparer.OrdinalIgnoreCase) : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        excludeGenres = state.excludeGenres != null ? new HashSet<string>(state.excludeGenres, StringComparer.OrdinalIgnoreCase) : new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        includeArtistTags = state.includeArtistTags ?? false;
        RefreshAvailableTags();
        showArtistFilters = state.showArtistFilters ?? showArtistFilters;
        showGenreFilters = state.showGenreFilters ?? showGenreFilters;
        collapsedArtistGroupIds.Clear();
        if (state.collapsedArtistGroupIds != null)
            collapsedArtistGroupIds.UnionWith(state.collapsedArtistGroupIds);
        expandedArtistCatalogIds.Clear();
        fromYear = state.fromYear;
        toYear = state.toYear;

        await ApplyFiltersAsync();
    }

