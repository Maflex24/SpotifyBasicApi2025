    private IEnumerable<TagGroupView> GetGroupedTags()
    {
        var groupedTagIds = tagGroups.Select(group => group.Id).ToHashSet();
        var groups = tagGroups
            .OrderBy(group => group.Name)
            .Select(group => new TagGroupView
            {
                Name = group.Name,
                Tags = availableTags.Where(tag => tag.TagGroupId == group.Id).OrderBy(tag => tag.Name).ToList()
            })
            .Where(group => group.Tags.Count > 0)
            .ToList();
        var ungroupedTags = availableTags.Where(tag => !groupedTagIds.Contains(tag.TagGroupId)).OrderBy(tag => tag.Name).ToList();
        if (ungroupedTags.Count > 0)
            groups.Add(new TagGroupView { Name = "Pozostałe tagi", Tags = ungroupedTags });
        return groups;
    }

    private string? localSearch;
    private string? LocalSearch
    {
        get => localSearch;
        set
        {
            if (localSearch == value)
                return;

            localSearch = value;
            ApplyLocalFilter();
        }
    }

    private void ApplyLocalFilter()
    {
        if (string.IsNullOrWhiteSpace(localSearch))
        {
            filteredAlbums = albums.ToList();

            return;
        }

        var terms = localSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => t.ToLowerInvariant())
            .ToList();

        filteredAlbums = albums.Where(a =>
        {
            var parts = new List<string>();
            parts.Add(a.Name ?? string.Empty);
            parts.Add(string.Join(' ', a.Artists?.Select(s => s.Name) ?? new List<string>()));
            if (a.Tags != null && a.Tags.Count > 0)
                parts.Add(string.Join(' ', a.Tags.Select(t => t.TagName)));

            var hay = string.Join(' ', parts).ToLowerInvariant();

            foreach (var term in terms)
            {
                if (!hay.Contains(term))
                    return false;
            }

            return true;
        }).ToList();
    }

    private void PickRandomAlbum()
    {
        // Odtwórz pełną listę wyników przed losowaniem, aby kolejne kliknięcie
        // nie losowało z wcześniej wyświetlonego pojedynczego albumu.
        ApplyLocalFilter();

        if (filteredAlbums.Count == 0)
            return;

        filteredAlbums = new List<Album>
        {
            filteredAlbums[Random.Shared.Next(filteredAlbums.Count)]
        };
    }

    private sealed class TagCountDto { public long id { get; set; } public string name { get; set; } = string.Empty; public int count { get; set; } }

    private async Task LoadAlbumTagCounts()
    {
        var query = new List<string>();

        if (!string.IsNullOrEmpty(selectedTagFilter))
            query.Add($"tags={selectedTagFilter}");

        if (!string.IsNullOrEmpty(selectedArtistId))
            query.Add($"artistId={Uri.EscapeDataString(selectedArtistId)}");

        if (fromYear.HasValue)
            query.Add($"fromYear={fromYear.Value}");

        if (toYear.HasValue)
            query.Add($"toYear={toYear.Value}");

        if (includeTagIds.Count > 0)
        {
            query.Add($"includeTags={string.Join(',', includeTagIds)}");
            query.Add($"includeMode={includeMode}");
        }

        if (excludeTagIds.Count > 0)
        {
            query.Add($"excludeTags={string.Join(',', excludeTagIds)}");
            query.Add($"excludeMode={excludeMode}");
        }

        var res = await Http.GetAsync($"api/library/albums/tags/counts?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var list = await res.Content.ReadFromJsonAsync<List<TagCountDto>>() ?? new List<TagCountDto>();
        tagCounts = list.ToDictionary(x => x.id, x => x.count);
        await InvokeAsync(StateHasChanged);
    }

    private int GetTagCount(long tagId)
    {
        return tagCounts.TryGetValue(tagId, out var c) ? c : 0;
    }
