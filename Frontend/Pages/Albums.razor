@page "/albums"
@using Frontend.Components
@inject LocalStorageService Store
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Text.Json
@implements IAsyncDisposable

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row">
            <button type="button" class="library-controls-toggle" title="Pokaż filtry albumów" aria-label="Pokaż filtry albumów" aria-expanded="false" @onclick="ToggleControlsVisibility">
                <span aria-hidden="true">▼</span>
            </button>
        </div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row">
                <button type="button" class="library-controls-toggle" title="Zwiń filtry albumów" aria-label="Zwiń filtry albumów" aria-expanded="true" @onclick="ToggleControlsVisibility">
                    <span aria-hidden="true">▲</span>
                </button>
            </div>
        }

    <section class="albums-toolbar mb-3" aria-label="Filtry i akcje albumów">
        <div class="albums-toolbar-heading">
            <h4 class="mb-0 albums-results-heading"><span>Albumy</span><span class="library-results-count">@($"{filteredAlbums.Count}/{totalRows} albumów")</span></h4>
        </div>

        <div class="albums-search-group input-group input-group-sm">
            <label class="visually-hidden" for="albums-search">Szukaj albumu lub wykonawcy</label>
            @if (!string.IsNullOrWhiteSpace(LocalSearch))
            {
                <button type="button" class="btn btn-outline-light albums-search-clear" title="Wyczyść wyszukiwanie albumów" aria-label="Wyczyść wyszukiwanie albumów" @onclick="ClearSearchFilterAsync">×</button>
            }
            <input id="albums-search" class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj albumu/wyk. (AND)" @bind="LocalSearch" @bind:event="oninput" />
        </div>

        <div class="albums-filter-fields" aria-label="Ustawienia filtrowania">
            <select class="form-select form-select-sm select-dark" aria-label="Sortuj według" @bind="sortKey" @bind:after="MarkFiltersDirtyAsync">
                <option value="name">Nazwa</option>
                <option value="artist">Wykonawca</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
                <option value="year">Rok</option>
            </select>
            <select class="form-select form-select-sm select-dark" aria-label="Kierunek sortowania" @bind="sortOrder" @bind:after="MarkFiltersDirtyAsync">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>
            <select class="form-select form-select-sm select-dark albums-artist-select" aria-label="Wykonawca" @bind="selectedArtistId" @bind:after="MarkFiltersDirtyAsync">
                <option value="">Wszyscy wykonawcy</option>
                @foreach (var ar in availableAlbumArtists)
                {
                    <option value="@ar.Id">@ar.Name</option>
                }
            </select>
            <div class="albums-year-fields">
                <label class="visually-hidden" for="albums-year-from">Rok od</label>
                <input id="albums-year-from" type="number" class="form-control form-control-sm input-dark" placeholder="Rok od" @bind="fromYear" @bind:after="MarkFiltersDirtyAsync" />
                <label class="visually-hidden" for="albums-year-to">Rok do</label>
                <input id="albums-year-to" type="number" class="form-control form-control-sm input-dark" placeholder="Rok do" @bind="toYear" @bind:after="MarkFiltersDirtyAsync" />
            </div>
        </div>

        <div class="albums-toolbar-actions" aria-label="Akcje filtrowania">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść wszystkie filtry" aria-label="Resetuj filtry" @onclick="ResetFilters">
                <AppIcon Name="reset" /><span class="album-action-label">Resetuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-apply" title="Zastosuj wybrane filtry" aria-label="Zastosuj filtry" @onclick="ApplyFiltersAsync">
                <AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-label="Tagi: @(showTagFilters ? "ukryj filtry" : "pokaż filtry")" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters">
                <AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span>
            </button>
        </div>

        <div class="albums-playback-actions" aria-label="Szybkie akcje wyników">
            <button class="btn btn-sm album-action-button album-action-random" title="Wylosuj album z zastosowanych wyników" aria-label="Wylosuj album z zastosowanych wyników" disabled="@isLoadingAlbums" @onclick="PickRandomAlbumAsync">
                <AppIcon Name="shuffle" /><span class="album-action-label">@(isRandomSelection ? "Losuj ponownie" : "Losuj")</span>
            </button>
            @if (isRandomSelection)
            {
                <button class="btn btn-sm album-action-button album-action-muted" title="Wróć do wyników przed losowaniem" aria-label="Wróć do wyników przed losowaniem" disabled="@isLoadingAlbums" @onclick="ReturnToRandomSourceAsync">
                    <AppIcon Name="reset" /><span class="album-action-label">Wróć do wyników</span>
                </button>
            }
            <button class="btn btn-sm album-action-button album-action-play-all" title="Dodaj wszystkie wyświetlone albumy do kolejki" aria-label="Odtwórz wszystkie wyświetlone albumy" disabled="@(isQueueingAllAlbums || filteredAlbums.Count == 0)" @onclick="PlayAllAlbums">
                <AppIcon Name="play" /><span class="album-action-label">Odtwórz wszystko</span>
            </button>
        </div>
    </section>

    @if (showTagFilters)
    {
        <section class="albums-tag-filters mb-3" aria-label="Filtry tagów">
            <div class="input-group input-group-sm tag-filter-search">
                <input class="form-control input-dark" type="search" placeholder="Szukaj tagu" aria-label="Szukaj w filtrach tagów" @bind="tagSearch" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(tagSearch))
                {
                    <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie tagów" aria-label="Wyczyść wyszukiwanie tagów" @onclick="ClearTagSearch">×</button>
                }
            </div>
            @if (showTagsGrouped)
            {
                <div class="tag-groups-container">
                @foreach (var group in GetGroupedTags())
                {
                    <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                        <h6 class="tag-group-heading">@group.Name</h6>
                        <div class="tag-chips-container">
                        @foreach (var t in group.Tags)
                        {
                            var state = GetTagState(t.Id);
                            var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                            var count = GetTagCount(t.Id);
                            <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleTagState(t.Id)">
                                <span class="tag-chip-label">@t.Name</span>
                            @if (count > 0)
                            {
                                <span class="tag-count-info">@count</span>
                            }
                            </button>
                        }
                        </div>
                    </section>
                }
                </div>
            }
            else
            {
            <div class="tag-chips-container">
                @foreach (var t in GetVisibleTags())
                {
                    var state = GetTagState(t.Id);
                    var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                    var count = GetTagCount(t.Id);
                    <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleTagState(t.Id)">
                        <span class="tag-chip-label">@t.Name</span>
                    @if (count > 0)
                    {
                        <span class="tag-count-info">@count</span>
                    }
                    </button>
                }
            </div>
            }
            <div class="tag-filter-controls">
                <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
                <label class="tag-visibility-toggle"><input type="checkbox" @bind="showUnassignedTags" @bind:after="SaveTagVisibility" /> <span>Pokaż nieprzypisane tagi</span></label>
            </div>
        </section>
    }

    <section class="saved-filters-panel mb-3" aria-labelledby="saved-filters-heading">
        <h5 id="saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
        <div class="saved-filters-fields">
            <label class="visually-hidden" for="saved-filter-select">Wybierz zapisany filtr</label>
            <select id="saved-filter-select" class="form-select form-select-sm select-dark" @bind="selectedSavedFilterId">
                <option value="">Wybierz filtr...</option>
                @foreach (var f in savedFilters)
                {
                    <option value="@f.Id.ToString()">@f.Name</option>
                }
            </select>
            <label class="visually-hidden" for="saved-filter-name">Nazwa filtra</label>
            <input id="saved-filter-name" class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
        </div>
        <div class="saved-filters-actions" aria-label="Akcje zapisanych filtrów">
            <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy filtr" aria-label="Zapisz jako nowy filtr" @onclick="SaveCurrentFilter">
                <AppIcon Name="save" /><span class="album-action-label">Zapisz</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Wczytaj wybrany filtr" aria-label="Wczytaj wybrany filtr" @onclick="ApplySelectedFilter">
                <AppIcon Name="load" /><span class="album-action-label">Wczytaj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę lub nadpisz wybrany filtr" aria-label="Zmień nazwę lub nadpisz wybrany filtr" @onclick="RenameSelectedFilter">
                <AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany filtr" aria-label="Usuń wybrany filtr" @onclick="DeleteSelectedFilter">
                <AppIcon Name="delete" /><span class="album-action-label">Usuń</span>
            </button>
        </div>
    </section>
    }
    </div>

    @{
        var activeFilterChips = GetActiveFilterChips();
    }
    @if (activeFilterChips.Count > 0 || FiltersPending)
    {
        <section class="active-library-filters mb-3" aria-label="Aktywne filtry albumów">
            <span class="active-library-filters-label">@(FiltersPending ? "Oczekuje zastosowania:" : "Aktywne filtry:")</span>
            <div class="active-library-filter-chips">
                @foreach (var chip in activeFilterChips)
                {
                    <button type="button" class="@chip.CssClass" title="Usuń filtr: @chip.Label" aria-label="Usuń filtr: @chip.Label" @onclick="chip.ClearAsync">
                        <span>@chip.Label</span><span class="active-library-filter-chip-remove" aria-hidden="true">×</span>
                    </button>
                }
            </div>
            @if (FiltersPending)
            {
                <button type="button" class="btn btn-sm album-action-button album-action-apply active-library-filters-apply" @onclick="ApplyFiltersAsync">
                    <AppIcon Name="apply" /><span>Filtruj</span>
                </button>
            }
        </section>
    }

    @if (filteredAlbums.Count == 0)
    {
        <section class="library-empty-results" role="status">
            <p>Żaden album nie spełnia zastosowanych filtrów.</p>
            <button type="button" class="btn btn-sm album-action-button album-action-muted" @onclick="ResetAndApplyFiltersAsync"><AppIcon Name="reset" /><span>Resetuj filtry</span></button>
        </section>
    }

    <div class="library-card-grid">
        @foreach (var a in filteredAlbums)
        {
            <div class="library-card-grid-item">
                <div class="card bg-dark text-light h-100">
                    @if (a.Images?.Any() == true)
                    {
                        <div class="artist-image-square" style="position:relative;">
                            <img src="@GetBestImageUrl(a.Images)" alt="@a.Name">
                            <button class="artist-play-overlay album-card-play" title="Odtwórz album" aria-label="Odtwórz album: @a.Name"
                                    @onclick="() => PlayAlbum(a.Uri)"><AppIcon Name="play" /></button>
                            <button class="artist-queue-overlay album-card-queue" title="Dodaj album na koniec kolejki" aria-label="Dodaj album do kolejki: @a.Name"
                                    disabled="@queuingAlbumIds.Contains(a.Id)" @onclick="() => QueueAlbum(a.Id)"><AppIcon Name="queue" /></button>
                            <button class="album-card-delete" title="Usuń z biblioteki" aria-label="Usuń album z biblioteki: @a.Name"
                                    @onclick="() => ConfirmRemoveAlbum(a.Id)"><AppIcon Name="delete" /></button>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-1"><a href="/album/@a.Id" class="link-light text-decoration-none">@a.Name</a> @if (a.ReleaseYear.HasValue) { <text> (@a.ReleaseYear)</text> }</h6>
                            <span class="badge bg-secondary">@a.Popularity</span>
                        </div>

                        @if (a.Artists?.Any() == true)
                        {
                            <div class="mb-2">
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var art in a.Artists)
                                    {
                                        <a href="/artist/@art.Id" class="badge bg-outline-light text-light text-decoration-none" style="font-size: 0.8rem;">@art.Name</a>
                                    }
                                </div>
                            </div>
                        }

                        @if (a.Tags?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Tagi:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var tag in a.Tags.Take(3))
                                    {
                                        <span class="badge badge-tag">@tag.TagName (@tag.Strength)</span>
                                    }
                                    @if (a.Tags.Count > 3)
                                    {
                                        <span class="badge bg-outline-primary text-primary badge-tag">+@(a.Tags.Count - 3)</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mt-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button class="btn btn-sm album-card-tag" title="Zarządzaj tagami albumu" aria-label="Taguj album: @a.Name" @onclick="() => OpenAlbumTagging(a.Id)">
                                    <AppIcon Name="tag" /><span>Taguj</span>
                                </button>
                                <span class="badge bg-secondary" title="Liczba utworów" style="font-size:0.75rem;">@a.TotalTracks</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    @if (isLoadingAlbums && filteredAlbums.Count > 0)
    {
        <div class="album-infinite-scroll-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Wczytywanie kolejnych albumów...</span></div>
    }
    <div class="album-infinite-scroll-sentinel" @ref="albumsSentinel" aria-hidden="true"></div>
</div>

@code {
    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;
    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string Scope { get; set; } = string.Empty; public string? ContextId { get; set; } public string PayloadJson { get; set; } = string.Empty; }

    private string sortKey = "name";
    private string sortOrder = "asc";
    private string? selectedTagFilter;
    private string? selectedTagSort;
    private string? selectedArtistId;
    private List<Album> albums = new();
    private List<Album> filteredAlbums = new();
    private const int AlbumPageSize = 100;
    private int currentPage;
    private int totalRows;
    private bool isLoadingAlbums;
    private bool isRandomSelection;
    private string? randomSourceSearch;
    private bool HasMoreAlbums => albums.Count < totalRows;
    private readonly HashSet<string> queuingAlbumIds = new();
    private bool isQueueingAllAlbums;
    private AlbumFilterSnapshot? appliedFilters;
    private bool FiltersPending => appliedFilters is null || !CaptureCurrentFilters().Matches(appliedFilters);
    private List<TagDto> availableTags = new();
    private List<TagGroupDto> tagGroups = new();
    private List<AlbumArtistOption> availableAlbumArtists = new();
    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private string includeMode = "or";
    private string excludeMode = "or";
    private bool showTagFilters = true;
    private bool showTagsGrouped;
    private const string TagLayoutStoreKey = "tag-layout:grouped";
    private const string TagVisibilityStoreKey = "tag-visibility:show-unassigned";
    private bool showUnassignedTags;
    private string? tagSearch;
    private ElementReference controlsSentinel;
    private ElementReference albumsSentinel;
    private DotNetObjectReference<Albums>? controlsObserverRef;
    private bool controlsPastAnchor;
    private bool controlsManuallyCollapsed;
    private bool ControlsCollapsed => controlsPastAnchor && controlsManuallyCollapsed;

    private Dictionary<string, float?> hoverByKey = new();
    private Dictionary<string, long?> selectedTagByAlbum = new();
    private bool showAlbumTagging = false;
    private string? taggingAlbumId;
    private Dictionary<long, int> tagCounts = new();
    private int? fromYear = null;
    private int? toYear = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadTagLayout();
        await LoadTagVisibility();
        await LoadFromStore();
        await LoadAvailableTags();
        await LoadAlbumArtists();
        await ApplyFiltersAsync();
        await LoadSavedFilters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        controlsObserverRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, controlsObserverRef);
        await JS.InvokeVoidAsync("infiniteScroll.observeWindow", albumsSentinel, controlsObserverRef);
    }

    [JSInvokable]
    public Task SetControlsPastAnchor(bool isPastAnchor)
    {
        if (controlsPastAnchor == isPastAnchor)
            return Task.CompletedTask;

        controlsPastAnchor = isPastAnchor;

        if (!controlsPastAnchor)
            controlsManuallyCollapsed = false;

        return InvokeAsync(StateHasChanged);
    }

    private void ToggleControlsVisibility()
    {
        controlsManuallyCollapsed = !ControlsCollapsed;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("libraryControls.disconnect");
            await JS.InvokeVoidAsync("infiniteScroll.disconnect");
        }
        catch (JSDisconnectedException)
        {
            // The browser was already disconnected during component disposal.
        }

        controlsObserverRef?.Dispose();
    }

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync("api/library/filters?scope=albums");
        if (!res.IsSuccessStatusCode) return;
        savedFilters = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
    }

    private AlbumFilterSnapshot CaptureCurrentFilters() => new(
        sortKey,
        sortOrder,
        selectedTagFilter,
        selectedTagSort,
        selectedArtistId,
        localSearch,
        includeMode,
        excludeMode,
        includeTagIds.OrderBy(id => id).ToArray(),
        excludeTagIds.OrderBy(id => id).ToArray(),
        fromYear,
        toYear);

    private async Task ApplyFiltersAsync()
    {
        var filters = CaptureCurrentFilters();
        if (await LoadAlbumsAsync(filters))
            appliedFilters = filters;
    }

    private async Task ReloadAppliedAlbumsAsync()
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        if (await LoadAlbumsAsync(filters) && appliedFilters is null)
            appliedFilters = filters;
    }

    private async Task<bool> LoadAlbumsAsync(AlbumFilterSnapshot filters, bool reset = true)
    {
        if (isLoadingAlbums || (!reset && !HasMoreAlbums))
            return false;

        var requestedPage = reset ? 1 : currentPage + 1;
        isLoadingAlbums = true;
        await InvokeAsync(StateHasChanged);

        try
        {
        var query = BuildAlbumQuery(filters);

        query.Add($"page={requestedPage}");
        query.Add($"pageSize={AlbumPageSize}");

        var res = await Http.GetAsync($"api/library/albums?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return false;

        var payload = await res.Content.ReadFromJsonAsync<AlbumsResponse>();
        var received = payload?.items ?? new List<Album>();

        if (reset)
        {
            albums = received;
        }
        else
        {
            var existingIds = albums.Select(album => album.Id).ToHashSet();
            albums.AddRange(received.Where(album => existingIds.Add(album.Id)));
        }

        currentPage = payload?.page > 0 ? payload.page : requestedPage;
        totalRows = payload?.TotalRows ?? payload?.total ?? albums.Count;

        foreach (var a in albums)
        {
            if (!selectedTagByAlbum.ContainsKey(a.Id))
                selectedTagByAlbum[a.Id] = null;
        }

        filteredAlbums = albums.ToList();
        if (reset)
        {
            await LoadAlbumTagCounts(filters);
            await SaveToStore();
        }

        return true;
        }
        finally
        {
            isLoadingAlbums = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task OnBottomReached()
    {
        if (!isLoadingAlbums && HasMoreAlbums)
            await LoadAlbumsAsync(appliedFilters ?? CaptureCurrentFilters(), reset: false);
    }

    private static List<string> BuildAlbumQuery(AlbumFilterSnapshot filters)
    {
        var query = new List<string>
        {
            $"sort={filters.SortKey}",
            $"order={filters.SortOrder}"
        };

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter))
            query.Add($"tags={filters.SelectedTagFilter}");

        if (!string.IsNullOrEmpty(filters.SelectedTagSort))
            query.Add($"sortTagId={filters.SelectedTagSort}");

        if (!string.IsNullOrEmpty(filters.SelectedArtistId))
            query.Add($"artistId={Uri.EscapeDataString(filters.SelectedArtistId)}");

        if (filters.FromYear.HasValue)
            query.Add($"fromYear={filters.FromYear.Value}");

        if (filters.ToYear.HasValue)
            query.Add($"toYear={filters.ToYear.Value}");

        if (!string.IsNullOrWhiteSpace(filters.LocalSearch))
            query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");

        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
        }

        return query;
    }

    private AlbumsState BuildCurrentState() => new AlbumsState
    {
        sortKey = sortKey,
        sortOrder = sortOrder,
        selectedTagFilter = selectedTagFilter,
        selectedTagSort = selectedTagSort,
        selectedArtistId = selectedArtistId,
        localSearch = localSearch,
