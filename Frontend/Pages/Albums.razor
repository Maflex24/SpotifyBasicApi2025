    private async Task ResetFilters()
    {
        ClearRandomSelection();
        sortKey = "name";
        sortOrder = "asc";
        selectedTagFilter = null;
        selectedTagSort = null;
        includeArtistIds.Clear();
        excludeArtistIds.Clear();
        includeGenres.Clear();
        excludeGenres.Clear();
        includeArtistTags = false;
        collapsedArtistGroupIds.Clear();
        expandedArtistCatalogIds.Clear();
        artistCatalogAlbumsByArtistId.Clear();
        artistCatalogErrors.Clear();
        localSearch = null;
        includeTagIds.Clear();
        excludeTagIds.Clear();
        tagStrengthFilters.Clear();
        includeMode = "or";
        excludeMode = "or";
        fromYear = null;
