    private async Task AddRelatedArtistsAsync(IEnumerable<string> artistIds)
    {
        var ids = artistIds.Where(id => !string.IsNullOrWhiteSpace(id)).Distinct(StringComparer.Ordinal).Take(20).ToList();
        if (ids.Count == 0 || isAddingRelatedArtists)
            return;

        isAddingRelatedArtists = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/library/artists/discovery-add", new ArtistDiscoveryRequest { ArtistIds = ids });
            if (!response.IsSuccessStatusCode)
            {
                relatedArtistError = "Nie udało się dodać wybranych wykonawców do biblioteki.";
                return;
            }

            var results = await response.Content.ReadFromJsonAsync<List<ArtistDiscoveryResult>>() ?? new List<ArtistDiscoveryResult>();
            foreach (var result in results)
                relatedArtistResults[result.ArtistId] = result;

            var importedArtistIds = results.Where(result => result.AddedToLibrary).Select(result => result.ArtistId).ToList();
            if (importedArtistIds.Count == 0)
                return;

            foreach (var artistId in importedArtistIds)
            {
                includeArtistIds.Add(artistId);
                excludeArtistIds.Remove(artistId);
                selectedRelatedArtistIds.Remove(artistId);
                var artist = relatedArtists.FirstOrDefault(item => item.Id == artistId);
                if (artist != null)
                    artist.IsInLibrary = true;
            }

            await ApplyFiltersAsync();
        }
        finally
        {
            isAddingRelatedArtists = false;
        }
    }

    private async Task PlayRelatedArtistTopTracksAsync(string artistId)
    {
        if (string.IsNullOrWhiteSpace(artistId) || !playingRelatedArtistIds.Add(artistId))
            return;

        try
        {
            var top = await Http.GetFromJsonAsync<TopTracksResponse>($"api/spotify/artists/{Uri.EscapeDataString(artistId)}/top-tracks");
            var uris = top?.Items
                .Where(track => !string.IsNullOrWhiteSpace(track.Uri))
                .Select(track => track.Uri)
                .ToList() ?? new List<string>();

            if (uris.Count == 0)
                return;

            var body = new { uris };
            var response = await Http.PutAsJsonAsync("api/player/play", body);
            if (response.IsSuccessStatusCode)
                return;

            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var firstDevice = devices?.Devices.FirstOrDefault();
            if (firstDevice != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(firstDevice.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
        finally
        {
            playingRelatedArtistIds.Remove(artistId);
        }
    }

