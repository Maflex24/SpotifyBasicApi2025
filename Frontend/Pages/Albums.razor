    private List<ActiveFilterChip> GetActiveFilterChips()
    {
        var chips = new List<ActiveFilterChip>();

        if (!string.IsNullOrWhiteSpace(localSearch))
            chips.Add(new ActiveFilterChip(IsBlindMode ? "Wyszukiwanie tekstowe aktywne" : $"Szukaj: {localSearch}", "active-library-filter-chip", ClearSearchFilterAsync));

        foreach (var artistId in includeArtistIds.OrderBy(id => IsBlindMode ? id : GetArtistName(id), StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip($"+ {(IsBlindMode ? artistId : GetArtistName(artistId))}", "active-library-filter-chip active-library-filter-chip-include", () => ClearIncludedArtistAsync(artistId)));

        foreach (var artistId in excludeArtistIds.OrderBy(id => IsBlindMode ? id : GetArtistName(id), StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip($"− {(IsBlindMode ? artistId : GetArtistName(artistId))}", "active-library-filter-chip active-library-filter-chip-exclude", () => ClearExcludedArtistAsync(artistId)));

        foreach (var genre in includeGenres.OrderBy(genre => genre, StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip(IsBlindMode ? "+ Gatunek ukryty" : $"+ Gatunek: {genre}", "active-library-filter-chip active-library-filter-chip-include", () => ClearIncludedGenreAsync(genre)));

        foreach (var genre in excludeGenres.OrderBy(genre => genre, StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip(IsBlindMode ? "− Gatunek ukryty" : $"− Gatunek: {genre}", "active-library-filter-chip active-library-filter-chip-exclude", () => ClearExcludedGenreAsync(genre)));

        if (fromYear.HasValue)
            chips.Add(new ActiveFilterChip($"Rok od: {fromYear.Value}", "active-library-filter-chip", ClearFromYearFilterAsync));

        if (toYear.HasValue)
            chips.Add(new ActiveFilterChip($"Rok do: {toYear.Value}", "active-library-filter-chip", ClearToYearFilterAsync));

        if (long.TryParse(selectedTagFilter, out var selectedTagId))
            chips.Add(new ActiveFilterChip($"Tag: {GetTagName(selectedTagId)}", "active-library-filter-chip active-library-filter-chip-include", ClearSelectedTagFilterAsync));

        var includeModeLabel = includeMode.Equals("and", StringComparison.OrdinalIgnoreCase) ? "AND" : "OR";
        foreach (var tagId in includeTagIds.OrderBy(id => GetTagName(id), StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip($"+ {GetTagName(tagId)}{GetTagStrengthLabel(tagId)} · {includeModeLabel}", "active-library-filter-chip active-library-filter-chip-include", () => ClearIncludedTagAsync(tagId)));

        var excludeModeLabel = excludeMode.Equals("and", StringComparison.OrdinalIgnoreCase) ? "AND" : "OR";
        foreach (var tagId in excludeTagIds.OrderBy(id => GetTagName(id), StringComparer.OrdinalIgnoreCase))
            chips.Add(new ActiveFilterChip($"− {GetTagName(tagId)}{GetTagStrengthLabel(tagId)} · {excludeModeLabel}", "active-library-filter-chip active-library-filter-chip-exclude", () => ClearExcludedTagAsync(tagId)));

        return chips;
    }

    private string GetTagName(long tagId) => availableTags.FirstOrDefault(tag => tag.Id == tagId)?.Name ?? $"Tag {tagId}";
    private string GetTagStrengthLabel(long tagId)
    {
        var rule = tagStrengthFilters.GetValueOrDefault(tagId);
        return rule is null || rule.Operator == "all" ? string.Empty : $" · {(rule.Operator == "lte" ? "≤" : "≥")} {rule.Value:0.#}";
    }

