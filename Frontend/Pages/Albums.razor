    private bool IsBlindFieldRevealed(Album album, BlindRevealField field, string? artistId = null) =>
        revealedBlindFields.Contains(new BlindRevealKey(album.Id, field, artistId));

    private async Task RevealBlindFieldAsync(Album album, BlindRevealField field, string? artistId = null)
    {
        if (!IsBlindMode || IsBlindFieldRevealed(album, field, artistId))
            return;

        var fieldName = field switch
        {
            BlindRevealField.AlbumName => "nazwę albumu",
            BlindRevealField.ArtistName => "wykonawcę",
            BlindRevealField.ReleaseYear => "rok wydania",
            BlindRevealField.Artwork => "okładkę albumu",
            _ => "tę informację"
        };

        if (!await JS.InvokeAsync<bool>("confirm", $"Czy na pewno chcesz poznać {fieldName}?"))
            return;

        revealedBlindFields.Add(new BlindRevealKey(album.Id, field, artistId));
    }

