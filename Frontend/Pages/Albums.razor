@if (showRelatedArtistsPanel)
{
    <section class="related-artists-panel shadow" aria-label="@(IsBlindMode ? "Podobni wykonawcy (anonimowo)" : RelatedArtistsTitle)">
        <div class="tagging-panel-header">
            <div>
                <strong>@(IsBlindMode ? $"Podobni wykonawcy: {relatedSourceArtistId}" : RelatedArtistsTitle)</strong>
                <div class="related-artists-panel-subtitle">Dodaj do biblioteki albumy studyjne i bieżącego filtra wykonawców.</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-light" disabled="@isAddingRelatedArtists" title="Zamknij" aria-label="Zamknij" @onclick="CloseRelatedArtists">&times;</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(relatedArtistError))
        {
            <div class="alert alert-warning related-artists-error" role="status">@(IsBlindMode ? "Nie udało się ukończyć jednej z operacji podobnych wykonawców." : relatedArtistError)</div>
        }

        @if (!IsBlindMode)
        {
            <div class="related-artists-search">
                <input class="form-control" placeholder="Wyszukaj wykonawcę w katalogu Spotify..." @bind="relatedArtistSearch" @bind:event="oninput" disabled="@isLoadingRelatedArtists" />
                <button type="button" class="btn btn-outline-light" disabled="@(isLoadingRelatedArtists || string.IsNullOrWhiteSpace(relatedArtistSearch))" @onclick="SearchRelatedArtistsFallbackAsync">Szukaj</button>
            </div>
        }

        @if (isLoadingRelatedArtists)
        {
            <div class="related-artists-loading" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Wczytywanie wykonawców...</span></div>
        }
        else if (relatedArtists.Count > 0)
        {
            <div class="related-artists-bulk-actions">
                <button type="button" class="btn btn-sm btn-outline-light" disabled="@isAddingRelatedArtists" @onclick="SelectAllRelatedArtists">Zaznacz wszystkie</button>
                <button type="button" class="btn btn-sm btn-outline-light" disabled="@(isAddingRelatedArtists || selectedRelatedArtistIds.Count == 0)" @onclick="ClearRelatedArtistSelection">Wyczyść wybór</button>
                <button type="button" class="btn btn-sm btn-primary" disabled="@(isAddingRelatedArtists || selectedRelatedArtistIds.Count == 0)" @onclick="AddSelectedRelatedArtistsAsync">Dodaj wybranych (@selectedRelatedArtistIds.Count)</button>
            </div>

            <div class="related-artists-list">
                @foreach (var artist in relatedArtists)
                {
                    var isSelected = selectedRelatedArtistIds.Contains(artist.Id);
                    <article class="related-artist-item">
                        <label class="related-artist-checkbox">
                            <input type="checkbox" checked="@isSelected" disabled="@isAddingRelatedArtists" @onchange="() => ToggleRelatedArtistSelection(artist.Id)" />
                            <span class="visually-hidden">Zaznacz @(IsBlindMode ? artist.Id : artist.Name)</span>
                        </label>
                        <div class="related-artist-artwork" aria-hidden="true">
                            @if (IsBlindMode)
                            {
                                <span class="blind-related-artwork">@artist.Id</span>
                            }
                            else if (artist.Images.Count > 0 && !string.IsNullOrWhiteSpace(GetBestImageUrl(artist.Images)))
                            {
                                <img src="@GetBestImageUrl(artist.Images)" alt="" />
                            }
                            else
                            {
                                <span>@artist.Name.FirstOrDefault()</span>
                            }
                        </div>
                        <div class="related-artist-details">
                            @if (IsBlindMode)
                            {
                                <span class="related-artist-name">@artist.Id</span>
                            }
                            else
                            {
                                <a href="/artist/@artist.Id" class="link-light text-decoration-none related-artist-name">@artist.Name</a>
                            }
                            <div class="related-artist-meta">
                                @if (artist.IsInLibrary)
                                {
                                    <span class="badge bg-outline-primary text-primary">W bibliotece</span>
                                }
                                @if (!IsBlindMode && artist.Genres.Count > 0)
                                {
                                    <span>@string.Join(", ", artist.Genres.Take(3))</span>
                                }
                            </div>
                            @if (relatedArtistResults.TryGetValue(artist.Id, out var result))
                            {
                                <div class="related-artist-result @(string.IsNullOrWhiteSpace(result.Error) ? string.Empty : "is-warning")">
                                    @(IsBlindMode ? GetBlindRelatedArtistResultText(result) : GetRelatedArtistResultText(result))
                                </div>
                            }
                        </div>
                        <div class="related-artist-actions">
                            <button type="button" class="btn btn-sm album-card-tag related-artist-play" title="Odtwórz top utwory" aria-label="Odtwórz top utwory: @(IsBlindMode ? artist.Id : artist.Name)" disabled="@playingRelatedArtistIds.Contains(artist.Id)" @onclick="() => PlayRelatedArtistTopTracksAsync(artist.Id)">
                                <AppIcon Name="play" />
                            </button>
                            <button type="button" class="btn btn-sm album-card-tag" disabled="@isAddingRelatedArtists" @onclick="() => AddSingleRelatedArtistAsync(artist.Id)">
                                <AppIcon Name="save" /><span>Dodaj</span>
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

