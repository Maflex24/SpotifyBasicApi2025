    private async Task PlayAlbum(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
            return;

        var body = new { context_uri = uri };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task QueueAlbum(string albumId)
    {
        if (!queuingAlbumIds.Add(albumId))
            return;

        try
        {
            await Http.PostAsync($"api/player/queue/albums/{Uri.EscapeDataString(albumId)}", null);
        }
        finally
        {
            queuingAlbumIds.Remove(albumId);
        }
    }

    private async Task PlayAllAlbums()
    {
        if (isQueueingAllAlbums || filteredAlbums.Count == 0)
            return;

        isQueueingAllAlbums = true;
        try
        {
            var albumIds = filteredAlbums
                .Select(album => album.Id)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .ToList();

            await Http.PostAsJsonAsync("api/player/queue/albums", new { albumIds });
        }
        finally
        {
            isQueueingAllAlbums = false;
        }
    }

