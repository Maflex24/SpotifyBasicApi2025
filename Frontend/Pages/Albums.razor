@page "/albums"
@using Frontend.Components
@inject LocalStorageService Store
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Text.Json
@implements IAsyncDisposable

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row">
            <button type="button" class="library-controls-toggle" title="Pokaż filtry albumów" aria-label="Pokaż filtry albumów" aria-expanded="false" @onclick="ToggleControlsVisibility">
                <span aria-hidden="true">▼</span>
            </button>
        </div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row">
                <button type="button" class="library-controls-toggle" title="Zwiń filtry albumów" aria-label="Zwiń filtry albumów" aria-expanded="true" @onclick="ToggleControlsVisibility">
                    <span aria-hidden="true">▲</span>
                </button>
            </div>
        }

    <section class="albums-toolbar mb-3" aria-label="Filtry i akcje albumów">
        <div class="albums-toolbar-heading">
            <h4 class="mb-0">Albumy</h4>
        </div>

        <div class="albums-search-group">
            <label class="visually-hidden" for="albums-search">Szukaj albumu lub wykonawcy</label>
            <input id="albums-search" class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj albumu/wyk. (AND)" @bind="LocalSearch" @bind:event="oninput" />
        </div>

        <div class="albums-filter-fields" aria-label="Ustawienia filtrowania">
            <select class="form-select form-select-sm select-dark" aria-label="Sortuj według" @bind="sortKey">
                <option value="name">Nazwa</option>
                <option value="artist">Wykonawca</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
                <option value="year">Rok</option>
            </select>
            <select class="form-select form-select-sm select-dark" aria-label="Kierunek sortowania" @bind="sortOrder">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>
            <select class="form-select form-select-sm select-dark albums-artist-select" aria-label="Wykonawca" @bind="selectedArtistId">
                <option value="">Wszyscy wykonawcy</option>
                @foreach (var ar in availableAlbumArtists)
                {
                    <option value="@ar.Id">@ar.Name</option>
                }
            </select>
            <div class="albums-year-fields">
                <label class="visually-hidden" for="albums-year-from">Rok od</label>
                <input id="albums-year-from" type="number" class="form-control form-control-sm input-dark" placeholder="Rok od" @bind="fromYear" />
                <label class="visually-hidden" for="albums-year-to">Rok do</label>
                <input id="albums-year-to" type="number" class="form-control form-control-sm input-dark" placeholder="Rok do" @bind="toYear" />
            </div>
        </div>

        <div class="albums-toolbar-actions" aria-label="Akcje filtrowania">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść wszystkie filtry" aria-label="Resetuj filtry" @onclick="ResetFilters">
                <AppIcon Name="reset" /><span class="album-action-label">Resetuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-apply" title="Zastosuj wybrane filtry" aria-label="Zastosuj filtry" @onclick="LoadAlbums">
                <AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-label="Tagi: @(showTagFilters ? "ukryj filtry" : "pokaż filtry")" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters">
                <AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span>
            </button>
        </div>

        <div class="albums-playback-actions" aria-label="Szybkie akcje wyników">
            <button class="btn btn-sm album-action-button album-action-random" title="Wylosuj album z bieżących wyników" aria-label="Wylosuj album z bieżących wyników" @onclick="PickRandomAlbum">
                <AppIcon Name="shuffle" /><span class="album-action-label">Losuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-play-all" title="Dodaj wszystkie wyświetlone albumy do kolejki" aria-label="Odtwórz wszystkie wyświetlone albumy" disabled="@(isQueueingAllAlbums || filteredAlbums.Count == 0)" @onclick="PlayAllAlbums">
                <AppIcon Name="play" /><span class="album-action-label">Odtwórz wszystko</span>
            </button>
        </div>
    </section>

    @if (showTagFilters)
    {
        <section class="albums-tag-filters mb-3" aria-label="Filtry tagów">
            @if (showTagsGrouped)
            {
                <div class="tag-groups-container">
                @foreach (var group in GetGroupedTags())
                {
                    <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                        <h6 class="tag-group-heading">@group.Name</h6>
                        <div class="tag-chips-container">
                        @foreach (var t in group.Tags)
                        {
                            var state = GetTagState(t.Id);
                            var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                            var count = GetTagCount(t.Id);
                            <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleTagState(t.Id)">
                                <span class="tag-chip-label">@t.Name</span>
                            @if (count > 0)
                            {
                                <span class="tag-count-info">@count</span>
                            }
                            </button>
                        }
                        </div>
                    </section>
                }
                </div>
            }
            else
            {
            <div class="tag-chips-container">
                @foreach (var t in availableTags)
                {
                    var state = GetTagState(t.Id);
                    var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                    var count = GetTagCount(t.Id);
                    <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleTagState(t.Id)">
                        <span class="tag-chip-label">@t.Name</span>
                    @if (count > 0)
                    {
                        <span class="tag-count-info">@count</span>
                    }
                    </button>
                }
            </div>
            }
            <div class="tag-filter-controls">
                <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
            </div>
        </section>
    }

    <section class="saved-filters-panel mb-3" aria-labelledby="saved-filters-heading">
        <h5 id="saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
        <div class="saved-filters-fields">
            <label class="visually-hidden" for="saved-filter-select">Wybierz zapisany filtr</label>
            <select id="saved-filter-select" class="form-select form-select-sm select-dark" @bind="selectedSavedFilterId">
                <option value="">Wybierz filtr...</option>
                @foreach (var f in savedFilters)
                {
                    <option value="@f.Id.ToString()">@f.Name</option>
                }
            </select>
            <label class="visually-hidden" for="saved-filter-name">Nazwa filtra</label>
            <input id="saved-filter-name" class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
        </div>
        <div class="saved-filters-actions" aria-label="Akcje zapisanych filtrów">
            <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy filtr" aria-label="Zapisz jako nowy filtr" @onclick="SaveCurrentFilter">
                <AppIcon Name="save" /><span class="album-action-label">Zapisz</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Wczytaj wybrany filtr" aria-label="Wczytaj wybrany filtr" @onclick="ApplySelectedFilter">
                <AppIcon Name="load" /><span class="album-action-label">Wczytaj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę lub nadpisz wybrany filtr" aria-label="Zmień nazwę lub nadpisz wybrany filtr" @onclick="RenameSelectedFilter">
                <AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany filtr" aria-label="Usuń wybrany filtr" @onclick="DeleteSelectedFilter">
                <AppIcon Name="delete" /><span class="album-action-label">Usuń</span>
            </button>
        </div>
    </section>
    }
    </div>

    <div class="library-card-grid">
        @foreach (var a in filteredAlbums)
        {
            <div class="library-card-grid-item">
                <div class="card bg-dark text-light h-100">
                    @if (a.Images?.Any() == true)
                    {
                        <div class="artist-image-square" style="position:relative;">
                            <img src="@GetBestImageUrl(a.Images)" alt="@a.Name">
                            <button class="artist-play-overlay album-card-play" title="Odtwórz album" aria-label="Odtwórz album: @a.Name"
                                    @onclick="() => PlayAlbum(a.Uri)"><AppIcon Name="play" /></button>
                            <button class="artist-queue-overlay album-card-queue" title="Dodaj album na koniec kolejki" aria-label="Dodaj album do kolejki: @a.Name"
                                    disabled="@queuingAlbumIds.Contains(a.Id)" @onclick="() => QueueAlbum(a.Id)"><AppIcon Name="queue" /></button>
                            <button class="album-card-delete" title="Usuń z biblioteki" aria-label="Usuń album z biblioteki: @a.Name"
                                    @onclick="() => ConfirmRemoveAlbum(a.Id)"><AppIcon Name="delete" /></button>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-1"><a href="/album/@a.Id" class="link-light text-decoration-none">@a.Name</a> @if (a.ReleaseYear.HasValue) { <text> (@a.ReleaseYear)</text> }</h6>
                            <span class="badge bg-secondary">@a.Popularity</span>
                        </div>

                        @if (a.Artists?.Any() == true)
                        {
                            <div class="mb-2">
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var art in a.Artists)
                                    {
                                        <a href="/artist/@art.Id" class="badge bg-outline-light text-light text-decoration-none" style="font-size: 0.8rem;">@art.Name</a>
                                    }
                                </div>
                            </div>
                        }

                        @if (a.Tags?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Tagi:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var tag in a.Tags.Take(3))
                                    {
                                        <span class="badge badge-tag">@tag.TagName (@tag.Strength)</span>
                                    }
                                    @if (a.Tags.Count > 3)
                                    {
                                        <span class="badge bg-outline-primary text-primary badge-tag">+@(a.Tags.Count - 3)</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="mt-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button class="btn btn-sm album-card-tag" title="Zarządzaj tagami albumu" aria-label="Taguj album: @a.Name" @onclick="() => OpenAlbumTagging(a.Id)">
                                    <AppIcon Name="tag" /><span>Taguj</span>
                                </button>
                                <span class="badge bg-secondary" title="Liczba utworów" style="font-size:0.75rem;">@a.TotalTracks</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;
    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string Scope { get; set; } = string.Empty; public string? ContextId { get; set; } public string PayloadJson { get; set; } = string.Empty; }

    private string sortKey = "name";
    private string sortOrder = "asc";
    private string? selectedTagFilter;
    private string? selectedTagSort;
    private string? selectedArtistId;
    private List<Album> albums = new();
    private List<Album> filteredAlbums = new();
    private readonly HashSet<string> queuingAlbumIds = new();
    private bool isQueueingAllAlbums;
    private List<TagDto> availableTags = new();
    private List<TagGroupDto> tagGroups = new();
    private List<AlbumArtistOption> availableAlbumArtists = new();
    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private string includeMode = "or";
    private string excludeMode = "or";
    private bool showTagFilters = true;
    private bool showTagsGrouped;
    private const string TagLayoutStoreKey = "tag-layout:grouped";
    private ElementReference controlsSentinel;
    private DotNetObjectReference<Albums>? controlsObserverRef;
    private bool controlsPastAnchor;
    private bool controlsManuallyExpanded;
    private bool ControlsCollapsed => controlsPastAnchor && !controlsManuallyExpanded;

    private Dictionary<string, float?> hoverByKey = new();
    private Dictionary<string, long?> selectedTagByAlbum = new();
    private bool showAlbumTagging = false;
    private string? taggingAlbumId;
    private Dictionary<long, int> tagCounts = new();
    private int? fromYear = null;
    private int? toYear = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadTagLayout();
        await LoadFromStore();
        await LoadAvailableTags();
        await LoadAlbumArtists();
        await LoadAlbums();
        await LoadSavedFilters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        controlsObserverRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, controlsObserverRef);
    }

    [JSInvokable]
    public Task SetControlsPastAnchor(bool isPastAnchor)
    {
        if (controlsPastAnchor == isPastAnchor)
            return Task.CompletedTask;

        controlsPastAnchor = isPastAnchor;

        if (!controlsPastAnchor)
            controlsManuallyExpanded = false;

        return InvokeAsync(StateHasChanged);
    }

    private void ToggleControlsVisibility()
    {
        controlsManuallyExpanded = ControlsCollapsed;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("libraryControls.disconnect");
        }
        catch (JSDisconnectedException)
        {
            // The browser was already disconnected during component disposal.
        }

        controlsObserverRef?.Dispose();
    }

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync("api/library/filters?scope=albums");
        if (!res.IsSuccessStatusCode) return;
        savedFilters = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
    }

    private async Task LoadAlbums()
    {
        var query = new List<string>();

        query.Add($"sort={sortKey}");
        query.Add($"order={sortOrder}");

        if (!string.IsNullOrEmpty(selectedTagFilter))
            query.Add($"tags={selectedTagFilter}");

        if (!string.IsNullOrEmpty(selectedTagSort))
            query.Add($"sortTagId={selectedTagSort}");

        if (!string.IsNullOrEmpty(selectedArtistId))
            query.Add($"artistId={Uri.EscapeDataString(selectedArtistId)}");

        if (fromYear.HasValue)
            query.Add($"fromYear={fromYear.Value}");

        if (toYear.HasValue)
            query.Add($"toYear={toYear.Value}");

        if (includeTagIds.Count > 0)
        {
            query.Add($"includeTags={string.Join(',', includeTagIds)}");
            query.Add($"includeMode={includeMode}");
        }

        if (excludeTagIds.Count > 0)
        {
            query.Add($"excludeTags={string.Join(',', excludeTagIds)}");
            query.Add($"excludeMode={excludeMode}");
        }

        var res = await Http.GetAsync($"api/library/albums?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var payload = await res.Content.ReadFromJsonAsync<AlbumsResponse>();
        albums = payload?.items ?? new List<Album>();

        foreach (var a in albums)
        {
            if (!selectedTagByAlbum.ContainsKey(a.Id))
                selectedTagByAlbum[a.Id] = null;
        }

        ApplyLocalFilter();
        await LoadAlbumTagCounts();

        await SaveToStore();
    }

    private AlbumsState BuildCurrentState() => new AlbumsState
    {
        sortKey = sortKey,
        sortOrder = sortOrder,
        selectedTagFilter = selectedTagFilter,
        selectedTagSort = selectedTagSort,
        selectedArtistId = selectedArtistId,
        localSearch = localSearch,
        includeMode = includeMode,
        excludeMode = excludeMode,
        includeTagIds = includeTagIds.ToArray(),
        excludeTagIds = excludeTagIds.ToArray(),
        showTagFilters = showTagFilters,
        fromYear = fromYear,
        toYear = toYear,
    };

    private async Task SaveCurrentFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "albums", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PostAsJsonAsync("api/library/filters", body);
        if (res.IsSuccessStatusCode)
        {
            newFilterName = string.Empty;
            await LoadSavedFilters();
        }
    }

    private async Task ApplySelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var item = savedFilters.FirstOrDefault(x => x.Id == id);
        if (item == null || string.IsNullOrWhiteSpace(item.PayloadJson)) return;
        var state = JsonSerializer.Deserialize<AlbumsState>(item.PayloadJson);
        if (state == null) return;

        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        selectedArtistId = state.selectedArtistId;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        showTagFilters = state.showTagFilters ?? showTagFilters;
        fromYear = state.fromYear;
        toYear = state.toYear;

        await LoadAlbums();
    }

    private async Task RenameSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "albums", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PutAsJsonAsync($"api/library/filters/{id}", body);
        if (res.IsSuccessStatusCode)
        {
            await LoadSavedFilters();
        }
    }

    private async Task DeleteSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var res = await Http.DeleteAsync($"api/library/filters/{id}");
        if (res.IsSuccessStatusCode)
        {
            selectedSavedFilterId = null;
            await LoadSavedFilters();
        }
    }

    private async Task LoadAlbumArtists()
    {
        var res = await Http.GetAsync("api/library/albums/artists");

        if (!res.IsSuccessStatusCode)
            return;

        var list = await res.Content.ReadFromJsonAsync<List<AlbumArtistOption>>() ?? new List<AlbumArtistOption>();
        availableAlbumArtists = list;
    }

    private async Task LoadAvailableTags()
    {
        var tagsRequest = Http.GetAsync("api/tags");
        var groupsRequest = Http.GetAsync("api/tags-group");
        await Task.WhenAll(tagsRequest, groupsRequest);

        var res = await tagsRequest;
        if (!res.IsSuccessStatusCode)
            return;

        var allTags = await res.Content.ReadFromJsonAsync<List<TagDto>>() ?? new List<TagDto>();
        var groupsResponse = await groupsRequest;
        tagGroups = groupsResponse.IsSuccessStatusCode
            ? await groupsResponse.Content.ReadFromJsonAsync<List<TagGroupDto>>() ?? new List<TagGroupDto>()
            : new List<TagGroupDto>();
        availableTags = allTags.Where(t => t.ForAlbum).OrderBy(t => t.Name).ToList();
        albumTagItems = availableTags.Select(t => new TagItem { Id = t.Id, Name = t.Name, TagGroupId = t.TagGroupId }).ToList();
        await LoadAlbumTagCounts();
    }

    private RenderFragment StarRating(string key, float value, Func<float, Task> onChange) => builder =>
    {
        int seq = 0;
        var display = hoverByKey.TryGetValue(key, out var h) && h.HasValue ? h.Value : value;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "style", "display:inline-flex; align-items:center;");
        builder.AddAttribute(seq++, "title", $"{display:0.0}");
        for (int i = 1; i <= 6; i++)
        {
            var star = i;
            var fill = display >= star ? 1.0f : (display >= star - 0.5f ? 0.5f : 0f);

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "position:relative; display:inline-block; width:2rem; height:2rem; line-height:2rem; font-size:2rem; margin-right:6px;");
            builder.AddAttribute(seq++, "onmouseleave", EventCallback.Factory.Create(this, () => { if (hoverByKey.ContainsKey(key)) hoverByKey.Remove(key); }));

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-secondary");
            builder.AddAttribute(seq++, "style", "position:absolute; inset:0; pointer-events:none;");
            builder.AddContent(seq++, "☆");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-warning");
            var width = fill >= 1.0f ? "100%" : (fill >= 0.5f ? "50%" : "0%");
            builder.AddAttribute(seq++, "style", $"position:absolute; inset:0; width:{width}; overflow:hidden; white-space:nowrap; pointer-events:none;");
            builder.AddContent(seq++, "★");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; left:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star - 0.5f; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star - 0.5f)));
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; right:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star)));
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private async Task SetAlbumTagStrength(string albumId, long tagId, float strength)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "album", SpotifyItemId = albumId, Strength = strength };
        var res = await Http.PutAsJsonAsync("api/tags/assign", model);

        if (!res.IsSuccessStatusCode)
        {
            var resCreate = await Http.PostAsJsonAsync("api/tags/assign", model);

            if (!resCreate.IsSuccessStatusCode)
                return;
        }

        await RefreshAlbumTags(albumId);
    }

    private async Task RemoveAlbumTag(string albumId, long tagId)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "album", SpotifyItemId = albumId, Strength = 0 };
        var req = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "api/tags/assign")
        {
            Content = JsonContent.Create(model)
        });

        if (!req.IsSuccessStatusCode)
            return;

        await RefreshAlbumTags(albumId);
    }

    private void OpenAlbumTagging(string albumId)
    {
        taggingAlbumId = albumId;
        showAlbumTagging = true;
    }

    private void CloseAlbumTagging()
    {
        showAlbumTagging = false;
        taggingAlbumId = null;
    }

    private async Task RefreshAlbumTags(string albumId)
    {
        var response = await Http.GetAsync($"api/tags/assign/album/{Uri.EscapeDataString(albumId)}");
        if (!response.IsSuccessStatusCode)
            return;

        var tags = await response.Content.ReadFromJsonAsync<List<TagBadge>>() ?? new List<TagBadge>();
        await ApplyTaggedAlbumState(new TagAssignmentState { ItemType = "album", SpotifyItemId = albumId, Tags = tags });
    }

    private async Task ApplyTaggedAlbumState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "album", StringComparison.OrdinalIgnoreCase))
            return;

        var album = albums.FirstOrDefault(item => item.Id == state.SpotifyItemId);
        if (album == null)
            return;

        var previousTagIds = album.Tags.Select(tag => tag.TagId).ToHashSet();
        album.Tags = state.Tags.Select(tag => new AlbumTag
        {
            TagId = tag.TagId,
            TagName = tag.TagName,
            TagGroupName = tag.TagGroupName,
            Strength = tag.Strength
        }).ToList();

        if (!MatchesAlbumTagFilters(album))
            albums.Remove(album);

        SortAlbumsByTagStrength();
        ApplyLocalFilter();

        if (!previousTagIds.SetEquals(album.Tags.Select(tag => tag.TagId)))
            await LoadAlbumTagCounts();
    }

    private bool MatchesAlbumTagFilters(Album album)
    {
        var tagIds = album.Tags.Select(tag => tag.TagId).ToHashSet();
        if (long.TryParse(selectedTagFilter, out var selectedTagId) && !tagIds.Contains(selectedTagId))
            return false;

        if (includeTagIds.Count > 0)
        {
            var matchesInclude = string.Equals(includeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? includeTagIds.All(tagIds.Contains)
                : includeTagIds.Any(tagIds.Contains);
            if (!matchesInclude)
                return false;
        }

        if (excludeTagIds.Count > 0)
        {
            var matchesExcluded = string.Equals(excludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? excludeTagIds.All(tagIds.Contains)
                : excludeTagIds.Any(tagIds.Contains);
            if (matchesExcluded)
                return false;
        }

        return true;
    }

    private void SortAlbumsByTagStrength()
    {
        if (!string.Equals(sortKey, "weight", StringComparison.OrdinalIgnoreCase) || !long.TryParse(selectedTagSort, out var tagId))
            return;

        albums = (string.Equals(sortOrder, "asc", StringComparison.OrdinalIgnoreCase)
                ? albums.OrderBy(album => album.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0)
                : albums.OrderByDescending(album => album.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0))
            .ThenBy(album => album.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task AddAlbumTagFromPanel(long? tagId)
    {
        if (taggingAlbumId == null || tagId is null)
            return;

        await SetAlbumTagStrength(taggingAlbumId, tagId.Value, 3.0f);
    }

    private async Task PlayAlbum(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri))
            return;

        var body = new { context_uri = uri };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task QueueAlbum(string albumId)
    {
        if (!queuingAlbumIds.Add(albumId))
            return;

        try
        {
            await Http.PostAsync($"api/player/queue/albums/{Uri.EscapeDataString(albumId)}", null);
        }
        finally
        {
            queuingAlbumIds.Remove(albumId);
        }
    }

    private async Task PlayAllAlbums()
    {
        if (isQueueingAllAlbums || filteredAlbums.Count == 0)
            return;

        isQueueingAllAlbums = true;
        try
        {
            var albumIds = filteredAlbums
                .Select(album => album.Id)
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .ToList();

            await Http.PostAsJsonAsync("api/player/queue/albums", new { albumIds });
        }
        finally
        {
            isQueueingAllAlbums = false;
        }
    }

    private async Task ConfirmRemoveAlbum(string albumId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Czy na pewno chcesz usunąć album z biblioteki?"))
            return;

        var res = await Http.DeleteAsync($"api/library/albums/{Uri.EscapeDataString(albumId)}");
        if (!res.IsSuccessStatusCode)
            return;

        await LoadAlbums();
    }

    private async Task ResetFilters()
    {
        sortKey = "name";
        sortOrder = "asc";
        selectedTagFilter = null;
        selectedTagSort = null;
        LocalSearch = null;
        includeTagIds.Clear();
        excludeTagIds.Clear();
        includeMode = "or";
        excludeMode = "or";
        fromYear = null;
        toYear = null;

        await LoadAlbums();
        await SaveToStore();
    }

    private async Task ApplyFilterByTag(long tagId)
    {
        var tag = tagId.ToString();

        if (selectedTagFilter == tag)
        {
            selectedTagFilter = null;

            await LoadAlbums();

            return;
        }

        selectedTagFilter = tag;
        selectedTagSort = tag;
        sortKey = "weight";
        sortOrder = "desc";

        await LoadAlbums();
    }

