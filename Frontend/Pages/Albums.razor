    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            controlsObserverRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, controlsObserverRef);
            await JS.InvokeVoidAsync("infiniteScroll.observeWindow", albumsSentinel, controlsObserverRef);
        }

        var shouldObserveArtistNavigation = IsArtistGroupingEnabled && GetArtistAlbumGroups().Count > 1;
        if (shouldObserveArtistNavigation && controlsObserverRef != null)
        {
            if (!artistNavigationObserved)
            {
                await JS.InvokeVoidAsync("albumsArtistNavigation.observe", controlsObserverRef);
                artistNavigationObserved = true;
            }
            else
            {
                await JS.InvokeVoidAsync("albumsArtistNavigation.refresh");
            }
        }
        else if (artistNavigationObserved)
        {
            await JS.InvokeVoidAsync("albumsArtistNavigation.disconnect");
            artistNavigationObserved = false;
            canNavigateToPreviousArtist = false;
            canNavigateToNextArtist = false;
        }

        if (!string.IsNullOrWhiteSpace(pendingAlbumScrollId))
        {
            var albumId = pendingAlbumScrollId;
            pendingAlbumScrollId = null;
            try
            {
                await JS.InvokeAsync<bool>("albumsLocalSelection.scrollToAlbum", albumId);
