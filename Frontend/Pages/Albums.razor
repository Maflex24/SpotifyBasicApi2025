                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                started = (await Http.PutAsJsonAsync("api/player/play", body)).IsSuccessStatusCode;
            }
        }

        if (started)
            ActivePlayback.SetCurrentAlbumId(albumId);
    }

