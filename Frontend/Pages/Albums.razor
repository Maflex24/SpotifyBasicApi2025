    private async Task CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);

        if (state == 0)
        {
            includeTagIds.Add(tagId);
            await MarkFiltersDirtyAsync();
            return;
        }

        if (state == 1)
        {
            includeTagIds.Remove(tagId);
            excludeTagIds.Add(tagId);
            await MarkFiltersDirtyAsync();
            return;
        }

        excludeTagIds.Remove(tagId);
        await MarkFiltersDirtyAsync();
    }

    private async Task ToggleIncludeMode()
    {
        includeMode = includeMode == "and" ? "or" : "and";
        await MarkFiltersDirtyAsync();
    }

    private async Task ToggleExcludeMode()
    {
        excludeMode = excludeMode == "and" ? "or" : "and";
        await MarkFiltersDirtyAsync();
    }
    private async Task ToggleTagFilters()
    {
        showTagFilters = !showTagFilters;
        await SaveToStore();
    }

    private async Task LoadTagLayout()
    {
        showTagsGrouped = await Store.GetItemAsync<bool?>(TagLayoutStoreKey) ?? false;
    }

    private async Task ToggleTagLayout()
    {
        showTagsGrouped = !showTagsGrouped;
        await Store.SetItemAsync(TagLayoutStoreKey, showTagsGrouped);
    }

    private async Task LoadTagVisibility()
    {
        showUnassignedTags = await Store.GetItemAsync<bool?>(TagVisibilityStoreKey) ?? false;
    }

    private Task SaveTagVisibility() => Store.SetItemAsync(TagVisibilityStoreKey, showUnassignedTags);

    private IEnumerable<TagDto> GetVisibleTags() => ExpandTagVariants(showUnassignedTags
        ? availableTags
        : availableTags.Where(tag => GetTagCount(tag.Id) > 0 || includeTagIds.Contains(tag.Id) || excludeTagIds.Contains(tag.Id)))
        .Where(tag => string.IsNullOrWhiteSpace(tagSearch) || tag.Name.Contains(tagSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private static IEnumerable<TagDto> ExpandTagVariants(IEnumerable<TagDto> tags) => tags.SelectMany(tag => new[] { tag }.Concat(tag.Aliases
        .Where(alias => !string.Equals(alias, tag.Name, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Select(alias => new TagDto { Id = tag.Id, Name = alias, ForAlbum = tag.ForAlbum, TagGroupId = tag.TagGroupId })));

    private void ClearTagSearch() => tagSearch = null;

    private IEnumerable<TagGroupView> GetGroupedTags()
    {
        var groupedTagIds = tagGroups.Select(group => group.Id).ToHashSet();
        var visibleTags = GetVisibleTags().ToList();
        var groups = tagGroups
            .OrderBy(group => group.Name)
            .Select(group => new TagGroupView
            {
                Name = group.Name,
                Tags = visibleTags.Where(tag => tag.TagGroupId == group.Id).OrderBy(tag => tag.Name).ToList()
            })
            .Where(group => group.Tags.Count > 0)
            .ToList();
        var ungroupedTags = visibleTags.Where(tag => !groupedTagIds.Contains(tag.TagGroupId)).OrderBy(tag => tag.Name).ToList();
        if (ungroupedTags.Count > 0)
            groups.Add(new TagGroupView { Name = "Pozostałe tagi", Tags = ungroupedTags });
        return groups;
    }

    private string? localSearch;
    private string? LocalSearch
    {
        get => localSearch;
        set
        {
            if (localSearch == value)
                return;

            localSearch = value;
            _ = MarkFiltersDirtyAsync();
        }
    }

    private async Task PickRandomAlbumAsync()
    {
        if (isLoadingAlbums)
            return;

        var sourceFilters = GetRandomSourceFilters();
        var query = BuildAlbumQuery(sourceFilters);
        query.Add("random=true");

        isLoadingAlbums = true;
        await InvokeAsync(StateHasChanged);

        string? randomSearch;
        try
        {
            var response = await Http.GetAsync($"api/library/albums?{string.Join('&', query)}");
            if (!response.IsSuccessStatusCode)
                return;

            randomSearch = (await response.Content.ReadFromJsonAsync<RandomAlbumResponse>())?.randomSearch;
        }
        finally
        {
            isLoadingAlbums = false;
            await InvokeAsync(StateHasChanged);
        }

        if (string.IsNullOrWhiteSpace(randomSearch))
            return;

        var previousSearch = localSearch;
        var previousRandomSelection = isRandomSelection;
        var previousRandomSourceSearch = randomSourceSearch;
        randomSourceSearch = sourceFilters.LocalSearch;
        isRandomSelection = true;
        localSearch = randomSearch;

        var randomFilters = sourceFilters with { LocalSearch = randomSearch };
        if (await LoadAlbumsAsync(randomFilters))
            appliedFilters = randomFilters;
        else
        {
            localSearch = previousSearch;
            isRandomSelection = previousRandomSelection;
            randomSourceSearch = previousRandomSourceSearch;
            await SaveToStore();
        }
    }

    private async Task ReturnToRandomSourceAsync()
    {
        if (!isRandomSelection || isLoadingAlbums)
            return;

        var sourceFilters = GetRandomSourceFilters();
        var previousSearch = localSearch;
        ClearRandomSelection();
        localSearch = sourceFilters.LocalSearch;

        if (await LoadAlbumsAsync(sourceFilters))
            appliedFilters = sourceFilters;
        else
        {
            localSearch = previousSearch;
            isRandomSelection = true;
            randomSourceSearch = sourceFilters.LocalSearch;
            await SaveToStore();
        }
    }

    private AlbumFilterSnapshot GetRandomSourceFilters()
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        return isRandomSelection ? filters with { LocalSearch = randomSourceSearch } : filters;
    }

    private void ClearRandomSelection()
    {
        isRandomSelection = false;
        randomSourceSearch = null;
    }

    private sealed class TagCountDto { public long id { get; set; } public string name { get; set; } = string.Empty; public int count { get; set; } }

    private async Task LoadAlbumTagCounts(AlbumFilterSnapshot filters)
    {
        var query = new List<string>();

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter))
            query.Add($"tags={filters.SelectedTagFilter}");

        if (!string.IsNullOrEmpty(filters.SelectedArtistId))
            query.Add($"artistId={Uri.EscapeDataString(filters.SelectedArtistId)}");

        if (filters.FromYear.HasValue)
            query.Add($"fromYear={filters.FromYear.Value}");

        if (filters.ToYear.HasValue)
            query.Add($"toYear={filters.ToYear.Value}");

        if (!string.IsNullOrWhiteSpace(filters.LocalSearch))
            query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");

        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
        }

        var res = await Http.GetAsync($"api/library/albums/tags/counts?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var list = await res.Content.ReadFromJsonAsync<List<TagCountDto>>() ?? new List<TagCountDto>();
        tagCounts = list.ToDictionary(x => x.id, x => x.count);
        await InvokeAsync(StateHasChanged);
    }

    private int GetTagCount(long tagId)
    {
        return tagCounts.TryGetValue(tagId, out var c) ? c : 0;
    }
}

@if (showAlbumTagging && taggingAlbumId != null)
{
    <TaggingPanel Title="Tagowanie albumu"
                             ItemType="album"
                             SpotifyItemId="@taggingAlbumId"
                             Items="albumTagItems"
                             Tags="@(albums.FirstOrDefault(x => x.Id == taggingAlbumId)?.Tags?.Select(t => new Frontend.Components.TagBadge{ TagId=t.TagId, TagName=t.TagName, TagGroupName=t.TagGroupName, Strength=t.Strength}).ToList() ?? new List<Frontend.Components.TagBadge>())"
                             Placeholder="Taguj album..."
                             OnChanged="ApplyTaggedAlbumState"
                             OnClose="CloseAlbumTagging" />
}
