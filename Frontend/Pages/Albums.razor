    private async Task ApplyTaggedAlbumState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "album", StringComparison.OrdinalIgnoreCase))
            return;

        var album = FindLoadedAlbum(state.SpotifyItemId);
        if (album == null)
            return;

        var isCatalogOnlyAlbum = !albums.Any(item => item.Id == state.SpotifyItemId)
            && artistCatalogAlbumsByArtistId.Values.Any(items => items.Any(item => item.Id == state.SpotifyItemId));

        var previousTagIds = album.Tags.Select(tag => tag.TagId).ToHashSet();
        album.Tags = state.Tags.Select(tag => new AlbumTag
        {
            TagId = tag.TagId,
            TagName = tag.TagName,
            TagGroupName = tag.TagGroupName,
            Strength = tag.Strength
        }).ToList();

        if (isCatalogOnlyAlbum)
        {
            await ReloadAppliedAlbumsAsync();
            return;
        }

        var filters = appliedFilters ?? CaptureCurrentFilters();
        if (filters.IncludeArtistTags)
        {
            await ReloadAppliedAlbumsAsync();
            return;
        }

        if (!MatchesAlbumTagFilters(album, filters))
            albums.Remove(album);

        SortAlbumsByTagStrength(filters);
        filteredAlbums = albums.ToList();

        if (!previousTagIds.SetEquals(album.Tags.Select(tag => tag.TagId)))
            await LoadAlbumTagCounts(filters);
    }

    private static bool MatchesAlbumTagFilters(Album album, AlbumFilterSnapshot filters)
    {
        var tagIds = album.Tags.Select(tag => tag.TagId).ToHashSet();
        if (long.TryParse(filters.SelectedTagFilter, out var selectedTagId) && !tagIds.Contains(selectedTagId))
            return false;

        if (filters.IncludeTagIds.Length > 0)
        {
            var matchesInclude = string.Equals(filters.IncludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.IncludeTagIds.All(tagIds.Contains)
                : filters.IncludeTagIds.Any(tagIds.Contains);
            if (!matchesInclude)
                return false;
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            var matchesExcluded = string.Equals(filters.ExcludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.ExcludeTagIds.All(tagIds.Contains)
                : filters.ExcludeTagIds.Any(tagIds.Contains);
            if (matchesExcluded)
                return false;
        }

        return true;
    }

    private bool HasDirectAlbumTagMatch(Album album)
    {
        var filters = appliedFilters;
        if (IsBlindMode || filters is null || !filters.IncludeArtistTags || !HasPositiveTagCriteria(filters))
            return false;

        var albumTags = album.Tags.Select(tag => (tag.TagId, tag.Strength));
        return MatchesPositiveTagCriteria(albumTags, filters);
    }

    private static bool HasPositiveTagCriteria(AlbumFilterSnapshot filters) =>
        long.TryParse(filters.SelectedTagFilter, out _) || filters.IncludeTagIds.Length > 0;

    private static bool MatchesPositiveTagCriteria(IEnumerable<(long TagId, float Strength)> tags, AlbumFilterSnapshot filters)
    {
        var tagList = tags.ToList();

        if (long.TryParse(filters.SelectedTagFilter, out var selectedTagId)
            && !tagList.Any(tag => tag.TagId == selectedTagId))
            return false;

        if (filters.IncludeTagIds.Length == 0)
            return true;

        var strengthRules = filters.IncludeTagStrengths.ToDictionary(rule => rule.TagId);
        bool MatchesTag(long tagId) => tagList.Any(tag => tag.TagId == tagId
            && MatchesTagStrength(tag.Strength, strengthRules.GetValueOrDefault(tagId)));

        return string.Equals(filters.IncludeMode, "and", StringComparison.OrdinalIgnoreCase)
            ? filters.IncludeTagIds.All(MatchesTag)
            : filters.IncludeTagIds.Any(MatchesTag);
    }

    private static bool MatchesTagStrength(float strength, TagStrengthFilterRule? rule) => rule?.Operator.ToLowerInvariant() switch
    {
        "gte" => strength >= rule.Value,
        "lte" => strength <= rule.Value,
        _ => true
    };

    private void SortAlbumsByTagStrength(AlbumFilterSnapshot filters)
    {
        if (!string.Equals(filters.SortKey, "weight", StringComparison.OrdinalIgnoreCase) || !long.TryParse(filters.SelectedTagSort, out var tagId))
            return;

        albums = (string.Equals(filters.SortOrder, "asc", StringComparison.OrdinalIgnoreCase)
                ? albums.OrderBy(album => album.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0)
                : albums.OrderByDescending(album => album.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0))
            .ThenBy(album => album.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

