        return GetVisibleAlbumArtists()
            .GroupBy(artist => GetArtistGroupName(IsBlindMode ? artist.Id : artist.Name), StringComparer.Ordinal)
            .OrderBy(group => group.Key == "#")
            .ThenBy(group => group.Key, comparer)
            .Select(group => new ArtistFilterGroup
            {
                Name = group.Key,
                Artists = group.OrderBy(artist => artist.Name, comparer).ToList()
            });
    }

    private static string GetArtistGroupName(string? artistName)
    {
        var name = artistName?.Trim();
        if (string.IsNullOrEmpty(name) || !char.IsLetter(name[0]))
            return "#";

        return char.ToUpper(name[0], CultureInfo.GetCultureInfo("pl-PL")).ToString();
    }

