        if (state == null) return;

        ClearRandomSelection();
        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        selectedArtistId = state.selectedArtistId;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        showTagFilters = state.showTagFilters ?? showTagFilters;
        fromYear = state.fromYear;
        toYear = state.toYear;

        await ApplyFiltersAsync();
    }

