    private int GetTagState(long tagId)
    {
        if (includeTagIds.Contains(tagId))
            return 1;

        if (excludeTagIds.Contains(tagId))
            return 2;

        return 0;
    }

    private async Task CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);

        if (state == 0)
        {
            includeTagIds.Add(tagId);
            tagStrengthFilters.TryAdd(tagId, new TagStrengthFilterState());
            await MarkFiltersDirtyAsync();
            return;
        }

        if (state == 1)
        {
            includeTagIds.Remove(tagId);
            excludeTagIds.Add(tagId);
            await MarkFiltersDirtyAsync();
            return;
        }

        excludeTagIds.Remove(tagId);
        tagStrengthFilters.Remove(tagId);
        await MarkFiltersDirtyAsync();
    }

    private TagStrengthFilterState? GetTagStrengthRule(long tagId) => GetTagState(tagId) == 0 ? null : tagStrengthFilters.GetValueOrDefault(tagId) ?? (tagStrengthFilters[tagId] = new TagStrengthFilterState());
    private async Task CycleTagStrengthOperator(long tagId) { var rule = GetTagStrengthRule(tagId); if (rule is null) return; rule.Operator = rule.Operator == "gte" ? "lte" : rule.Operator == "lte" ? "all" : "gte"; await MarkFiltersDirtyAsync(); }
    private async Task SetTagStrength(TagStrengthValueChanged change) { var rule = GetTagStrengthRule(change.TagId); if (rule is null) return; rule.Value = change.Value; await MarkFiltersDirtyAsync(); }

