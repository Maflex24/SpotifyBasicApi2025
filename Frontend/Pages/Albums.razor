    private List<ArtistAlbumGroup> GetArtistAlbumGroups()
    {
        var groups = new Dictionary<string, ArtistAlbumGroup>(StringComparer.OrdinalIgnoreCase);

        foreach (var album in filteredAlbums)
        {
            var artists = (album.Artists ?? new List<SimpleArtist>())
                .Where(artist => !string.IsNullOrWhiteSpace(artist.Name))
                .GroupBy(artist => !string.IsNullOrWhiteSpace(artist.Id) ? $"artist:{artist.Id}" : $"name:{artist.Name.Trim()}", StringComparer.OrdinalIgnoreCase)
                .Select(group => group.First())
                .ToList();

            if (artists.Count == 0)
            {
                AddAlbumToArtistGroup("unknown", "Nieznany wykonawca", null, album);
                continue;
            }

            foreach (var artist in artists)
            {
                var key = !string.IsNullOrWhiteSpace(artist.Id) ? $"artist:{artist.Id}" : $"name:{artist.Name.Trim()}";
                AddAlbumToArtistGroup(key, artist.Name.Trim(), artist, album);
            }
        }

        foreach (var group in groups.Values)
        {
            if (!string.IsNullOrWhiteSpace(group.Id)
                && IsArtistCatalogExpanded(group.Id)
                && artistCatalogAlbumsByArtistId.TryGetValue(group.Id, out var catalogAlbums))
            {
                group.Albums = group.Albums
                    .Concat(catalogAlbums)
                    .GroupBy(album => album.Id, StringComparer.Ordinal)
                    .Select(albumGroup => albumGroup.First())
                    .ToList();
            }

            group.Albums = group.Albums
                .GroupBy(album => album.Id, StringComparer.Ordinal)
                .Select(albumGroup => albumGroup.First())
                .OrderBy(album => string.IsNullOrWhiteSpace(album.ReleaseDate))
                .ThenBy(album => album.ReleaseDate, StringComparer.Ordinal)
                .ThenBy(album => album.Name, StringComparer.CurrentCultureIgnoreCase)
                .ThenBy(album => album.Id, StringComparer.Ordinal)
                .ToList();
        }

        return string.Equals(sortOrder, "desc", StringComparison.OrdinalIgnoreCase)
            ? groups.Values.OrderByDescending(group => group.Name, StringComparer.CurrentCultureIgnoreCase).ToList()
            : groups.Values.OrderBy(group => group.Name, StringComparer.CurrentCultureIgnoreCase).ToList();

        void AddAlbumToArtistGroup(string key, string name, SimpleArtist? artist, Album album)
        {
            if (!groups.TryGetValue(key, out var group))
            {
                group = new ArtistAlbumGroup
                {
                    Id = artist?.Id ?? string.Empty,
                    Name = name,
                    Genres = artist?.Genres?.OrderBy(genre => genre, StringComparer.OrdinalIgnoreCase).ToList() ?? new List<string>(),
                    Tags = artist?.Tags?.OrderBy(tag => tag.TagName, StringComparer.OrdinalIgnoreCase).ToList() ?? new List<ArtistTag>(),
                    Note = artist?.Note
                };
                groups[key] = group;
            }

            group.Albums.Add(album);
        }
    }

    private bool IsArtistCatalogExpanded(string artistId) => !string.IsNullOrWhiteSpace(artistId) && expandedArtistCatalogIds.Contains(artistId);

    private async Task ToggleArtistCatalogAsync(string artistId)
    {
        if (string.IsNullOrWhiteSpace(artistId) || isLoadingArtistCatalogIds.Contains(artistId))
            return;

        artistCatalogErrors.Remove(artistId);
        if (expandedArtistCatalogIds.Remove(artistId))
        {
            await SaveToStore();
            return;
        }

        if (await LoadArtistCatalogAsync(artistId))
        {
            expandedArtistCatalogIds.Add(artistId);
            await SaveToStore();
        }
    }

    private async Task RefreshExpandedArtistCatalogsAsync()
    {
        var availableIds = GetArtistAlbumGroups().Select(group => group.Id)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToHashSet(StringComparer.Ordinal);

        foreach (var artistId in expandedArtistCatalogIds.Where(availableIds.Contains).ToList())
            await LoadArtistCatalogAsync(artistId);
    }

    private async Task<bool> LoadArtistCatalogAsync(string artistId)
    {
        if (!isLoadingArtistCatalogIds.Add(artistId))
            return false;

        artistCatalogErrors.Remove(artistId);
        try
        {
            var filters = appliedFilters ?? CaptureCurrentFilters();
            var query = BuildArtistCatalogQuery(filters);
            var response = await Http.GetAsync($"api/library/albums/catalog/{Uri.EscapeDataString(artistId)}?{string.Join('&', query)}");
            if (!response.IsSuccessStatusCode)
            {
                artistCatalogErrors[artistId] = "Nie udało się pobrać pełnej dyskografii wykonawcy.";
                return false;
            }

            artistCatalogAlbumsByArtistId[artistId] = await response.Content.ReadFromJsonAsync<List<Album>>() ?? new List<Album>();
            return true;
        }
        catch
        {
            artistCatalogErrors[artistId] = "Nie udało się pobrać pełnej dyskografii wykonawcy.";
            return false;
        }
        finally
        {
            isLoadingArtistCatalogIds.Remove(artistId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private static List<string> BuildArtistCatalogQuery(AlbumFilterSnapshot filters)
    {
        var query = new List<string>();
        if (filters.ExcludeArtistIds.Length > 0)
            query.Add($"excludeArtists={string.Join(',', filters.ExcludeArtistIds.Select(Uri.EscapeDataString))}");
        if (filters.ExcludeGenres.Length > 0)
            query.Add($"excludeGenres={string.Join(',', filters.ExcludeGenres.Select(Uri.EscapeDataString))}");
        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
            var strengths = TagStrengthFilters.ToQuery(filters.ExcludeTagStrengths);
            if (!string.IsNullOrEmpty(strengths))
                query.Add($"excludeTagStrengths={Uri.EscapeDataString(strengths)}");
        }
        if (filters.IncludeArtistTags)
            query.Add("includeArtistTags=true");
        return query;
    }

    private async Task AddCatalogAlbumToLibraryAsync(Album album)
    {
        if (album.IsInLibrary || !addingCatalogAlbumIds.Add(album.Id))
            return;

        try
        {
            var response = await Http.PostAsync($"api/library/albums/{Uri.EscapeDataString(album.Id)}", null);
            var result = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<AlbumLibraryChangeResponse>()
                : null;
            if (result?.added != true)
            {
                var sourceArtistId = artistCatalogAlbumsByArtistId.FirstOrDefault(pair => pair.Value.Any(item => item.Id == album.Id)).Key;
                artistCatalogErrors[sourceArtistId ?? string.Empty] = "Nie udało się dodać albumu do biblioteki.";
                return;
            }

            album.IsInLibrary = true;
        }
        finally
        {
            addingCatalogAlbumIds.Remove(album.Id);
        }
    }

