    private async Task SaveToStore()
    {
        var state = new
        {
            sortKey,
            sortOrder,
            groupByArtist,
            selectedTagFilter,
            selectedTagSort,
            localSearch,
            includeTagIds = includeTagIds.ToArray(),
            excludeTagIds = excludeTagIds.ToArray(),
            includeTagStrengths = CaptureTagStrengthRules(includeTagIds),
            excludeTagStrengths = CaptureTagStrengthRules(excludeTagIds),
            includeArtistIds = includeArtistIds.ToArray(),
            excludeArtistIds = excludeArtistIds.ToArray(),
            includeGenres = includeGenres.ToArray(),
            excludeGenres = excludeGenres.ToArray(),
            includeMode,
            excludeMode,
            includeArtistTags,
            showTagFilters,
            showArtistFilters,
            showGenreFilters,
            collapsedArtistGroupIds = collapsedArtistGroupIds.ToArray(),
            expandedArtistCatalogIds = expandedArtistCatalogIds.ToArray(),
            fromYear,
            toYear,
            isRandomSelection,
            randomSourceSearch,
            randomAlbumId,
            localRandomAlbumId
        };

        await Store.SetItemAsync(StoreKey, state);
    }

    private async Task LoadFromStore()
    {
        var state = await Store.GetItemAsync<AlbumsState>(StoreKey);

        if (state == null)
            return;

        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        groupByArtist = state.groupByArtist ?? false;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;

        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : includeTagIds;
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : excludeTagIds;
        tagStrengthFilters = TagStrengthFilters.Restore((state.includeTagStrengths ?? Array.Empty<TagStrengthFilterRule>()).Concat(state.excludeTagStrengths ?? Array.Empty<TagStrengthFilterRule>()), includeTagIds, excludeTagIds);
        includeArtistIds = state.includeArtistIds != null
            ? new HashSet<string>(state.includeArtistIds, StringComparer.Ordinal)
            : string.IsNullOrWhiteSpace(state.selectedArtistId) ? includeArtistIds : new HashSet<string>(new[] { state.selectedArtistId }, StringComparer.Ordinal);
        excludeArtistIds = state.excludeArtistIds != null ? new HashSet<string>(state.excludeArtistIds, StringComparer.Ordinal) : excludeArtistIds;
        includeGenres = state.includeGenres != null ? new HashSet<string>(state.includeGenres, StringComparer.OrdinalIgnoreCase) : includeGenres;
        excludeGenres = state.excludeGenres != null ? new HashSet<string>(state.excludeGenres, StringComparer.OrdinalIgnoreCase) : excludeGenres;
        includeArtistTags = state.includeArtistTags ?? false;
        fromYear = state.fromYear;
        toYear = state.toYear;
        showTagFilters = state.showTagFilters ?? showTagFilters;
        showArtistFilters = state.showArtistFilters ?? showArtistFilters;
        showGenreFilters = state.showGenreFilters ?? showGenreFilters;
        if (state.collapsedArtistGroupIds != null)
            collapsedArtistGroupIds.UnionWith(state.collapsedArtistGroupIds);
        if (state.expandedArtistCatalogIds != null)
            expandedArtistCatalogIds.UnionWith(state.expandedArtistCatalogIds);
        isRandomSelection = state.isRandomSelection ?? false;
        randomSourceSearch = state.randomSourceSearch;
        randomAlbumId = state.randomAlbumId;
        localRandomAlbumId = state.localRandomAlbumId;

    }

