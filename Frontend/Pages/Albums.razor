@page "/albums"
@using Frontend.Components
@inject LocalStorageService Store
@inject BlindModeService BlindMode
@inject ActivePlaybackService ActivePlayback
@inject IJSRuntime JS
@inject HttpClient Http
@inject AiChatDrawerService AiDrawer
@using System.Globalization
@using System.Text.Json
@implements IAsyncDisposable

<PageTitle>Library Manager - Albumy</PageTitle>

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row">
            <button type="button" class="library-controls-toggle" title="Pokaż filtry albumów" aria-label="Pokaż filtry albumów" aria-expanded="false" @onclick="ToggleControlsVisibility">
                <span aria-hidden="true">▼</span>
            </button>
        </div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row">
                <button type="button" class="library-controls-toggle" title="Zwiń filtry albumów" aria-label="Zwiń filtry albumów" aria-expanded="true" @onclick="ToggleControlsVisibility">
                    <span aria-hidden="true">▲</span>
                </button>
            </div>
        }

    <section class="albums-toolbar mb-3" aria-label="Filtry i akcje albumów">
        <div class="albums-toolbar-heading">
            <h4 class="mb-0 albums-results-heading"><span>Albumy</span><span class="library-results-count">@($"{filteredAlbums.Count}/{totalRows} albumów")</span></h4>
            <label class="album-blind-mode-toggle">
                <input type="checkbox" checked="@IsBlindMode" @onchange="ToggleBlindModeAsync" />
                <span>Tryb Blind</span>
            </label>
        </div>

        @if (IsBlindMode)
        {
            <div class="albums-search-group input-group input-group-sm">
                <label class="visually-hidden" for="albums-search-blind">ID wylosowanego albumu</label>
                <input id="albums-search-blind" class="form-control form-control-sm input-dark" type="text" value="@(isRandomSelection ? randomAlbumId ?? string.Empty : string.Empty)" placeholder="ID wylosowanego albumu" readonly aria-label="ID wylosowanego albumu" />
                @if (!string.IsNullOrWhiteSpace(LocalSearch))
                {
                    <button type="button" class="btn btn-outline-light albums-search-clear" title="Wyczyść ukryte wyszukiwanie" aria-label="Wyczyść ukryte wyszukiwanie" @onclick="ClearSearchFilterAsync">×</button>
                }
            </div>
        }
        else
        {
            <div class="albums-search-group input-group input-group-sm">
                <label class="visually-hidden" for="albums-search">Szukaj albumu lub wykonawcy</label>
                @if (!string.IsNullOrWhiteSpace(LocalSearch))
                {
                    <button type="button" class="btn btn-outline-light albums-search-clear" title="Wyczyść wyszukiwanie albumów" aria-label="Wyczyść wyszukiwanie albumów" @onclick="ClearSearchFilterAsync">×</button>
                }
                <input id="albums-search" class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj albumu/wyk. (AND)" @bind="LocalSearch" @bind:event="oninput" />
            </div>
        }

        <div class="albums-filter-fields" aria-label="Ustawienia filtrowania">
            <select class="form-select form-select-sm select-dark" aria-label="Sortuj według" @bind="sortKey" @bind:after="MarkFiltersDirtyAsync">
                <option value="name">Nazwa</option>
                <option value="artist">Wykonawca</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
                <option value="year">Rok</option>
            </select>
            <select class="form-select form-select-sm select-dark" aria-label="Kierunek sortowania" @bind="sortOrder" @bind:after="MarkFiltersDirtyAsync">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>
            @if (string.Equals(sortKey, "artist", StringComparison.OrdinalIgnoreCase))
            {
                <label class="album-artist-grouping-toggle">
                    <input type="checkbox" @bind="groupByArtist" @bind:after="SaveToStore" />
                    <span>Grupuj</span>
                </label>
            }
            <div class="albums-year-fields">
                <label class="visually-hidden" for="albums-year-from">Rok od</label>
                <input id="albums-year-from" type="number" class="form-control form-control-sm input-dark" placeholder="Rok od" @bind="fromYear" @bind:after="MarkFiltersDirtyAsync" />
                <label class="visually-hidden" for="albums-year-to">Rok do</label>
                <input id="albums-year-to" type="number" class="form-control form-control-sm input-dark" placeholder="Rok do" @bind="toYear" @bind:after="MarkFiltersDirtyAsync" />
            </div>
        </div>

        <div class="albums-toolbar-actions" aria-label="Akcje filtrowania">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść wszystkie filtry" aria-label="Resetuj filtry" @onclick="ResetFilters">
                <AppIcon Name="reset" /><span class="album-action-label">Resetuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-apply" title="Zastosuj wybrane filtry" aria-label="Zastosuj filtry" @onclick="ApplyFiltersAsync">
                <AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-label="Tagi: @(showTagFilters ? "ukryj filtry" : "pokaż filtry")" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters">
                <AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry wykonawców" aria-label="Wykonawcy: @(showArtistFilters ? "ukryj filtry" : "pokaż filtry")" aria-expanded="@showArtistFilters" @onclick="ToggleArtistFilters">
                <AppIcon Name="filters" /><span class="album-action-label">Wykonawcy</span><span class="album-action-state" aria-hidden="true">@(showArtistFilters ? "▼" : "▶")</span>
            </button>
            @if (!IsBlindMode)
            {
                <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry gatunków" aria-label="Gatunki: @(showGenreFilters ? "ukryj filtry" : "pokaż filtry")" aria-expanded="@showGenreFilters" @onclick="ToggleGenreFilters">
                    <AppIcon Name="filters" /><span class="album-action-label">Gatunki</span><span class="album-action-state" aria-hidden="true">@(showGenreFilters ? "▼" : "▶")</span>
                </button>
            }
        </div>

        <div class="albums-playback-actions" aria-label="Szybkie akcje wyników">
            <button class="btn btn-sm album-action-button album-action-random" title="Wylosuj album z zastosowanych wyników" aria-label="Wylosuj album z zastosowanych wyników" disabled="@isLoadingAlbums" @onclick="PickRandomAlbumAsync">
                <AppIcon Name="shuffle" /><span class="album-action-label">@(isRandomSelection ? "Losuj ponownie" : "Losuj")</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-random" title="Wylosuj album z aktualnie wczytanych wyników" aria-label="Wylosuj album z aktualnie wczytanych wyników" disabled="@(isLoadingAlbums || filteredAlbums.Count == 0)" @onclick="PickLoadedAlbumAsync">
                <AppIcon Name="shuffle" /><span class="album-action-label">Losuj z wczytanych</span>
            </button>
            @if (isRandomSelection)
            {
                <button class="btn btn-sm album-action-button album-action-muted" title="Wróć do wyników przed losowaniem" aria-label="Wróć do wyników przed losowaniem" disabled="@isLoadingAlbums" @onclick="ReturnToRandomSourceAsync">
                    <AppIcon Name="reset" /><span class="album-action-label">Wróć do wyników</span>
                </button>
            }
            <button class="btn btn-sm album-action-button album-action-play-all" title="@PlayAllAlbumsTitle" aria-label="@PlayAllAlbumsAriaLabel" disabled="@(isQueueingAllAlbums || !CanPlayAllAlbums)" @onclick="PlayAllAlbums">
                <AppIcon Name="play" /><span class="album-action-label">Odtwórz wszystko</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Przejdź do odtwarzanego albumu" aria-label="Przejdź do odtwarzanego albumu" disabled="@(!CanNavigateToPlayingAlbum)" @onclick="NavigateToPlayingAlbumAsync">
                <AppIcon Name="play" /><span class="album-action-label">Odtwarzany</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Przejdź do ostatnio wylosowanego albumu" aria-label="Przejdź do ostatnio wylosowanego albumu" disabled="@(!CanNavigateToLocalRandomAlbum)" @onclick="NavigateToLocalRandomAlbumAsync">
                <AppIcon Name="shuffle" /><span class="album-action-label">Wylosowany</span>
            </button>
        </div>
    </section>

    @if (showTagFilters)
    {
        <section class="albums-tag-filters mb-3" aria-label="Filtry tagów">
            <div class="input-group input-group-sm tag-filter-search">
                <input class="form-control input-dark" type="search" placeholder="Szukaj tagu" aria-label="Szukaj w filtrach tagów" @bind="tagSearch" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(tagSearch))
                {
                    <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie tagów" aria-label="Wyczyść wyszukiwanie tagów" @onclick="ClearTagSearch">×</button>
                }
            </div>
            <label class="tag-visibility-toggle album-artist-tags-toggle"><input type="checkbox" @bind="includeArtistTags" @bind:after="ArtistTagVisibilityChangedAsync" /> <span>Wyświetl i szukaj tagów artystów</span></label>
            @if (showTagsGrouped)
            {
                <div class="tag-groups-container">
                @foreach (var group in GetGroupedTags())
                {
                    <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                        <h6 class="tag-group-heading">@if (group.IsPinnedGroup) { <AppIcon Name="pin" Class="tag-pin-icon" /> }@group.Name</h6>
                        <div class="tag-chips-container">
                        @foreach (var t in group.Tags)
                        {
                            var state = GetTagState(t.Id);
                            var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                            var count = GetTagCount(t.Id);
                            <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@group.IsPinnedGroup" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                        }
                        </div>
                    </section>
                }
                </div>
            }
            else
            {
            <div class="tag-chips-container">
                @foreach (var t in GetVisibleTags())
                {
                    var state = GetTagState(t.Id);
                    var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                    var count = GetTagCount(t.Id);
                    <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@t.IsPinnedShortcut" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                }
            </div>
            }
            <div class="tag-filter-controls">
                <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
                <label class="tag-visibility-toggle"><input type="checkbox" @bind="showUnassignedTags" @bind:after="SaveTagVisibility" /> <span>Pokaż nieprzypisane tagi</span></label>
            </div>
        </section>
    }

    @if (showArtistFilters)
    {
        <section class="albums-tag-filters albums-artist-filters mb-3" aria-label="Filtry wykonawców">
            @if (IsBlindMode)
            {
                <div class="input-group input-group-sm tag-filter-search">
                    <span class="form-control input-dark">Wyszukiwanie wykonawców ukryte</span>
                    @if (!string.IsNullOrWhiteSpace(artistSearch))
                    {
                        <button type="button" class="btn btn-outline-light" title="Wyczyść ukryte wyszukiwanie wykonawców" aria-label="Wyczyść ukryte wyszukiwanie wykonawców" @onclick="ClearArtistSearch">×</button>
                    }
                </div>
            }
            else
            {
                <div class="input-group input-group-sm tag-filter-search">
                    <input class="form-control input-dark" type="search" placeholder="Szukaj wykonawcy" aria-label="Szukaj w filtrach wykonawców" @bind="artistSearch" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(artistSearch))
                    {
                        <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie wykonawców" aria-label="Wyczyść wyszukiwanie wykonawców" @onclick="ClearArtistSearch">×</button>
                    }
                </div>
            }
            <div class="tag-filter-controls">
                <button type="button" class="tag-mode-chip tag-include" @onclick="SelectAllAlbumArtistsAsync"><span>Wszyscy</span></button>
                <button type="button" class="tag-mode-chip tag-none" @onclick="ClearAlbumArtistFiltersAsync"><span>Żadni</span></button>
            </div>
            <div class="album-artist-filter-groups" aria-label="Lista wykonawców">
                @foreach (var group in GetGroupedAlbumArtists())
                {
                    <section class="tag-group" aria-label="Wykonawcy na literę @group.Name">
                        <h6 class="tag-group-heading">@group.Name</h6>
                        <div class="tag-chips-container">
                            @foreach (var artist in group.Artists)
                            {
                                var state = GetArtistFilterState(artist.Id);
                                var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleArtistFilterStateAsync(artist.Id)">
                            <span class="tag-chip-label">@(IsBlindMode ? artist.Id : artist.Name)</span>
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>
        </section>
    }

    @if (showGenreFilters && !IsBlindMode)
    {
        <section class="albums-tag-filters albums-artist-filters mb-3" aria-label="Filtry gatunków">
            <div class="input-group input-group-sm tag-filter-search">
                <input class="form-control input-dark" type="search" placeholder="Szukaj gatunku" aria-label="Szukaj w filtrach gatunków" @bind="genreSearch" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(genreSearch))
                {
                    <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie gatunków" aria-label="Wyczyść wyszukiwanie gatunków" @onclick="ClearGenreSearch">×</button>
                }
            </div>
            <div class="tag-filter-controls">
                <button type="button" class="tag-mode-chip tag-include" @onclick="SelectAllAlbumGenresAsync"><span>Wszystkie</span></button>
                <button type="button" class="tag-mode-chip tag-none" @onclick="ClearAlbumGenreFiltersAsync"><span>Żadne</span></button>
            </div>
            <div class="album-artist-filter-groups" aria-label="Lista gatunków">
                @foreach (var group in GetGroupedAlbumGenres())
                {
                    <section class="tag-group" aria-label="Gatunki na literę @group.Name">
                        <h6 class="tag-group-heading">@group.Name</h6>
                        <div class="tag-chips-container">
                            @foreach (var genre in group.Genres)
                            {
                                var state = GetGenreFilterState(genre);
                                var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                <button type="button" class="tag-chip @css" aria-pressed="@(state != 0)" @onclick="() => CycleGenreFilterStateAsync(genre)">
                                    <span class="tag-chip-label">@genre</span>
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>
        </section>
    }

    <section class="saved-filters-panel mb-3" aria-labelledby="saved-filters-heading">
        <h5 id="saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
        <div class="saved-filters-fields">
            <label class="visually-hidden" for="saved-filter-select">Wybierz zapisany filtr</label>
            <select id="saved-filter-select" class="form-select form-select-sm select-dark" @bind="selectedSavedFilterId">
                <option value="">Wybierz filtr...</option>
                @foreach (var f in savedFilters)
                {
                    <option value="@f.Id.ToString()">@f.Name</option>
                }
            </select>
            <label class="visually-hidden" for="saved-filter-name">Nazwa filtra</label>
            <input id="saved-filter-name" class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
        </div>
        <div class="saved-filters-actions" aria-label="Akcje zapisanych filtrów">
            <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy filtr" aria-label="Zapisz jako nowy filtr" @onclick="SaveCurrentFilter">
                <AppIcon Name="save" /><span class="album-action-label">Zapisz</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Wczytaj wybrany filtr" aria-label="Wczytaj wybrany filtr" @onclick="ApplySelectedFilter">
                <AppIcon Name="load" /><span class="album-action-label">Wczytaj</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę lub nadpisz wybrany filtr" aria-label="Zmień nazwę lub nadpisz wybrany filtr" @onclick="RenameSelectedFilter">
                <AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span>
            </button>
            <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany filtr" aria-label="Usuń wybrany filtr" @onclick="DeleteSelectedFilter">
                <AppIcon Name="delete" /><span class="album-action-label">Usuń</span>
            </button>
        </div>
    </section>
    }
    </div>

    @{
        var activeFilterChips = GetActiveFilterChips();
    }
    @if (activeFilterChips.Count > 0 || FiltersPending)
    {
        <section class="active-library-filters mb-3" aria-label="Aktywne filtry albumów">
            <span class="active-library-filters-label">@(FiltersPending ? "Oczekuje zastosowania:" : "Aktywne filtry:")</span>
            <div class="active-library-filter-chips">
                @foreach (var chip in activeFilterChips)
                {
                    <button type="button" class="@chip.CssClass" title="Usuń filtr: @chip.Label" aria-label="Usuń filtr: @chip.Label" @onclick="chip.ClearAsync">
                        <span>@chip.Label</span><span class="active-library-filter-chip-remove" aria-hidden="true">×</span>
                    </button>
                }
            </div>
            @if (FiltersPending)
            {
                <button type="button" class="btn btn-sm album-action-button album-action-apply active-library-filters-apply" @onclick="ApplyFiltersAsync">
                    <AppIcon Name="apply" /><span>Filtruj</span>
                </button>
            }
        </section>
    }

    @if (filteredAlbums.Count == 0)
    {
        <section class="library-empty-results" role="status">
            <p>Żaden album nie spełnia zastosowanych filtrów.</p>
            <button type="button" class="btn btn-sm album-action-button album-action-muted" @onclick="ResetAndApplyFiltersAsync"><AppIcon Name="reset" /><span>Resetuj filtry</span></button>
        </section>
    }

    @{
        var artistAlbumGroups = IsArtistGroupingEnabled ? GetArtistAlbumGroups() : new List<ArtistAlbumGroup>();
    }

    @if (IsArtistGroupingEnabled)
    {
        <div class="album-artist-groups">
        @foreach (var group in artistAlbumGroups)
        {
            <section class="album-artist-group" data-artist-group-id="@group.Id" aria-label="@(IsBlindMode ? $"Albumy wykonawcy {group.Id}" : $"Albumy wykonawcy {group.Name}")">
                <header class="album-artist-group-heading">
                    <button type="button" class="album-artist-group-toggle" aria-expanded="@(!IsArtistGroupCollapsed(group.Id))" @onclick="() => ToggleArtistGroupAsync(group.Id)">
                        <span aria-hidden="true">@(IsArtistGroupCollapsed(group.Id) ? "▶" : "▼")</span>
                        <span class="album-artist-group-name">@(IsBlindMode ? group.Id : group.Name)</span>
                        <span class="library-results-count">@group.Albums.Count</span>
                    </button>
                    <div class="album-artist-group-meta">
                        @if (!IsBlindMode)
                        {
                            @foreach (var genre in group.Genres)
                            {
                                <span class="badge bg-outline-light text-light album-artist-genre">@genre</span>
                            }
                        }
                        @foreach (var tag in group.Tags)
                        {
                            <span class="badge badge-tag album-artist-tag">@tag.TagName (@tag.Strength)</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(group.Note))
                    {
                        <p class="item-note-preview album-artist-group-note" title="@group.Note">@group.Note</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(group.Id))
                    {
                        <button type="button" class="btn btn-sm album-card-tag" title="Taguj artystę" aria-label="Taguj artystę: @(IsBlindMode ? group.Id : group.Name)" @onclick="() => OpenArtistTagging(group.Id)"><AppIcon Name="tag" /><span>Taguj</span></button>
                        <button type="button" class="btn btn-sm album-card-tag" title="Edytuj prywatną notatkę artysty" aria-label="Edytuj notatkę artysty: @(IsBlindMode ? group.Id : group.Name)" @onclick="() => OpenArtistNote(group)"><AppIcon Name="edit" /><span>Notatka</span></button>
                        <button type="button" class="btn btn-sm album-card-tag" title="Pokaż podobnych wykonawców" aria-label="Pokaż podobnych wykonawców: @(IsBlindMode ? group.Id : group.Name)" @onclick="() => OpenRelatedArtistsAsync(group)"><AppIcon Name="filters" /><span>Podobni</span></button>
                        <button type="button" class="btn btn-sm album-card-tag album-artist-catalog-toggle"
                                title="@(IsArtistCatalogExpanded(group.Id) ? "Pokaż tylko przefiltrowane albumy" : "Pobierz wszystkie albumy wykonawcy")"
                                aria-label="@(IsArtistCatalogExpanded(group.Id) ? "Pokaż tylko przefiltrowane albumy wykonawcy" : "Pobierz wszystkie albumy wykonawcy")"
                                aria-pressed="@IsArtistCatalogExpanded(group.Id)"
                                disabled="@isLoadingArtistCatalogIds.Contains(group.Id)"
                                @onclick="() => ToggleArtistCatalogAsync(group.Id)">
                            @if (isLoadingArtistCatalogIds.Contains(group.Id))
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Wczytywanie</span>
                            }
                            else
                            {
                                <span>@(IsArtistCatalogExpanded(group.Id) ? "Wszystkie" : "Przefiltrowane")</span><strong aria-hidden="true">@(IsArtistCatalogExpanded(group.Id) ? "▲" : "▼")</strong>
                            }
                        </button>
                        @if (aiAvailable)
                        {
                            <AiContextMenu Items="GetArtistAiMenuItems(group.Id, group.Name, IsBlindMode)"
                                           AriaLabel="Więcej opcji dla wykonawcy" />
                        }
                    }
                </header>
                @if (!IsArtistGroupCollapsed(group.Id))
                {
                    @if (artistCatalogErrors.TryGetValue(group.Id, out var catalogError))
                    {
                        <p class="text-danger small mb-2" role="status">@catalogError</p>
                    }
                    <div class="library-card-grid">
                        @foreach (var album in group.Albums)
                        {
                            @RenderAlbumCard(album, IsArtistCatalogExpanded(group.Id) && filteredAlbums.Any(item => item.Id == album.Id))
                        }
                    </div>
                }
            </section>
        }
        </div>
    }

    else
    {
        <div class="library-card-grid">
            @foreach (var album in filteredAlbums)
            {
                @RenderAlbumCard(album)
            }
        </div>
    }

    @if (isLoadingAlbums && filteredAlbums.Count > 0)
    {
        <div class="album-infinite-scroll-status" role="status"><span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Wczytywanie kolejnych albumów...</span></div>
    }
    <div class="album-infinite-scroll-sentinel" @ref="albumsSentinel" aria-hidden="true"></div>
</div>

@if (artistAlbumGroups.Count > 1)
{
    <nav class="album-artist-navigation" aria-label="Nawigacja między wykonawcami">
        <button type="button" class="album-artist-navigation-button" title="Poprzedni wykonawca" aria-label="Poprzedni wykonawca"
                disabled="@(!canNavigateToPreviousArtist)" @onclick="() => NavigateArtistGroupAsync(-1)">
            <span aria-hidden="true">↑</span>
        </button>
        <button type="button" class="album-artist-navigation-button" title="Następny wykonawca" aria-label="Następny wykonawca"
                disabled="@(!canNavigateToNextArtist)" @onclick="() => NavigateArtistGroupAsync(1)">
            <span aria-hidden="true">↓</span>
        </button>
    </nav>
}

