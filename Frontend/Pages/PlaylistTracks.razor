@page "/playlists/{PlaylistId}"
@using Frontend.Components
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject LocalStorageService Store
@inject HttpClient Http
@inject PlaybackService Playback
@inject AiChatDrawerService AiDrawer
@implements IAsyncDisposable

<PageTitle>Library Manager - Playlista</PageTitle>

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row"><button type="button" class="library-controls-toggle" title="Pokaż filtry playlisty" aria-label="Pokaż filtry playlisty" aria-expanded="false" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▼</span></button></div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row"><button type="button" class="library-controls-toggle" title="Zwiń filtry playlisty" aria-label="Zwiń filtry playlisty" aria-expanded="true" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▲</span></button></div>
        }

    <section class="library-toolbar library-toolbar--simple" aria-label="Filtry i akcje playlisty">
        <div class="library-toolbar-heading"><h4 class="mb-0">Utwory playlisty: @playlistName <span class="library-results-count">@GetResultCountText(filteredTracks.Count, "utwór", "utwory", "utworów")</span></h4></div>
        <div class="library-search-group"><input class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj (AND)" @bind="LocalSearch" @bind:event="oninput" /></div>
        <div class="library-toolbar-actions">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść filtry" @onclick="ResetFilters"><AppIcon Name="reset" /><span class="album-action-label">Resetuj</span></button>
            <button class="btn btn-sm album-action-button album-action-apply @(pendingTags.Any ? "library-apply-pending" : null)" disabled="@isApplyingFilters" title="Zastosuj filtry" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span></button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters"><AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span></button>
        </div>
        <div class="library-playback-actions"><button class="btn btn-sm album-action-button album-action-play-all" title="Odtwórz bieżące wyniki" @onclick="PlayFiltered"><AppIcon Name="play" /><span class="album-action-label">Odtwórz</span></button></div>
    </section>

    <section class="saved-filters-panel" aria-labelledby="playlist-saved-filters-heading">
        <h5 id="playlist-saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
        <div class="saved-filters-fields">
        <select class="form-select form-select-sm w-auto select-dark" @bind="selectedSavedFilterId">
            <option value="">Wybierz filtr...</option>
            @foreach (var f in savedFilters)
            {
                <option value="@f.Id.ToString()">@f.Name</option>
            }
        </select>
        <input class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
        </div>
        <div class="saved-filters-actions">
        <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy" @onclick="SaveCurrentFilter"><AppIcon Name="save" /><span class="album-action-label">Zapisz</span></button>
        <button class="btn btn-sm album-action-button album-action-muted" title="Zastosuj wybrany" @onclick="ApplySelectedFilter"><AppIcon Name="load" /><span class="album-action-label">Wczytaj</span></button>
        <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę / nadpisz" @onclick="RenameSelectedFilter"><AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span></button>
        <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany" @onclick="DeleteSelectedFilter"><AppIcon Name="delete" /><span class="album-action-label">Usuń</span></button>
        </div>
    </section>

    @if (showTagFilters)
    {
        <section class="library-tag-filters" aria-label="Filtry tagów">
            <div class="input-group input-group-sm tag-filter-search">
                <input class="form-control input-dark" type="search" placeholder="Szukaj tagu" aria-label="Szukaj w filtrach tagów" @bind="tagSearch" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(tagSearch))
                {
                    <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie tagów" aria-label="Wyczyść wyszukiwanie tagów" @onclick="ClearTagSearch">×</button>
                }
            </div>
            <div class="d-flex flex-column gap-1 flex-fill">
                @if (showTagsGrouped)
                {
                    <div class="tag-groups-container mt-2">
                    @foreach (var group in GetGroupedTags())
                    {
                        <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                            <h6 class="tag-group-heading">@if (group.IsPinnedGroup) { <AppIcon Name="pin" Class="tag-pin-icon" /> }@group.Name</h6>
                            <div class="tag-chips-container">
                            @foreach (var t in group.Tags)
                            {
                                var state = GetTagState(t.Id);
                                var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                var count = GetTagCount(t.Id);
                                <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@group.IsPinnedGroup" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                            }
                            </div>
                        </section>
                    }
                    </div>
                }
                else
                {
                <div class="tag-chips-container mt-2">
                @foreach (var t in GetVisibleTags())
                    {
                        var state = GetTagState(t.Id);
                        var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                        var count = GetTagCount(t.Id);
                        <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@t.IsPinnedShortcut" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                    }
                </div>
                }
                <div class="tag-filter-controls">
                    <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                    <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
                <label class="tag-visibility-toggle"><input type="checkbox" @bind="showUnassignedTags" @bind:after="SaveTagVisibility" /> <span>Pokaż nieprzypisane tagi</span></label>
                </div>
            </div>
        </section>
    }
    }
    </div>

    @{
        var activeFilterChips = GetActiveFilterChips();
    }
    @if (activeFilterChips.Count > 0 || FiltersPending || pendingTags.Any)
    {
        <section class="active-library-filters mb-3" aria-label="Aktywne filtry playlisty">
            <span class="active-library-filters-label">@(FiltersPending ? "Oczekuje zastosowania:" : pendingTags.Any ? "Wyniki po zmianie tagów" : "Aktywne filtry:")</span>
            <div class="active-library-filter-chips">
                @foreach (var chip in activeFilterChips)
                {
                    <button type="button" class="@chip.CssClass" title="Usuń filtr: @chip.Label" @onclick="chip.ClearAsync"><span>@chip.Label</span><span class="active-library-filter-chip-remove" aria-hidden="true">×</span></button>
                }
            </div>
            @if (FiltersPending || pendingTags.Any)
            {
                <button type="button" class="btn btn-sm album-action-button album-action-apply active-library-filters-apply" disabled="@isApplyingFilters" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span>@(pendingTags.Any ? "Zastosuj" : "Filtruj")</span></button>
            }
        </section>
    }

    @if (refreshMessage is not null)
    {
        <p class="library-refresh-message" role="status">@refreshMessage</p>
    }

    @if (tracks.Count > 0 && filteredTracks.Count == 0)
    {
        <section class="library-empty-results" role="status">
            <p>Żaden utwór z tej playlisty nie spełnia zastosowanych filtrów.</p>
            <button type="button" class="btn btn-sm album-action-button album-action-muted" @onclick="ResetAndApplyFiltersAsync"><AppIcon Name="reset" /><span>Resetuj filtry</span></button>
        </section>
    }

    <div class="table-responsive" style="max-height: calc(100vh - 240px); overflow-y: auto; position: relative;">
        <table class="table table-dark table-striped align-middle">
            <thead>
                <tr>
                    <th style="width:72px; position:sticky; top:0; background-color:#0b0b0f; z-index:1;"></th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer;" @onclick="OnSortByName">Nazwa @GetSortArrow("name")</th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer;" @onclick="OnSortByArtists">Wykonawcy @GetSortArrow("artists")</th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer;" @onclick="OnSortByAlbum">Album @GetSortArrow("album")</th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1; cursor:pointer;" @onclick="OnSortByYear">Rok @GetSortArrow("year")</th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1;">Tagi</th>
                    <th style="position:sticky; top:0; background-color:#0b0b0f; z-index:1;">Tagowanie</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in filteredTracks)
                {
                    <tr>
                        <td>
                            <div class="cover-container">
                                <img class="cover-img-56" src="@(t.AlbumImage64 ?? GetBestImageUrl(t.Images) ?? string.Empty)" alt="okładka" />
                                <button class="cover-overlay" title="Odtwórz" @onclick="() => PlayTrack(t.Uri)">▶</button>
                            </div>
                        </td>
                        <td><span class="d-inline-flex align-items-center gap-2">@t.Name <AiContextMenu Items="@(aiAvailable ? GetTrackAiMenuItems(t) : Array.Empty<AiContextMenuItem>())" AriaLabel="Więcej opcji dla utworu" ItemType="track" SpotifyItemId="@t.Id" DisplayName="@t.Name" Tags="@t.Tags" IsInLibrary="true" OnTagsChanged="ApplyTaggedPlaylistTrackState" /></span></td>
                        <td>
                            @foreach (var a in t.Artists)
                            {
                                <a class="badge bg-outline-light text-light text-decoration-none me-1" style="font-size: 0.7rem;" href="/artist/@a.Id">@a.Name</a>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(t.AlbumId))
                            {
                                <a href="/album/@t.AlbumId" class="link-light text-decoration-none">@t.AlbumName</a>
                            }
                            else
                            {
                                @t.AlbumName
                            }
                        </td>
                        <td>@(t.ReleaseYear?.ToString() ?? "—")</td>
                        <td>
                            @if (pendingTags.Contains("track", t.Id))
                            {
                                <span class="badge library-tags-changed me-1">Zmieniono tagi</span>
                            }
                            <TagPreview Tags="@(t.Tags ?? new())" BadgeClass="badge bg-primary" OverflowClass="badge bg-outline-primary text-primary" />
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-light" @onclick="() => OpenTrackTagging(t.Id)">Taguj</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (showTrackTagging && taggingTrackId != null)
    {
        <TaggingPanel Title="Tagowanie utworu"
                                 ItemType="track"
                                 SpotifyItemId="@taggingTrackId"
                                 Items="trackTagItems"
                                 Tags="@(tracks.FirstOrDefault(x => x.Id == taggingTrackId)?.Tags ?? new())"
                                 Placeholder="Taguj utwór..."
                                 OnChanged="ApplyTaggedPlaylistTrackState"
                                 OnClose="CloseTrackTagging" />
    }
</div>

@code {
    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;
    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string Scope { get; set; } = string.Empty; public string? ContextId { get; set; } public string PayloadJson { get; set; } = string.Empty; }

    [Parameter] public string PlaylistId { get; set; } = string.Empty;
    private string? lastPlaylistId;
    private string? playlistName;
    private ElementReference controlsSentinel;
    private DotNetObjectReference<PlaylistTracks>? controlsObserverRef;
    private bool controlsPastAnchor;
    private bool controlsManuallyCollapsed;
    private bool ControlsCollapsed => controlsPastAnchor && controlsManuallyCollapsed;

    private List<Track> tracks = new();
    private List<Track> filteredTracks = new();
    private List<TagDto> availableTags = new();
    private List<TagGroupDto> tagGroups = new();
    private List<TagItem> trackTagItems = new();
    private Dictionary<string, long?> selectedTagByTrack = new();
    private string? localSearch;
    private string? LocalSearch
    {
        get => localSearch;
        set
        {
            if (localSearch == value)
                return;

            localSearch = value;
        }
    }

    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private Dictionary<long, TagStrengthFilterState> tagStrengthFilters = new();
    private string includeMode = "or";
    private string excludeMode = "or";

    private string clientSortColumn = "name";
    private bool clientSortAsc = true;
    private bool showTagFilters = true;
    private bool showTagsGrouped;
    private const string TagFiltersStoreKey = "filters:playlist:show-tag-filters";
    private const string TagLayoutStoreKey = "tag-layout:grouped";
    private const string TagVisibilityStoreKey = "tag-visibility:show-unassigned";
    private bool showUnassignedTags;
    private string? tagSearch;
    private Dictionary<long, int> tagCounts = new();
    private bool aiAvailable;
    private PlaylistFilterSnapshot? appliedFilters;
    private bool FiltersPending => appliedFilters is null || !CaptureCurrentFilters().Matches(appliedFilters);

    protected override async Task OnInitializedAsync()
    {
        AiDrawer.Changed += HandleAiAccessChanged;
        aiAvailable = AiDrawer.AccessLoaded && AiDrawer.IsAllowed;
        await LoadTagFiltersVisibility();
        await LoadTagLayout();
        await LoadTagVisibility();
        await LoadAvailableTags();
        appliedFilters = CaptureCurrentFilters();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(lastPlaylistId, PlaylistId, StringComparison.Ordinal))
        {
            lastPlaylistId = PlaylistId;
            var version = ++playlistVersion;
            isApplyingFilters = true;
            refreshMessage = null;
            pendingTags.Clear();
            CloseTrackTagging();
            tracks = new();
            filteredTracks = new();
            tagCounts = new();
            try
            {
                await LoadTracks();
            }
            finally
            {
                if (version == playlistVersion)
                    isApplyingFilters = false;
            }
            await LoadPlaylistName();
            await LoadSavedFilters();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            controlsObserverRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("tagSync.register", controlsObserverRef, nameof(OnTagsEvent));
            await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, controlsObserverRef);
        }
        catch { }
    }

    private PlaylistFilterSnapshot CaptureCurrentFilters() => new(localSearch, includeMode, excludeMode, includeTagIds.OrderBy(id => id).ToArray(), excludeTagIds.OrderBy(id => id).ToArray(), TagStrengthFilters.Capture(includeTagIds, tagStrengthFilters), TagStrengthFilters.Capture(excludeTagIds, tagStrengthFilters), clientSortColumn, clientSortAsc);

    private async Task ApplyFiltersAsync()
    {
        if (isApplyingFilters)
            return;

        var filters = CaptureCurrentFilters();
        var revision = pendingTags.Revision;
        var version = playlistVersion;
        isApplyingFilters = true;
        refreshMessage = null;
        try
        {
            var counts = await FetchPlaylistTagCounts(PlaylistId, filters);
            if (version != playlistVersion)
                return;

            if (counts is null || revision != pendingTags.Revision)
            {
                refreshMessage = PendingTagChanges.RefreshFailed;
                return;
            }

            appliedFilters = filters;
            ApplyLocalFilter(filters);
            ApplyClientSort(filters);
            if (taggingTrackId is not null && !filteredTracks.Any(track => track.Id == taggingTrackId))
                CloseTrackTagging();
            tagCounts = counts;
            pendingTags.Clear();
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (version == playlistVersion)
                refreshMessage = PendingTagChanges.RefreshFailed;
        }
        finally
        {
            if (version == playlistVersion)
                isApplyingFilters = false;
        }
    }

    private Task ResetFilters()
    {
        localSearch = null;
        includeTagIds.Clear();
        excludeTagIds.Clear();
        tagStrengthFilters.Clear();
        includeMode = "or";
        excludeMode = "or";
        clientSortColumn = "name";
        clientSortAsc = true;
        return Task.CompletedTask;
    }

    private async Task ResetAndApplyFiltersAsync()
    {
        await ResetFilters();
        await ApplyFiltersAsync();
    }

    private static string GetResultCountText(int count, string singular, string few, string many)
    {
        var mod10 = count % 10;
        var mod100 = count % 100;
        var noun = count == 1 ? singular : mod10 is >= 2 and <= 4 && (mod100 < 12 || mod100 > 14) ? few : many;
        return $"{count} {noun}";
    }

    [JSInvokable]
    public Task SetControlsPastAnchor(bool isPastAnchor)
    {
        if (controlsPastAnchor == isPastAnchor)
            return Task.CompletedTask;

        controlsPastAnchor = isPastAnchor;
        if (!controlsPastAnchor)
            controlsManuallyCollapsed = false;

        return InvokeAsync(StateHasChanged);
    }

    private void ToggleControlsVisibility() => controlsManuallyCollapsed = !ControlsCollapsed;

    public async ValueTask DisposeAsync()
    {
        AiDrawer.Changed -= HandleAiAccessChanged;
        try { await JS.InvokeVoidAsync("tagSync.unregister", controlsObserverRef); } catch (JSDisconnectedException) { }
        try { await JS.InvokeVoidAsync("libraryControls.disconnect"); } catch (JSDisconnectedException) { }
        controlsObserverRef?.Dispose();
    }

    private void HandleAiAccessChanged()
    {
        var available = AiDrawer.AccessLoaded && AiDrawer.IsAllowed;
        if (aiAvailable == available) return;
        aiAvailable = available;
        _ = InvokeAsync(StateHasChanged);
    }

    private static IReadOnlyList<AiContextMenuItem> GetTrackAiMenuItems(Track track)
    {
        var items = new List<AiContextMenuItem>();
        if (!string.IsNullOrWhiteSpace(track.Id))
        {
            items.Add(new AiContextMenuItem("Zapytaj AI o utwór", new AiChatContext
            {
                ItemType = "track",
                SpotifyItemId = track.Id,
                DisplayName = track.Name
            }));
        }

        items.AddRange((track.Artists ?? new List<SimpleArtist>())
            .Where(artist => !string.IsNullOrWhiteSpace(artist.Id))
            .Select(artist => new AiContextMenuItem($"Zapytaj AI o: {artist.Name}", new AiChatContext
            {
                ItemType = "artist",
                SpotifyItemId = artist.Id,
                DisplayName = artist.Name
            })));

        if (!string.IsNullOrWhiteSpace(track.AlbumId))
        {
            items.Add(new AiContextMenuItem("Zapytaj AI o album", new AiChatContext
            {
                ItemType = "album",
                SpotifyItemId = track.AlbumId,
                DisplayName = track.AlbumName ?? string.Empty
            }));
        }

        return items;
    }

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync($"api/library/filters?scope=playlist&contextId={Uri.EscapeDataString(PlaylistId)}");
        if (!res.IsSuccessStatusCode) return;
        savedFilters = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
    }

    private async Task LoadAvailableTags()
    {
        var tagsRequest = Http.GetAsync("api/tags");
        var groupsRequest = Http.GetAsync("api/tags-group");
        await Task.WhenAll(tagsRequest, groupsRequest);
        var res = await tagsRequest;
        if (!res.IsSuccessStatusCode)
            return;

        var allTags = await res.Content.ReadFromJsonAsync<List<TagDto>>() ?? new List<TagDto>();
        var groupsResponse = await groupsRequest;
        tagGroups = groupsResponse.IsSuccessStatusCode
            ? await groupsResponse.Content.ReadFromJsonAsync<List<TagGroupDto>>() ?? new List<TagGroupDto>()
            : new List<TagGroupDto>();
        availableTags = allTags.Where(t => t.ForTrack).OrderBy(t => t.Name).ToList();
        trackTagItems = availableTags.Select(t => new TagItem { Id = t.Id, Name = t.Name, Aliases = t.Aliases, TagGroupId = t.TagGroupId, IsPinned = t.IsPinned }).ToList();
    }

    private async Task LoadTracks()
    {
        var playlistId = PlaylistId;
        var version = playlistVersion;
        var filters = appliedFilters ?? CaptureCurrentFilters();
        var res = await Http.GetAsync($"api/library/playlists/{Uri.EscapeDataString(playlistId)}/tracks?page=1&pageSize=500");
        if (!res.IsSuccessStatusCode)
            return;

        var payload = await res.Content.ReadFromJsonAsync<TracksResponse>();
        if (version != playlistVersion)
            return;

        tracks = payload?.items ?? new List<Track>();
        ApplyLocalFilter(filters);
        ApplyClientSort(filters);
        var counts = await FetchPlaylistTagCounts(playlistId, filters);
        if (version == playlistVersion && !pendingTags.Any && counts is not null)
            tagCounts = counts;
    }

    private async Task LoadPlaylistName()
    {
        var res = await Http.GetAsync("api/library/playlists?page=1&pageSize=500");

        if (!res.IsSuccessStatusCode)
            return;

        var data = await res.Content.ReadFromJsonAsync<PlaylistsListResponse>();
        playlistName = data?.items?.FirstOrDefault(p => p.Id == PlaylistId)?.Name ?? string.Empty;
    }

    [JSInvokable]
    public Task OnTagsEvent(string itemType, string spotifyItemId, List<TagBadge> tags) =>
        ApplyTaggedPlaylistTrackState(new TagAssignmentState { ItemType = itemType, SpotifyItemId = spotifyItemId, Tags = tags });

    private void ApplyLocalFilter(PlaylistFilterSnapshot? requestedFilters = null)
    {
        var filters = requestedFilters ?? appliedFilters ?? CaptureCurrentFilters();
        var source = tracks;

        // search AND
        if (!string.IsNullOrWhiteSpace(filters.LocalSearch))
        {
            var terms = filters.LocalSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => t.ToLowerInvariant()).ToList();

            source = source.Where(tr =>
            {
                var parts = new List<string>();
                parts.Add(tr.Name ?? string.Empty);
                parts.Add(tr.AlbumName ?? string.Empty);
                parts.Add(string.Join(' ', tr.Artists?.Select(a => a.Name) ?? new List<string>()));

                if (tr.Tags != null && tr.Tags.Count > 0)
                    parts.Add(string.Join(' ', tr.Tags.Select(t => t.TagName)));

                var hay = string.Join(' ', parts).ToLowerInvariant();

                foreach (var term in terms)
                {
                    if (!hay.Contains(term))
                        return false;
                }

                return true;
            }).ToList();
        }

        bool MatchesTag(TagBadge tag, long tagId, IReadOnlyDictionary<long, TagStrengthFilterRule> rules)
        {
            if (tag.TagId != tagId)
                return false;

            return rules.GetValueOrDefault(tagId)?.Operator switch
            {
                "gte" => tag.Strength >= rules[tagId].Value,
                "lte" => tag.Strength <= rules[tagId].Value,
                _ => true
            };
        }

        // include/exclude by tag ids and optional strengths
        if (filters.IncludeTagIds.Length > 0)
        {
            var list = filters.IncludeTagIds.ToList();
            var andMode = string.Equals(filters.IncludeMode, "and", StringComparison.OrdinalIgnoreCase);
            var rules = filters.IncludeTagStrengths.ToDictionary(rule => rule.TagId);

            if (andMode)
            {
                foreach (var tid in list)
                {
                    var idLocal = tid;
                    source = source.Where(t => t.Tags?.Any(x => MatchesTag(x, idLocal, rules)) ?? false).ToList();
                }
            }
            else
            {
                source = source.Where(t => t.Tags?.Any(x => list.Any(id => MatchesTag(x, id, rules))) ?? false).ToList();
            }
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            var list = filters.ExcludeTagIds.ToList();
            var andMode = string.Equals(filters.ExcludeMode, "and", StringComparison.OrdinalIgnoreCase);
            var rules = filters.ExcludeTagStrengths.ToDictionary(rule => rule.TagId);

            if (andMode)
                source = source.Where(t => !list.All(tid => t.Tags?.Any(x => MatchesTag(x, tid, rules)) ?? false)).ToList();
            else
                source = source.Where(t => !(t.Tags?.Any(x => list.Any(id => MatchesTag(x, id, rules))) ?? false)).ToList();
        }

        filteredTracks = source.ToList();
    }

    private void OnSortByName() => OnClientSort("name");
    private void OnSortByArtists() => OnClientSort("artists");
    private void OnSortByAlbum() => OnClientSort("album");
    private void OnSortByYear() => OnClientSort("year");

    private void OnClientSort(string column)
    {
        if (clientSortColumn == column)
        {
            clientSortAsc = !clientSortAsc;

            return;
        }

        clientSortColumn = column;
        clientSortAsc = true;

    }

    private void ApplyClientSort(PlaylistFilterSnapshot? requestedFilters = null)
    {
        var filters = requestedFilters ?? appliedFilters ?? CaptureCurrentFilters();
        if (filteredTracks == null || filteredTracks.Count == 0)
            return;

        string ArtistsKey(Track t) => string.Join(' ', t.Artists?.Select(a => a.Name) ?? new List<string>()).ToLowerInvariant();
        string AlbumKey(Track t) => (t.AlbumName ?? string.Empty).ToLowerInvariant();
        string NameKey(Track t) => (t.Name ?? string.Empty).ToLowerInvariant();
        int YearKey(Track t) => t.ReleaseYear ?? -1;
        IOrderedEnumerable<Track> ordered;
        if (filters.SortColumn == "artists")
        {
            ordered = filters.SortAsc
                ? filteredTracks.OrderBy(ArtistsKey)
                : filteredTracks.OrderByDescending(ArtistsKey);

            filteredTracks = ordered
                .ThenBy(AlbumKey)
                .ThenBy(t => t.TrackNumber)
                .ThenBy(NameKey)
                .ThenBy(YearKey)
                .ToList();
            return;
        }

        if (filters.SortColumn == "year")
        {
            ordered = filters.SortAsc
                ? filteredTracks.OrderBy(YearKey)
                : filteredTracks.OrderByDescending(YearKey);

            filteredTracks = ordered
                .ThenBy(AlbumKey)
                .ThenBy(t => t.TrackNumber)
                .ThenBy(NameKey)
                .ToList();
            
            return;
        }

        if (filters.SortColumn == "album")
        {
            ordered = filters.SortAsc
                ? filteredTracks.OrderBy(AlbumKey)
                : filteredTracks.OrderByDescending(AlbumKey);

            filteredTracks = ordered
                .ThenBy(t => t.TrackNumber)
                .ThenBy(NameKey)
                .ThenBy(YearKey)
                .ToList();
            
            return;
        }

        // default: name
        ordered = filters.SortAsc
            ? filteredTracks.OrderBy(NameKey)
            : filteredTracks.OrderByDescending(NameKey);

        filteredTracks = ordered
            .ThenBy(t => t.TrackNumber)
            .ThenBy(AlbumKey)
            .ThenBy(YearKey)
            .ToList();
    }

    private string GetSortArrow(string column)
    {
        if (clientSortColumn != column)
            return string.Empty;

        return clientSortAsc ? " ↑" : " ↓";
    }

    private Dictionary<string, float?> hoverByKey = new();
    private RenderFragment StarRating(string key, float value, Func<float, Task> onChange) => builder =>
    {
        int seq = 0;
        var display = hoverByKey.TryGetValue(key, out var h) && h.HasValue ? h.Value : value;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "style", "display:inline-flex; align-items:center;");
        builder.AddAttribute(seq++, "title", $"{display:0.0}");
        for (int i = 1; i <= 6; i++)
        {
            var star = i;
            var fill = display >= star ? 1.0f : (display >= star - 0.5f ? 0.5f : 0f);

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "position:relative; display:inline-block; width:1.4rem; height:1.4rem; line-height:1.4rem; font-size:1.4rem; margin-right:4px;");
            builder.AddAttribute(seq++, "onmouseleave", EventCallback.Factory.Create(this, () => { if (hoverByKey.ContainsKey(key)) hoverByKey.Remove(key); }));

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-secondary");
            builder.AddAttribute(seq++, "style", "position:absolute; inset:0; pointer-events:none;");
            builder.AddContent(seq++, "☆");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-warning");
            var width = fill >= 1.0f ? "100%" : (fill >= 0.5f ? "50%" : "0%");
            builder.AddAttribute(seq++, "style", $"position:absolute; inset:0; width:{width}; overflow:hidden; white-space:nowrap; pointer-events:none;");
            builder.AddContent(seq++, "★");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; left:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star - 0.5f; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star - 0.5f)));
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; right:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star)));
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private async Task SetTrackTagStrength(string trackId, long tagId, float strength)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "track", SpotifyItemId = trackId, Strength = strength };

        var res = await Http.PutAsJsonAsync("api/tags/assign", model);

        if (!res.IsSuccessStatusCode)
        {
            var resCreate = await Http.PostAsJsonAsync("api/tags/assign", model);

            if (!resCreate.IsSuccessStatusCode)
                return;
        }

        await RefreshPlaylistTrackTags(trackId);
    }

    private async Task RemoveTrackTag(string trackId, long tagId)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "track", SpotifyItemId = trackId, Strength = 0 };
        var req = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "api/tags/assign")
        {
            Content = JsonContent.Create(model)
        });

        if (!req.IsSuccessStatusCode)
            return;

        await RefreshPlaylistTrackTags(trackId);
    }

    private async Task RefreshPlaylistTrackTags(string trackId)
    {
        var response = await Http.GetAsync($"api/tags/assign/track/{Uri.EscapeDataString(trackId)}");
        if (!response.IsSuccessStatusCode)
            return;

        var tags = await response.Content.ReadFromJsonAsync<List<TagBadge>>() ?? new List<TagBadge>();
        await ApplyTaggedPlaylistTrackState(new TagAssignmentState { ItemType = "track", SpotifyItemId = trackId, Tags = tags });
    }

    private Task ApplyTaggedPlaylistTrackState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "track", StringComparison.OrdinalIgnoreCase))
            return Task.CompletedTask;

        var changed = false;
        foreach (var track in tracks.Where(track => track.Id == state.SpotifyItemId))
        {
            if (PendingTagChanges.SameTags(track.Tags, state.Tags))
                continue;

            track.Tags = state.Tags;
            changed = true;
        }

        if (!changed)
            return Task.CompletedTask;

        pendingTags.Record("track", state.SpotifyItemId, state.Tags);
        return InvokeAsync(StateHasChanged);
    }

