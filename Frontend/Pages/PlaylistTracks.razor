    private IEnumerable<TagDto> GetVisibleTags() => showUnassignedTags
        ? availableTags
        : availableTags.Where(tag => GetTagCount(tag.Id) > 0 || includeTagIds.Contains(tag.Id) || excludeTagIds.Contains(tag.Id));

    private IEnumerable<TagGroupView> GetGroupedTags()
    {
        var groupedTagIds = tagGroups.Select(group => group.Id).ToHashSet();
        var visibleTags = GetVisibleTags().ToList();
        var groups = tagGroups.OrderBy(group => group.Name).Select(group => new TagGroupView { Name = group.Name, Tags = visibleTags.Where(tag => tag.TagGroupId == group.Id).OrderBy(tag => tag.Name).ToList() }).Where(group => group.Tags.Count > 0).ToList();
        var ungroupedTags = visibleTags.Where(tag => !groupedTagIds.Contains(tag.TagGroupId)).OrderBy(tag => tag.Name).ToList();
        if (ungroupedTags.Count > 0)
            groups.Add(new TagGroupView { Name = "Pozostałe tagi", Tags = ungroupedTags });
        return groups;
    }

    private sealed class PlaylistState
    {
        public string? localSearch { get; set; }
        public string? includeMode { get; set; }
        public string? excludeMode { get; set; }
        public long[]? includeTagIds { get; set; }
        public long[]? excludeTagIds { get; set; }
        public string? clientSortColumn { get; set; }
        public bool? clientSortAsc { get; set; }
        public bool? showTagFilters { get; set; }
    }

    private PlaylistState BuildCurrentState() => new PlaylistState
    {
        localSearch = localSearch,
        includeMode = includeMode,
        excludeMode = excludeMode,
        includeTagIds = includeTagIds.ToArray(),
        excludeTagIds = excludeTagIds.ToArray(),
        clientSortColumn = clientSortColumn,
        clientSortAsc = clientSortAsc,
        showTagFilters = showTagFilters
    };

    private List<ActiveFilterChip> GetActiveFilterChips()
    {
        var chips = new List<ActiveFilterChip>();
        if (!string.IsNullOrWhiteSpace(localSearch)) chips.Add(new($"Szukaj: {localSearch}", "active-library-filter-chip", () => { localSearch = null; return Task.CompletedTask; }));
        if (clientSortColumn != "name" || !clientSortAsc) chips.Add(new($"Sortowanie: {clientSortColumn} ({(clientSortAsc ? "asc" : "desc")})", "active-library-filter-chip", () => { clientSortColumn = "name"; clientSortAsc = true; return Task.CompletedTask; }));
        foreach (var id in includeTagIds) { var name = availableTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Włącz: {name} ({includeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-include", () => { includeTagIds.Remove(id); return Task.CompletedTask; })); }
        foreach (var id in excludeTagIds) { var name = availableTags.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Wyklucz: {name} ({excludeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-exclude", () => { excludeTagIds.Remove(id); return Task.CompletedTask; })); }
        return chips;
    }

    private sealed record ActiveFilterChip(string Label, string CssClass, Func<Task> ClearAsync);
    private sealed record PlaylistFilterSnapshot(string? LocalSearch, string IncludeMode, string ExcludeMode, long[] IncludeTagIds, long[] ExcludeTagIds, string SortColumn, bool SortAsc)
    {
        public bool Matches(PlaylistFilterSnapshot? other) => other is not null && LocalSearch == other.LocalSearch && IncludeMode == other.IncludeMode && ExcludeMode == other.ExcludeMode && SortColumn == other.SortColumn && SortAsc == other.SortAsc && IncludeTagIds.SequenceEqual(other.IncludeTagIds) && ExcludeTagIds.SequenceEqual(other.ExcludeTagIds);
    }

    private async Task SaveCurrentFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = System.Text.Json.JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "playlist", ContextId = PlaylistId, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PostAsJsonAsync("api/library/filters", body);
        if (res.IsSuccessStatusCode)
        {
            newFilterName = string.Empty;
            await LoadSavedFilters();
        }
    }

    private async Task ApplySelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var item = savedFilters.FirstOrDefault(x => x.Id == id);
        if (item == null || string.IsNullOrWhiteSpace(item.PayloadJson)) return;
        var state = System.Text.Json.JsonSerializer.Deserialize<PlaylistState>(item.PayloadJson);
        if (state == null) return;

        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        clientSortColumn = state.clientSortColumn ?? clientSortColumn;
        clientSortAsc = state.clientSortAsc ?? clientSortAsc;
        showTagFilters = state.showTagFilters ?? showTagFilters;

        await ApplyFiltersAsync();
    }

    private async Task RenameSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = System.Text.Json.JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "playlist", ContextId = PlaylistId, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PutAsJsonAsync($"api/library/filters/{id}", body);
        if (res.IsSuccessStatusCode)
        {
            await LoadSavedFilters();
        }
    }

    private async Task DeleteSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var res = await Http.DeleteAsync($"api/library/filters/{id}");
        if (res.IsSuccessStatusCode)
        {
            selectedSavedFilterId = null;
            await LoadSavedFilters();
        }
    }

    private int GetTagState(long tagId)
    {
        if (includeTagIds.Contains(tagId)) return 1;
        if (excludeTagIds.Contains(tagId)) return 2;
        return 0;
    }

    private void CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);
        if (state == 0) { includeTagIds.Add(tagId); return; }
        if (state == 1) { includeTagIds.Remove(tagId); excludeTagIds.Add(tagId); return; }
        excludeTagIds.Remove(tagId);
    }

    private async Task PlayTrack(string? uri)
    {
        if (string.IsNullOrWhiteSpace(uri)) return;
        var body = new { uris = new[] { uri } };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();
            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task PlayFiltered()
    {
        var uris = filteredTracks
            .Where(t => !string.IsNullOrWhiteSpace(t.Uri))
            .Select(t => t.Uri!)
            .ToList();

        if (uris.Count == 0)
            return;

        var body = new { uris = uris };
        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");
            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

