@page "/ai"
@inject HttpClient Http

<PageTitle>Asystent AI</PageTitle>

<h1>Asystent biblioteki</h1>

@if (accessLoading)
{
    <p>Sprawdzanie dostępu…</p>
}
else if (access is null || !access.Allowed)
{
    <div class="alert alert-secondary">@(access?.Reason ?? "Asystent jest niedostępny.")</div>
}
else
{
    <p class="text-secondary">Pozostało dzisiaj: @access.RemainingRequestsToday zapytań. Odpowiedzi zawierają źródła; tagi zapisujesz dopiero po potwierdzeniu.</p>
    <div class="card app-form-surface mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label">Typ kontekstu</label>
                    <select class="form-select" @bind="itemType">
                        <option value="artist">Artysta</option>
                        <option value="album">Album</option>
                        <option value="track">Utwór</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Identyfikator Spotify</label>
                    <input class="form-control" @bind="spotifyItemId" placeholder="ID z adresu strony artysty, albumu lub utworu" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Pytanie</label>
                    <input class="form-control" @bind="message" @onkeydown="OnKeyDown" placeholder="Np. Jakie gatunki reprezentuje ten album?" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-outline-primary" @onclick="AskGenres">Gatunki</button>
                <button class="btn btn-outline-primary" @onclick="AskPopularAlbums">Popularne albumy</button>
                <button class="btn btn-outline-primary" @onclick="AskSimilarArtists">Podobni artyści</button>
                <button class="btn btn-outline-primary" @onclick="AskSimilarAlbums">Podobne albumy</button>
                <button class="btn btn-outline-primary" @onclick="AskTags">Propozycje tagów</button>
                <button class="btn btn-primary ms-auto" disabled="@sending" @onclick="Send">@(sending ? "Sprawdzanie…" : "Zapytaj")</button>
            </div>
        </div>
    </div>

    @if (response != null)
    {
        @if (!string.IsNullOrWhiteSpace(response.Notice)) { <div class="alert alert-info">@response.Notice</div> }
        @if (!string.IsNullOrWhiteSpace(response.Answer)) { <div class="alert alert-light border">@response.Answer</div> }
        @if (response.Items.Count > 0)
        {
            <h2 class="h5">Wyniki</h2>
            <div class="list-group mb-3">
                @foreach (var item in response.Items)
                {
                    <a class="list-group-item list-group-item-action" href="@item.Url" target="_blank" rel="noopener">
                        <strong>@item.Name</strong>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle)) { <span> — @item.Subtitle</span> }
                        @if (!string.IsNullOrWhiteSpace(item.Metric)) { <small class="d-block text-secondary">@item.Metric@(item.Score.HasValue ? $": {item.Score}" : string.Empty)</small> }
                    </a>
                }
            </div>
        }
        @if (response.TagProposals.Count > 0)
        {
            <h2 class="h5">Propozycje tagów</h2>
            <div class="list-group mb-3">
                @foreach (var tag in response.TagProposals)
                {
                    <div class="list-group-item d-flex gap-3 align-items-center">
                        <div class="flex-grow-1"><strong>@tag.Name</strong><small class="d-block text-secondary">@tag.Reason</small></div>
                        @if (tag.Assigned)
                        {
                            <span class="badge text-bg-success">Przypisano</span>
                        }
                        else if (tag.ExistingTagId.HasValue)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => AssignTag(tag)">Przypisz tag</button>
                        }
                        else { <span class="badge text-bg-secondary">Nowy tag — utwórz ręcznie</span> }
                    </div>
                }
            </div>
        }
        @if (response.Sources.Count > 0)
        {
            <h2 class="h5">Źródła</h2>
            <ul>
                @foreach (var source in response.Sources)
                {
                    <li><a href="@source.Url" target="_blank" rel="noopener">@source.Name</a>@(string.IsNullOrWhiteSpace(source.Detail) ? string.Empty : $" — {source.Detail}")</li>
                }
            </ul>
        }
    }
}

@code {
    private AiAccess? access;
    private bool accessLoading = true;
    private bool sending;
    private string itemType = "artist";
    private string spotifyItemId = string.Empty;
    private string message = "Jakie gatunki reprezentuje ten element?";
    private AiResponse? response;

    protected override async Task OnInitializedAsync()
    {
        try { access = await Http.GetFromJsonAsync<AiAccess>("api/ai/access"); }
        finally { accessLoading = false; }
    }

    private async Task AskPreset(string question) { message = question; await Send(); }
    private Task AskGenres() => AskPreset("Jakie gatunki reprezentuje ten element?");
    private Task AskPopularAlbums() => AskPreset("Jakie są najpopularniejsze albumy tego artysty?");
    private Task AskSimilarArtists() => AskPreset("Poleć podobnych artystów");
    private Task AskSimilarAlbums() => AskPreset("Poleć podobne albumy");
    private Task AskTags() => AskPreset("Zaproponuj tagi dla tego elementu");
    private async Task OnKeyDown(KeyboardEventArgs args) { if (args.Key == "Enter") await Send(); }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(spotifyItemId) || string.IsNullOrWhiteSpace(message))
        {
            response = new AiResponse { Notice = "Podaj identyfikator Spotify oraz pytanie." };
            return;
        }
        sending = true;
        try
        {
            var result = await Http.PostAsJsonAsync("api/ai/chat", new { message, itemType, spotifyItemId });
            response = await result.Content.ReadFromJsonAsync<AiResponse>() ?? new AiResponse { Notice = "Nie udało się odczytać odpowiedzi." };
            access = await Http.GetFromJsonAsync<AiAccess>("api/ai/access");
        }
        catch { response = new AiResponse { Notice = "Nie udało się połączyć z asystentem." }; }
        finally { sending = false; }
    }

    private async Task AssignTag(AiTagProposal tag)
    {
        if (!tag.ExistingTagId.HasValue) return;
        var result = await Http.PostAsJsonAsync("api/tags/assign", new { tagId = tag.ExistingTagId.Value, spotifyItemId, itemType, strength = 3.0f });
        if (result.IsSuccessStatusCode) tag.Assigned = true;
        else response!.Notice = "Nie udało się przypisać tagu.";
    }

    private sealed class AiAccess { public bool Allowed { get; set; } public string? Reason { get; set; } public int RemainingRequestsToday { get; set; } }
    private sealed class AiResponse { public string? Answer { get; set; } public string? Notice { get; set; } public List<AiItem> Items { get; set; } = new(); public List<AiSource> Sources { get; set; } = new(); public List<AiTagProposal> TagProposals { get; set; } = new(); }
    private sealed class AiItem { public string Name { get; set; } = string.Empty; public string? Subtitle { get; set; } public decimal? Score { get; set; } public string? Metric { get; set; } public string? Url { get; set; } }
    private sealed class AiSource { public string Name { get; set; } = string.Empty; public string Url { get; set; } = string.Empty; public string? Detail { get; set; } }
    private sealed class AiTagProposal { public string Name { get; set; } = string.Empty; public string Reason { get; set; } = string.Empty; public long? ExistingTagId { get; set; } public bool Assigned { get; set; } }
}
