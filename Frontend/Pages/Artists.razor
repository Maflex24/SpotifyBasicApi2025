    private async Task RefreshArtistTags(string artistId)
    {
        var response = await Http.GetAsync($"api/tags/assign/artist/{Uri.EscapeDataString(artistId)}");
        if (!response.IsSuccessStatusCode)
            return;

        var tags = await response.Content.ReadFromJsonAsync<List<TagBadge>>() ?? new List<TagBadge>();
        await ApplyTaggedArtistState(new TagAssignmentState { ItemType = "artist", SpotifyItemId = artistId, Tags = tags });
    }

    private async Task ApplyTaggedArtistState(TagAssignmentState state)
    {
        if (!string.Equals(state.ItemType, "artist", StringComparison.OrdinalIgnoreCase))
            return;

        var artist = artists.FirstOrDefault(item => item.Id == state.SpotifyItemId);
        if (artist == null)
            return;

        var previousTagIds = artist.Tags.Select(tag => tag.TagId).ToHashSet();
        artist.Tags = state.Tags.Select(tag => new ArtistTag
        {
            TagId = tag.TagId,
            TagName = tag.TagName,
            TagGroupName = tag.TagGroupName,
            Strength = tag.Strength
        }).ToList();

        if (!MatchesArtistTagFilters(artist))
            artists.Remove(artist);

        SortArtistsByTagStrength();
        ApplyLocalFilter();

        if (!previousTagIds.SetEquals(artist.Tags.Select(tag => tag.TagId)))
            await LoadArtistTagCounts();
    }

    private bool MatchesArtistTagFilters(Artist artist)
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        var tagIds = artist.Tags.Select(tag => tag.TagId).ToHashSet();
        if (long.TryParse(filters.SelectedTagFilter, out var selectedTagId) && !tagIds.Contains(selectedTagId))
            return false;

        if (filters.IncludeTagIds.Length > 0)
        {
            var matchesInclude = string.Equals(filters.IncludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.IncludeTagIds.All(tagIds.Contains)
                : filters.IncludeTagIds.Any(tagIds.Contains);
            if (!matchesInclude)
                return false;
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            var matchesExcluded = string.Equals(filters.ExcludeMode, "and", StringComparison.OrdinalIgnoreCase)
                ? filters.ExcludeTagIds.All(tagIds.Contains)
                : filters.ExcludeTagIds.Any(tagIds.Contains);
            if (matchesExcluded)
                return false;
        }

        return true;
    }

    private void SortArtistsByTagStrength()
    {
        var filters = appliedFilters ?? CaptureCurrentFilters();
        if (!string.Equals(filters.SortKey, "weight", StringComparison.OrdinalIgnoreCase) || !long.TryParse(filters.SelectedTagSort, out var tagId))
            return;

        artists = (string.Equals(filters.SortOrder, "asc", StringComparison.OrdinalIgnoreCase)
                ? artists.OrderBy(artist => artist.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0)
                : artists.OrderByDescending(artist => artist.Tags.FirstOrDefault(tag => tag.TagId == tagId)?.Strength ?? 0))
            .ThenBy(artist => artist.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

