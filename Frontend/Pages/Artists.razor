    {
        public bool Matches(ArtistFilterSnapshot? other) => other is not null && SortKey == other.SortKey && SortOrder == other.SortOrder && SelectedGenre == other.SelectedGenre && SelectedTagFilter == other.SelectedTagFilter && SelectedTagSort == other.SelectedTagSort && LocalSearch == other.LocalSearch && IncludeMode == other.IncludeMode && ExcludeMode == other.ExcludeMode && SearchOutsideLibrary == other.SearchOutsideLibrary && IncludeTagIds.SequenceEqual(other.IncludeTagIds) && ExcludeTagIds.SequenceEqual(other.ExcludeTagIds) && TagStrengthFilters.Equal(IncludeTagStrengths, other.IncludeTagStrengths) && TagStrengthFilters.Equal(ExcludeTagStrengths, other.ExcludeTagStrengths);
    }

