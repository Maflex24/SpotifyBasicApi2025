@page "/artists"
@inject LocalStorageService Store
@inject IJSRuntime JS
@inject HttpClient Http
@using System.Text.Json

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3 sticky-toolbar">
        <h4 class="mb-0">Artyści</h4>
        <div class="d-flex gap-2 align-items-center flex-wrap">
            <select class="form-select form-select-sm w-auto select-dark" @bind="selectedGenre">
                <option value="">Wszystkie gatunki</option>
                @foreach (var g in availableGenres)
                {
                    <option value="@g">@g</option>
                }
            </select>


            <select class="form-select form-select-sm w-auto select-dark" @bind="sortKey">
                <option value="name">Nazwa</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
            </select>
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortOrder">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>

            <input class="form-control form-control-sm input-dark" style="width: 220px;" type="text" placeholder="Szukaj artysty (AND)" @bind="LocalSearch" @bind:event="oninput" />

            <button class="btn btn-sm btn-outline-secondary" @onclick="ResetFilters">Resetuj</button>
            <button class="btn btn-sm btn-outline-light" @onclick="LoadArtists">Zastosuj</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleTagFilters">Tagi @(showTagFilters ? "▼" : "▲")</button>
            <button class="btn btn-sm btn-outline-warning" title="Wylosuj artystę z bieżących wyników" @onclick="PickRandomArtist">Losuj</button>
        </div>
    </div>

    <div class="d-flex justify-content-start align-items-center mb-3 gap-2 flex-wrap">
        <span class="text-muted me-2">Zapisane filtry:</span>
        <select class="form-select form-select-sm w-auto select-dark" @bind="selectedSavedFilterId">
            <option value="">Wybierz filtr...</option>
            @foreach (var f in savedFilters)
            {
                <option value="@f.Id.ToString()">@f.Name</option>
            }
        </select>
        <input class="form-control form-control-sm input-dark" style="width: 160px;" placeholder="Nazwa filtra" @bind="newFilterName" />
        <button class="btn btn-sm btn-outline-primary" title="Zapisz jako nowy" @onclick="SaveCurrentFilter">Zapisz</button>
        <button class="btn btn-sm btn-outline-light" title="Zastosuj wybrany" @onclick="ApplySelectedFilter">Wczytaj</button>
        <button class="btn btn-sm btn-outline-warning" title="Zmień nazwę / nadpisz" @onclick="RenameSelectedFilter">Zmień nazwę</button>
        <button class="btn btn-sm btn-outline-danger" title="Usuń wybrany" @onclick="DeleteSelectedFilter">Usuń</button>
    </div>

    @if (showTagFilters)
    {
        <div class="d-flex align-items-start gap-3 w-100 mt-2">
            <div class="d-flex flex-column gap-1 flex-fill">
                <div class="tag-chips-container mt-2">
                    @foreach (var t in availableTags)
                    {
                        var state = GetTagState(t.Id);
                        var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                        var count = GetTagCount(t.Id);
                        <button type="button" class="tag-chip @css" @onclick="() => CycleTagState(t.Id)">@t.Name

                        @if (count > 0)
                        {
                            <span class="tag-count-info"> (@count)</span>
                        }
                        </button>
                    }

                    <button type="button" class="tag-chip tag-include" title="Tryb łączenia włączonych" @onclick="ToggleIncludeMode">@((includeMode == "and") ? "AND" : "OR")</button>
                    <button type="button" class="tag-chip tag-exclude" title="Tryb łączenia wykluczonych" @onclick="ToggleExcludeMode">@((excludeMode == "and") ? "AND" : "OR")</button>
                </div>
            </div>
        </div>
    }

    <div class="library-card-grid">
        @foreach (var a in filteredArtists)
        {
            <div class="library-card-grid-item">
                <div class="card bg-dark text-light h-100">
                    @if (a.Images?.Any() == true)
                    {
                        <div class="artist-image-square" style="position:relative;">
                            <img src="@GetBestImageUrl(a.Images)" alt="@a.Name">
                            <button class="artist-play-overlay" title="Odtwórz top utwory"
                                    @onclick="() => PlayArtistTopTracks(a.Id)">▶</button>
                            <button class="btn btn-sm btn-outline-danger" title="Usuń z biblioteki" style="position:absolute; right:6px; top:6px;"
                                    @onclick="() => ConfirmRemoveArtist(a.Id)">✖</button>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-1"><a href="/artist/@a.Id" class="link-light text-decoration-none">@a.Name</a></h6>
                            <span class="badge bg-secondary">@a.Popularity</span>
                        </div>
                        
                        @if (a.Genres?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Gatunki:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var genre in a.Genres)
                                    {
                                        <span class="badge bg-outline-light text-light" style="font-size: 0.7rem;">@genre</span>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (a.Tags?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Tagi:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var tag in a.Tags.Take(3))
                                    {
                                        <span class="badge badge-tag" style="cursor:pointer;" title="Kliknij, aby edytować" @onclick="() => SelectArtistTag(a.Id, tag.TagId)">
                                            @tag.TagName (@tag.Strength)
                                        </span>
                                    }
                                    @if (a.Tags.Count > 3)
                                    {
                                        <span class="badge bg-outline-primary text-primary badge-tag">+@(a.Tags.Count - 3)</span>
                                    }
                                </div>
                            </div>
                        }
                        
                        <div class="mt-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-light" @onclick="() => OpenArtistTagging(a.Id)">Taguj</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showArtistTagging && taggingArtistId != null)
{
    <div class="shadow" style="position:fixed; left:50%; transform:translateX(-50%); bottom:64px; z-index:2000; background-color:#0f1117; border:1px solid #1f2937; border-radius:8px; padding:10px; width:min(640px, 92vw)">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <strong>Tagowanie artysty</strong>
            <button class="btn btn-sm btn-outline-light" @onclick="CloseArtistTagging">✕</button>
        </div>
        <TagSearchSelect Items="artistTagItems" Placeholder="Taguj artystę..." OnSelected="AddArtistTagFromPanel" ShowClear="false" />
        @if (artists.FirstOrDefault(x => x.Id == taggingArtistId)?.Tags?.Count > 0)
        {
            var a = artists.First(x => x.Id == taggingArtistId);
            <div class="d-flex flex-wrap gap-2 mt-2">
                @foreach (var assign in a.Tags)
                {
                    <div class="badge bg-secondary">
                        @assign.TagName (@assign.Strength.ToString("0.0"))
                        <button class="btn btn-sm btn-outline-light ms-1" title="Zmniejsz" @onclick="(() => SetArtistTagStrength(a.Id, assign.TagId, Math.Clamp(assign.Strength - 0.5f, 0.0f, 6.0f)))">−</button>
                        <button class="btn btn-sm btn-outline-light ms-1" title="Zwiększ" @onclick="(() => SetArtistTagStrength(a.Id, assign.TagId, Math.Clamp(assign.Strength + 0.5f, 0.0f, 6.0f)))">+</button>
                        <button class="btn btn-sm btn-outline-danger ms-1" title="Usuń" @onclick="(() => RemoveArtistTag(a.Id, assign.TagId))">✖</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;
    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string Scope { get; set; } = string.Empty; public string? ContextId { get; set; } public string PayloadJson { get; set; } = string.Empty; }

    private string sortKey = "name";
    private string sortOrder = "asc";
    private string? selectedGenre;
    private string? selectedTagFilter;
    private string? selectedTagSort;
    private List<Artist> artists = new();
    private List<Artist> filteredArtists = new();
    private List<TagDto> availableTags = new();
    private List<string> availableGenres = new();
    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private string includeMode = "or";
    private string excludeMode = "or";
    private bool showTagFilters = true;

    private Dictionary<string, float?> hoverByKey = new();
    private Dictionary<string, long?> selectedTagByArtist = new();
    private bool showArtistTagging = false;
    private string? taggingArtistId;
    private Dictionary<long, int> tagCounts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadFromStore();
        await LoadGenres();
        await LoadAvailableTags();
        await LoadArtists();
        await LoadSavedFilters();
    }

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync("api/library/filters?scope=artists");
        if (!res.IsSuccessStatusCode) return;
        savedFilters = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
    }

    private async Task LoadArtists()
    {
        var query = new List<string>();
        query.Add($"sort={sortKey}");
        query.Add($"order={sortOrder}");

        if (!string.IsNullOrEmpty(selectedTagFilter))
            query.Add($"tags={selectedTagFilter}");

        if (!string.IsNullOrEmpty(selectedGenre))
            query.Add($"genre={Uri.EscapeDataString(selectedGenre)}");

        if (!string.IsNullOrEmpty(selectedTagSort))
            query.Add($"sortTagId={selectedTagSort}");

        if (includeTagIds.Count > 0)
        {
            query.Add($"includeTags={string.Join(',', includeTagIds)}");
            query.Add($"includeMode={includeMode}");
        }

        if (excludeTagIds.Count > 0)
        {
            query.Add($"excludeTags={string.Join(',', excludeTagIds)}");
            query.Add($"excludeMode={excludeMode}");
        }

        var res = await Http.GetAsync($"api/library/artists?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var payload = await res.Content.ReadFromJsonAsync<ArtistsResponse>();
        artists = payload?.items ?? new List<Artist>();
        // Utrzymaj wybór tagu jeśli nadal istnieje
        foreach (var a in artists)
        {
            if (!selectedTagByArtist.ContainsKey(a.Id))
            {
                selectedTagByArtist[a.Id] = null;
            }
        }

        ApplyLocalFilter();
        await LoadArtistTagCounts();

        await SaveToStore();
    }

    private async Task LoadAvailableTags()
    {
        // Pobierz wszystkie tagi użytkownika i filtruj tylko ForArtist
        var res = await Http.GetAsync("api/tags");

        if (!res.IsSuccessStatusCode)
            return;

        var allTags = await res.Content.ReadFromJsonAsync<List<TagDto>>() ?? new List<TagDto>();
        availableTags = allTags.Where(t => t.ForArtist).ToList();
        artistTagItems = availableTags.Select(t => new TagItem { Id = t.Id, Name = t.Name }).ToList();
        await LoadArtistTagCounts();
    }

    private async Task LoadGenres()
    {
        var res = await Http.GetAsync("api/library/artists/genres");
        if (!res.IsSuccessStatusCode)
            return;
        var list = await res.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
        availableGenres = list;
    }

    private RenderFragment StarRating(string key, float value, Func<float, Task> onChange) => builder =>
    {
        int seq = 0;
        var display = hoverByKey.TryGetValue(key, out var h) && h.HasValue ? h.Value : value;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "style", "display:inline-flex; align-items:center;");
        builder.AddAttribute(seq++, "title", $"{display:0.0}");
        for (int i = 1; i <= 6; i++)
        {
            var star = i;
            var fill = display >= star ? 1.0f : (display >= star - 0.5f ? 0.5f : 0f);

            // kontener gwiazdki
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "position:relative; display:inline-block; width:2rem; height:2rem; line-height:2rem; font-size:2rem; margin-right:6px;");
            builder.AddAttribute(seq++, "onmouseleave", EventCallback.Factory.Create(this, () => { if (hoverByKey.ContainsKey(key)) hoverByKey.Remove(key); }));

            // pusty kontur
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-secondary");
            builder.AddAttribute(seq++, "style", "position:absolute; inset:0; pointer-events:none;");
            builder.AddContent(seq++, "☆");
            builder.CloseElement();

            // wypełnienie (połówka/całość) przycięte szerokością
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-warning");
            var width = fill >= 1.0f ? "100%" : (fill >= 0.5f ? "50%" : "0%");
            builder.AddAttribute(seq++, "style", $"position:absolute; inset:0; width:{width}; overflow:hidden; white-space:nowrap; pointer-events:none;");
            builder.AddContent(seq++, "★");
            builder.CloseElement();

            // hit area lewa połowa
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; left:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star - 0.5f; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star - 0.5f)));
            builder.CloseElement();

            // hit area prawa połowa
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; right:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star)));
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private async Task SetArtistTagStrength(string artistId, long tagId, float strength)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "artist", SpotifyItemId = artistId, Strength = strength };

        // Spróbuj update; jeśli 404, zrób create
        var res = await Http.PutAsJsonAsync("api/tags/assign", model);

        if (!res.IsSuccessStatusCode)
        {
            var resCreate = await Http.PostAsJsonAsync("api/tags/assign", model);
            if (!resCreate.IsSuccessStatusCode)
                return;
        }

        await LoadArtists();
        await SaveToStore();
    }

    private async Task RemoveArtistTag(string artistId, long tagId)
    {
        var model = new AssignDto { TagId = tagId, ItemType = "artist", SpotifyItemId = artistId, Strength = 0 };
        var req = await Http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, "api/tags/assign")
        {
            Content = JsonContent.Create(model)
        });

        if (!req.IsSuccessStatusCode)
            return;

        await LoadArtists();
        await SaveToStore();
    }

    private void OpenArtistTagging(string artistId)
    {
        taggingArtistId = artistId;
        showArtistTagging = true;
    }

    private void CloseArtistTagging()
    {
        showArtistTagging = false;
        taggingArtistId = null;
    }

    private async Task AddArtistTagFromPanel(long? tagId)
    {
        if (taggingArtistId == null || tagId is null)
            return;

        await SetArtistTagStrength(taggingArtistId, tagId.Value, 3.0f);
    }
    
    private sealed class ArtistsResponse { public int total { get; set; } public List<Artist> items { get; set; } = new(); }
    private sealed class Artist 
    { 
        public string Id { get; set; } = string.Empty; 
        public string Name { get; set; } = string.Empty; 
        public int Popularity { get; set; } 
        public float TagStrength { get; set; }
        public List<string> Genres { get; set; } = new();
        public List<SpotifyImage> Images { get; set; } = new();
        public List<ArtistTag> Tags { get; set; } = new();
    }

    private const string StoreKey = "filters:artists";

    private async Task SaveToStore()
    {
        var state = new
        {
            sortKey,
            sortOrder,
            selectedGenre,
            selectedTagFilter,
            selectedTagSort,
            localSearch,
            includeTagIds = includeTagIds.ToArray(),
            excludeTagIds = excludeTagIds.ToArray(),
            includeMode,
            excludeMode,
            showTagFilters
        };

        await Store.SetItemAsync(StoreKey, state);
    }

    private async Task LoadFromStore()
    {
        var state = await Store.GetItemAsync<ArtistsState>(StoreKey);

        if (state == null)
            return;

        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedGenre = state.selectedGenre;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;

        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : includeTagIds;
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : excludeTagIds;

        showTagFilters = state.showTagFilters ?? showTagFilters;

        ApplyLocalFilter();
    }

    private sealed class ArtistsState
    {
        public string? sortKey { get; set; }
        public string? sortOrder { get; set; }
        public string? selectedGenre { get; set; }
        public string? selectedTagFilter { get; set; }
        public string? selectedTagSort { get; set; }
        public string? localSearch { get; set; }
        public string? includeMode { get; set; }
        public string? excludeMode { get; set; }
        public long[]? includeTagIds { get; set; }
        public long[]? excludeTagIds { get; set; }
        public bool? showTagFilters { get; set; }
    }
    
    private sealed class SpotifyImage
    {
        public string Url { get; set; } = string.Empty;
        public int? Height { get; set; }
        public int? Width { get; set; }
    }
    private sealed class ArtistTag
    {
        public long TagId { get; set; }
        public string TagName { get; set; } = string.Empty;
        public string TagGroupName { get; set; } = string.Empty;
        public float Strength { get; set; }
    }
    private sealed class TagDto { public long Id { get; set; } public string Name { get; set; } = string.Empty; public bool ForArtist { get; set; } }
    private List<TagItem> artistTagItems = new();
    private sealed class AssignDto { public long TagId { get; set; } public string SpotifyItemId { get; set; } = string.Empty; public string ItemType { get; set; } = string.Empty; public float Strength { get; set; } }

    private string? GetBestImageUrl(List<SpotifyImage> images)
    {
        if (images == null || images.Count == 0)
            return null;

        var ordered = images
            .Where(i => !string.IsNullOrWhiteSpace(i.Url))
            .OrderByDescending(i => i.Width ?? 0)
            .ThenByDescending(i => i.Height ?? 0)
            .ToList();

        return ordered.FirstOrDefault()?.Url ?? images.FirstOrDefault()?.Url;
    }

    private async Task PlayArtistTopTracks(string artistId)
    {
        var top = await Http.GetFromJsonAsync<TopTracksResponse>($"api/spotify/artists/{artistId}/top-tracks");
        var uris = top?.items?.Where(t => !string.IsNullOrWhiteSpace(t.Uri)).Select(t => t.Uri).ToList() ?? new List<string>();

        if (uris.Count == 0)
            return;

        var body = new
        {
            uris = uris
        };

        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            // spróbuj przenieść odtwarzanie na pierwsze dostępne urządzenie i zagrać ponownie
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");

            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

    private async Task ConfirmRemoveArtist(string artistId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Czy na pewno chcesz usunąć artystę z biblioteki?"))
            return;

        var res = await Http.DeleteAsync($"api/library/artists/{Uri.EscapeDataString(artistId)}");
        if (!res.IsSuccessStatusCode)
            return;

        await LoadArtists();
    }

    private async Task ResetFilters()
    {
        sortKey = "name";
        sortOrder = "asc";
        selectedGenre = null;
        selectedTagFilter = null;
        selectedTagSort = null;
        LocalSearch = null;
        includeTagIds.Clear();
        excludeTagIds.Clear();
        includeMode = "or";
        excludeMode = "or";

        await LoadArtists();
    }

    private ArtistsState BuildCurrentState() => new ArtistsState
    {
        sortKey = sortKey,
        sortOrder = sortOrder,
        selectedGenre = selectedGenre,
        selectedTagFilter = selectedTagFilter,
        selectedTagSort = selectedTagSort,
        localSearch = localSearch,
        includeMode = includeMode,
        excludeMode = excludeMode,
        includeTagIds = includeTagIds.ToArray(),
        excludeTagIds = excludeTagIds.ToArray(),
        showTagFilters = showTagFilters
    };

    private async Task SaveCurrentFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "artists", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PostAsJsonAsync("api/library/filters", body);
        if (res.IsSuccessStatusCode)
        {
            newFilterName = string.Empty;
            await LoadSavedFilters();
        }
    }

    private async Task ApplySelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var item = savedFilters.FirstOrDefault(x => x.Id == id);
        if (item == null || string.IsNullOrWhiteSpace(item.PayloadJson)) return;
        var state = JsonSerializer.Deserialize<ArtistsState>(item.PayloadJson);
        if (state == null) return;

        sortKey = state.sortKey ?? sortKey;
        sortOrder = state.sortOrder ?? sortOrder;
        selectedGenre = state.selectedGenre;
        selectedTagFilter = state.selectedTagFilter;
        selectedTagSort = state.selectedTagSort;
        localSearch = state.localSearch;
        includeMode = state.includeMode ?? includeMode;
        excludeMode = state.excludeMode ?? excludeMode;
        includeTagIds = state.includeTagIds != null ? new HashSet<long>(state.includeTagIds) : new HashSet<long>();
        excludeTagIds = state.excludeTagIds != null ? new HashSet<long>(state.excludeTagIds) : new HashSet<long>();
        showTagFilters = state.showTagFilters ?? showTagFilters;

        await LoadArtists();
    }

    private async Task RenameSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        if (string.IsNullOrWhiteSpace(newFilterName)) return;
        var payloadJson = JsonSerializer.Serialize(BuildCurrentState());
        var body = new { Scope = "artists", ContextId = (string?)null, Name = newFilterName!, PayloadJson = payloadJson };
        var res = await Http.PutAsJsonAsync($"api/library/filters/{id}", body);
        if (res.IsSuccessStatusCode)
        {
            await LoadSavedFilters();
        }
    }

    private async Task DeleteSelectedFilter()
    {
        if (string.IsNullOrWhiteSpace(selectedSavedFilterId)) return;
        if (!long.TryParse(selectedSavedFilterId, out var id)) return;
        var res = await Http.DeleteAsync($"api/library/filters/{id}");
        if (res.IsSuccessStatusCode)
        {
            selectedSavedFilterId = null;
            await LoadSavedFilters();
        }
    }

    private sealed class TopTracksResponse { public List<TopTrackItem> items { get; set; } = new(); }
    private sealed class TopTrackItem { public string Id { get; set; } = string.Empty; public string Uri { get; set; } = string.Empty; }
    private sealed class DevicesResponse { public List<DeviceItem> Devices { get; set; } = new(); }
    private sealed class DeviceItem { public string Id { get; set; } = string.Empty; public bool IsActive { get; set; } }

    private async Task ApplyFilterByTag(long tagId)
    {
        var tag = tagId.ToString();

        if (selectedTagFilter == tag)
        {
            selectedTagFilter = null;

            await LoadArtists();

            return;
        }

        selectedTagFilter = tag;
        selectedTagSort = tag;
        sortKey = "weight";
        sortOrder = "desc";

        await LoadArtists();
    }

    private string? localSearch;
    private string? LocalSearch
    {
        get => localSearch;
        set
        {
            if (localSearch == value)
                return;

            localSearch = value;
            ApplyLocalFilter();
        }
    }

    private void ApplyLocalFilter()
    {
        if (string.IsNullOrWhiteSpace(localSearch))
        {
            filteredArtists = artists.ToList();

            return;
        }

        var terms = localSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => t.ToLowerInvariant())
            .ToList();

        filteredArtists = artists.Where(a =>
        {
            var parts = new List<string>();
            parts.Add(a.Name ?? string.Empty);

            if (a.Genres != null && a.Genres.Count > 0)
                parts.Add(string.Join(' ', a.Genres));

            if (a.Tags != null && a.Tags.Count > 0)
                parts.Add(string.Join(' ', a.Tags.Select(t => t.TagName)));

            var hay = string.Join(' ', parts).ToLowerInvariant();

            foreach (var term in terms)
            {
                if (!hay.Contains(term))
                    return false;
            }

            return true;
        }).ToList();
    }

    private void PickRandomArtist()
    {
        // Odtwórz pełną listę wyników przed losowaniem, aby kolejne kliknięcie
        // nie losowało z wcześniej wyświetlonego pojedynczego artysty.
        ApplyLocalFilter();

        if (filteredArtists.Count == 0)
            return;

        filteredArtists = new List<Artist>
        {
            filteredArtists[Random.Shared.Next(filteredArtists.Count)]
        };
    }

    private void SelectArtistTag(string artistId, long tagId)
    {
        selectedTagByArtist[artistId] = tagId;
    }

    private string GetSelectedTagValue(string artistId)
    {
        return selectedTagByArtist.TryGetValue(artistId, out var v) && v.HasValue ? v.Value.ToString() : string.Empty;
    }

    private void OnArtistTagSelectChanged(string artistId, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            selectedTagByArtist[artistId] = null;
            
            return;
        }

        if (long.TryParse(value, out var id))
            selectedTagByArtist[artistId] = id;
        else
            selectedTagByArtist[artistId] = null;
    }

    private async Task RemoveSelectedArtistTagIfAny(string artistId)
    {
        if (selectedTagByArtist.TryGetValue(artistId, out var v) && v.HasValue)
        {
            await RemoveArtistTag(artistId, v.Value);
            selectedTagByArtist[artistId] = null;
        }
    }

    private void ToggleInclude(long tagId)
    {
        if (includeTagIds.Contains(tagId))
            includeTagIds.Remove(tagId);
        else
            includeTagIds.Add(tagId);

        _ = LoadArtistTagCounts();
    }

    private void ToggleExclude(long tagId)
    {
        if (excludeTagIds.Contains(tagId))
            excludeTagIds.Remove(tagId);
        else
            excludeTagIds.Add(tagId);

        _ = LoadArtistTagCounts();
    }

    private int GetTagState(long tagId)
    {
        if (includeTagIds.Contains(tagId))
            return 1; // include

        if (excludeTagIds.Contains(tagId))
            return 2; // exclude

        return 0; // none
    }

    private void CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);

        if (state == 0)
        {
            includeTagIds.Add(tagId);
            _ = LoadArtistTagCounts();
            return;
        }

        if (state == 1)
        {
            includeTagIds.Remove(tagId);
            excludeTagIds.Add(tagId);
            _ = LoadArtistTagCounts();
            return;
        }

        // state == 2
        excludeTagIds.Remove(tagId);
        _ = LoadArtistTagCounts();
    }

    private void ToggleIncludeMode()
    {
        includeMode = includeMode == "and" ? "or" : "and";
        _ = LoadArtistTagCounts();
    }

    private void ToggleExcludeMode()
    {
        excludeMode = excludeMode == "and" ? "or" : "and";
        _ = LoadArtistTagCounts();
    }
    private async Task ToggleTagFilters()
    {
        showTagFilters = !showTagFilters;
        await SaveToStore();
    }

    private async Task LoadArtistTagCounts()
    {
        var query = new List<string>();

        if (!string.IsNullOrEmpty(selectedTagFilter))
            query.Add($"tags={selectedTagFilter}");

        if (!string.IsNullOrEmpty(selectedGenre))
            query.Add($"genre={Uri.EscapeDataString(selectedGenre)}");

        if (includeTagIds.Count > 0)
        {
            query.Add($"includeTags={string.Join(',', includeTagIds)}");
            query.Add($"includeMode={includeMode}");
        }

        if (excludeTagIds.Count > 0)
        {
            query.Add($"excludeTags={string.Join(',', excludeTagIds)}");
            query.Add($"excludeMode={excludeMode}");
        }

        var res = await Http.GetAsync($"api/library/artists/tags/counts?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var list = await res.Content.ReadFromJsonAsync<List<TagCountItem>>() ?? new List<TagCountItem>();
        tagCounts = list.ToDictionary(x => x.id, x => x.count);
        await InvokeAsync(StateHasChanged);
    }

    private int GetTagCount(long tagId)
    {
        return tagCounts.TryGetValue(tagId, out var c) ? c : 0;
    }

    private sealed class TagCountItem { public long id { get; set; } public string name { get; set; } = string.Empty; public int count { get; set; } }
}


