@page "/artists"
@inject LocalStorageService Store
@inject IJSRuntime JS
@inject HttpClient Http
@inject AiChatDrawerService AiDrawer
@using System.Text.Json
@implements IAsyncDisposable

<PageTitle>Library Manager - Artyści</PageTitle>

<div class="container-fluid py-3">
    <div class="library-controls-sentinel" @ref="controlsSentinel" aria-hidden="true"></div>
    <div class="library-controls-dock @(ControlsCollapsed ? "is-collapsed" : string.Empty)">
    @if (ControlsCollapsed)
    {
        <div class="library-controls-toggle-row">
            <button type="button" class="library-controls-toggle" title="Pokaż filtry artystów" aria-label="Pokaż filtry artystów" aria-expanded="false" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▼</span></button>
        </div>
    }
    else
    {
        @if (controlsPastAnchor)
        {
            <div class="library-controls-toggle-row">
                <button type="button" class="library-controls-toggle" title="Zwiń filtry artystów" aria-label="Zwiń filtry artystów" aria-expanded="true" @onclick="ToggleControlsVisibility"><span aria-hidden="true">▲</span></button>
            </div>
        }

    <section class="library-toolbar" aria-label="Filtry i akcje artystów">
        <div class="library-toolbar-heading"><h4 class="mb-0">Artyści <span class="library-results-count">@GetResultCountText(filteredArtists.Count, "artysta", "artystów", "artystów")</span></h4></div>
        <div class="library-search-group">
            <input class="form-control form-control-sm input-dark" type="text" placeholder="Szukaj artysty (AND)" @bind="LocalSearch" @bind:event="oninput" />
        </div>
        <div class="library-filter-fields">
            <select class="form-select form-select-sm w-auto select-dark" @bind="selectedGenre">
                <option value="">Wszystkie gatunki</option>
                @foreach (var g in availableGenres)
                {
                    <option value="@g">@g</option>
                }
            </select>


            <select class="form-select form-select-sm w-auto select-dark" @bind="sortKey">
                <option value="name">Nazwa</option>
                <option value="popularity">Popularność</option>
                <option value="weight">Waga tagu</option>
            </select>
            <select class="form-select form-select-sm w-auto select-dark" @bind="sortOrder">
                <option value="asc">Rosnąco</option>
                <option value="desc">Malejąco</option>
            </select>
        </div>
        <div class="library-toolbar-actions" aria-label="Akcje filtrowania">
            <button class="btn btn-sm album-action-button album-action-muted" title="Wyczyść wszystkie filtry" @onclick="ResetFilters"><AppIcon Name="reset" /><span class="album-action-label">Resetuj</span></button>
            <button class="btn btn-sm album-action-button album-action-apply" title="Zastosuj filtry" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span class="album-action-label">Zastosuj</span></button>
            <button class="btn btn-sm album-action-button album-action-muted" title="Pokaż lub ukryj filtry tagów" aria-expanded="@showTagFilters" @onclick="ToggleTagFilters"><AppIcon Name="tag" /><span class="album-action-label">Tagi</span><span class="album-action-state" aria-hidden="true">@(showTagFilters ? "▼" : "▶")</span></button>
        </div>
        <div class="library-playback-actions">
            <button class="btn btn-sm album-action-button album-action-random" title="Wylosuj artystę z bieżących wyników" @onclick="PickRandomArtist"><AppIcon Name="shuffle" /><span class="album-action-label">Losuj</span></button>
            <label class="tag-visibility-toggle" title="@(HasTagCriteria ? "Wyszukiwanie poza biblioteką jest niedostępne przy filtrach tagów" : "Dołącz wyniki wyszukiwania Spotify")">
                <input type="checkbox" @bind="searchOutsideLibrary" disabled="@HasTagCriteria" /> <span>Szukaj poza swoją biblioteką</span>
            </label>
        </div>
    </section>

    <section class="saved-filters-panel" aria-labelledby="artists-saved-filters-heading">
        <h5 id="artists-saved-filters-heading" class="saved-filters-heading">Zapisane filtry</h5>
        <div class="saved-filters-fields">
        <select class="form-select form-select-sm w-auto select-dark" @bind="selectedSavedFilterId">
            <option value="">Wybierz filtr...</option>
            @foreach (var f in savedFilters)
            {
                <option value="@f.Id.ToString()">@f.Name</option>
            }
        </select>
        <input class="form-control form-control-sm input-dark" placeholder="Nazwa filtra" @bind="newFilterName" />
        </div>
        <div class="saved-filters-actions">
        <button class="btn btn-sm album-action-button album-action-save" title="Zapisz jako nowy" @onclick="SaveCurrentFilter"><AppIcon Name="save" /><span class="album-action-label">Zapisz</span></button>
        <button class="btn btn-sm album-action-button album-action-muted" title="Zastosuj wybrany" @onclick="ApplySelectedFilter"><AppIcon Name="load" /><span class="album-action-label">Wczytaj</span></button>
        <button class="btn btn-sm album-action-button album-action-warning" title="Zmień nazwę / nadpisz" @onclick="RenameSelectedFilter"><AppIcon Name="edit" /><span class="album-action-label">Zmień nazwę</span></button>
        <button class="btn btn-sm album-action-button album-action-danger" title="Usuń wybrany" @onclick="DeleteSelectedFilter"><AppIcon Name="delete" /><span class="album-action-label">Usuń</span></button>
        </div>
    </section>

    @if (showTagFilters)
    {
        <section class="library-tag-filters" aria-label="Filtry tagów">
            <div class="input-group input-group-sm tag-filter-search">
                <input class="form-control input-dark" type="search" placeholder="Szukaj tagu" aria-label="Szukaj w filtrach tagów" @bind="tagSearch" @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(tagSearch))
                {
                    <button type="button" class="btn btn-outline-light" title="Wyczyść wyszukiwanie tagów" aria-label="Wyczyść wyszukiwanie tagów" @onclick="ClearTagSearch">×</button>
                }
            </div>
            <div class="d-flex flex-column gap-1 flex-fill">
                @if (showTagsGrouped)
                {
                    <div class="tag-groups-container mt-2">
                    @foreach (var group in GetGroupedTags())
                    {
                        <section class="tag-group" aria-label="Kategoria tagów: @group.Name">
                            <h6 class="tag-group-heading">@if (group.IsPinnedGroup) { <AppIcon Name="pin" Class="tag-pin-icon" /> }@group.Name</h6>
                            <div class="tag-chips-container">
                            @foreach (var t in group.Tags)
                            {
                                var state = GetTagState(t.Id);
                                var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                                var count = GetTagCount(t.Id);
                                <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@group.IsPinnedGroup" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                            }
                            </div>
                        </section>
                    }
                    </div>
                }
                else
                {
                <div class="tag-chips-container mt-2">
                @foreach (var t in GetVisibleTags())
                    {
                        var state = GetTagState(t.Id);
                        var css = state == 1 ? "tag-include" : state == 2 ? "tag-exclude" : "tag-none";
                        var count = GetTagCount(t.Id);
                        <TagFilterChip TagId="@t.Id" Name="@t.Name" Count="@count" State="@state" IsPinnedShortcut="@t.IsPinnedShortcut" Rule="@GetTagStrengthRule(t.Id)" CycleState="CycleTagState" CycleOperator="CycleTagStrengthOperator" StrengthChanged="SetTagStrength" />
                }
                </div>
                }
                <div class="tag-filter-controls">
                    <button type="button" class="tag-mode-chip tag-include" title="Tryb łączenia włączonych tagów" aria-label="Tryb łączenia włączonych tagów: @((includeMode == "and") ? "AND" : "OR")" @onclick="ToggleIncludeMode"><span>Włączone</span><strong>@((includeMode == "and") ? "AND" : "OR")</strong></button>
                    <button type="button" class="tag-mode-chip tag-exclude" title="Tryb łączenia wykluczonych tagów" aria-label="Tryb łączenia wykluczonych tagów: @((excludeMode == "and") ? "AND" : "OR")" @onclick="ToggleExcludeMode"><span>Wykluczone</span><strong>@((excludeMode == "and") ? "AND" : "OR")</strong></button>
                    <button type="button" class="tag-layout-toggle" title="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-label="@(showTagsGrouped ? "Pokaż płaską listę tagów" : "Pogrupuj tagi według kategorii")" aria-pressed="@showTagsGrouped" @onclick="ToggleTagLayout"><span>@(showTagsGrouped ? "Lista tagów" : "Pogrupuj tagi")</span><strong aria-hidden="true">@(showTagsGrouped ? "≡" : "▦")</strong></button>
                    <label class="tag-visibility-toggle"><input type="checkbox" @bind="showUnassignedTags" @bind:after="SaveTagVisibility" /> <span>Pokaż nieprzypisane tagi</span></label>
                </div>
            </div>
        </section>
    }
    }
    </div>

    @{
        var activeFilterChips = GetActiveFilterChips();
    }
    @if (activeFilterChips.Count > 0 || FiltersPending)
    {
        <section class="active-library-filters mb-3" aria-label="Aktywne filtry artystów">
            <span class="active-library-filters-label">@(FiltersPending ? "Oczekuje zastosowania:" : "Aktywne filtry:")</span>
            <div class="active-library-filter-chips">
                @foreach (var chip in activeFilterChips)
                {
                    <button type="button" class="@chip.CssClass" title="Usuń filtr: @chip.Label" @onclick="chip.ClearAsync"><span>@chip.Label</span><span class="active-library-filter-chip-remove" aria-hidden="true">×</span></button>
                }
            </div>
            @if (FiltersPending)
            {
                <button type="button" class="btn btn-sm album-action-button album-action-apply active-library-filters-apply" @onclick="ApplyFiltersAsync"><AppIcon Name="apply" /><span>Filtruj</span></button>
            }
        </section>
    }

    @if (filteredArtists.Count == 0)
    {
        <section class="library-empty-results" role="status">
            <p>Żaden artysta nie spełnia zastosowanych filtrów.</p>
            <button type="button" class="btn btn-sm album-action-button album-action-muted" @onclick="ResetAndApplyFiltersAsync"><AppIcon Name="reset" /><span>Resetuj filtry</span></button>
        </section>
    }

    <div class="library-card-grid">
        @foreach (var a in filteredArtists)
        {
            var libraryCss = a.IsInLibrary ? string.Empty : "artist-not-in-library";
            <div class="library-card-grid-item">
                <div class="card bg-dark text-light h-100">
                    @if (a.Images?.Any() == true)
                    {
                        <div class="artist-image-square @libraryCss" style="position:relative;">
                            <img src="@GetBestImageUrl(a.Images)" alt="@a.Name">
                            <button class="artist-play-overlay" title="Odtwórz top utwory"
                                    @onclick="() => PlayArtistTopTracks(a.Id)">▶</button>
                            @if (a.IsInLibrary)
                            {
                                <button class="artist-queue-overlay artist-card-note" title="Edytuj prywatną notatkę" aria-label="Edytuj notatkę artysty: @a.Name"
                                        @onclick="() => OpenArtistNote(a)"><AppIcon Name="edit" /></button>
                            }
                            <button class="btn btn-sm btn-outline-danger" title="Usuń z biblioteki" style="position:absolute; right:6px; top:6px;"
                                    @onclick="() => ConfirmRemoveArtist(a.Id)">✖</button>
                        </div>
                    }
                    @if (!a.IsInLibrary)
                    {
                        <div class="px-3 pt-3">
                            <span class="badge bg-outline-primary text-primary">Poza biblioteką</span>
                        </div>
                    }
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="card-title mb-1"><a href="/artist/@a.Id" class="link-light text-decoration-none">@a.Name</a></h6>
                            <span class="badge bg-secondary">@a.Popularity</span>
                        </div>
                        
                        @if (a.Genres?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Gatunki:</small>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var genre in a.Genres)
                                    {
                                        <span class="badge bg-outline-light text-light" style="font-size: 0.7rem;">@genre</span>
                                    }
                                </div>
                            </div>
                        }
                        
                        @if (a.Tags?.Any() == true)
                        {
                            <div class="mb-2">
                                <small class="text-muted">Tagi:</small>
                                <div class="mt-1">
                                    <TagPreview Tags="@(a.Tags.Select(tag => new TagBadge { TagId = tag.TagId, TagName = tag.TagName, TagGroupName = tag.TagGroupName, Strength = tag.Strength }).ToList())" OnTagClick="@(tagId => SelectArtistTag(a.Id, tagId))" />
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(a.Note))
                        {
                            <p class="item-note-preview" title="@a.Note">@a.Note</p>
                        }
                        
                        <div class="mt-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-light" disabled="@(!a.IsInLibrary)" @onclick="() => OpenArtistTagging(a.Id)">Taguj</button>
                                @if (a.IsInLibrary)
                                {
                                    <button class="btn btn-sm album-card-tag" title="Edytuj prywatną notatkę" aria-label="Edytuj notatkę artysty: @a.Name" @onclick="() => OpenArtistNote(a)"><AppIcon Name="edit" /><span>Notatka</span></button>
                                }
                                @if (!a.IsInLibrary)
                                {
                                    <button class="btn btn-sm album-card-tag" @onclick="() => AddArtistToLibraryAsync(a.Id)"><AppIcon Name="save" /><span>Dodaj do biblioteki</span></button>
                                }
                                @if (aiAvailable)
                                {
                                    <AiContextMenu Items="GetArtistAiMenuItems(a.Id, a.Name)" AriaLabel="Więcej opcji dla wykonawcy" OpenUpwards="true" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showArtistTagging && taggingArtistId != null)
{
    <TaggingPanel Title="Tagowanie artysty"
                  ItemType="artist"
                  SpotifyItemId="@taggingArtistId"
                  Items="artistTagItems"
                  Tags="GetArtistTagBadges()"
                  Placeholder="Taguj artystę..."
                  OnChanged="ApplyTaggedArtistState"
                  OnClose="CloseArtistTagging" />
}

@if (showItemNotePanel && taggingNoteArtistId != null)
{
    <ItemNotePanel Title="@ArtistNoteTitle"
                   ItemType="artist"
                   SpotifyItemId="@taggingNoteArtistId"
                   Content="@taggingNoteContent"
                   OnChanged="ApplyArtistNoteState"
                   OnClose="CloseArtistNote" />
}

@code {
    private List<SavedFilterItem> savedFilters = new();
    private string? selectedSavedFilterId;
    private string? newFilterName;
    private sealed class SavedFilterItem { public long Id { get; set; } public string Name { get; set; } = string.Empty; public string Scope { get; set; } = string.Empty; public string? ContextId { get; set; } public string PayloadJson { get; set; } = string.Empty; }

    private string sortKey = "name";
    private string sortOrder = "asc";
    private string? selectedGenre;
    private string? selectedTagFilter;
    private string? selectedTagSort;
    private bool searchOutsideLibrary;
    private List<Artist> artists = new();
    private List<Artist> filteredArtists = new();
    private List<TagDto> availableTags = new();
    private List<TagGroupDto> tagGroups = new();
    private List<string> availableGenres = new();
    private HashSet<long> includeTagIds = new();
    private HashSet<long> excludeTagIds = new();
    private Dictionary<long, TagStrengthFilterState> tagStrengthFilters = new();
    private string includeMode = "or";
    private string excludeMode = "or";
    private bool showTagFilters = true;
    private ElementReference controlsSentinel;
    private DotNetObjectReference<Artists>? controlsObserverRef;
    private bool controlsPastAnchor;
    private bool controlsManuallyCollapsed;
    private bool ControlsCollapsed => controlsPastAnchor && controlsManuallyCollapsed;
    private bool showTagsGrouped;
    private const string TagLayoutStoreKey = "tag-layout:grouped";
    private const string TagVisibilityStoreKey = "tag-visibility:show-unassigned";
    private bool showUnassignedTags;
    private string? tagSearch;

    private Dictionary<string, float?> hoverByKey = new();
    private Dictionary<string, long?> selectedTagByArtist = new();
    private bool showArtistTagging = false;
    private string? taggingArtistId;
    private bool showItemNotePanel;
    private string? taggingNoteArtistId;
    private string? taggingNoteArtistName;
    private string? taggingNoteContent;
    private string ArtistNoteTitle => $"Notatka: {taggingNoteArtistName}";
    private Dictionary<long, int> tagCounts = new();
    private bool aiAvailable;
    private ArtistFilterSnapshot? appliedFilters;
    private bool HasTagCriteria => !string.IsNullOrWhiteSpace(selectedTagFilter) || !string.IsNullOrWhiteSpace(selectedTagSort) || includeTagIds.Count > 0 || excludeTagIds.Count > 0 || sortKey == "weight";
    private bool FiltersPending => appliedFilters is null || !CaptureCurrentFilters().Matches(appliedFilters);

    protected override async Task OnInitializedAsync()
    {
        AiDrawer.Changed += HandleAiAccessChanged;
        aiAvailable = AiDrawer.AccessLoaded && AiDrawer.IsAllowed;
        await LoadTagLayout();
        await LoadTagVisibility();
        await LoadFromStore();
        await LoadGenres();
        await LoadAvailableTags();
        await ApplyFiltersAsync();
        await LoadSavedFilters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        controlsObserverRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("libraryControls.observe", controlsSentinel, controlsObserverRef);
    }

    [JSInvokable]
    public Task SetControlsPastAnchor(bool isPastAnchor)
    {
        if (controlsPastAnchor == isPastAnchor)
            return Task.CompletedTask;

        controlsPastAnchor = isPastAnchor;
        if (!controlsPastAnchor)
            controlsManuallyCollapsed = false;

        return InvokeAsync(StateHasChanged);
    }

    private void ToggleControlsVisibility() => controlsManuallyCollapsed = !ControlsCollapsed;

    public async ValueTask DisposeAsync()
    {
        AiDrawer.Changed -= HandleAiAccessChanged;
        try { await JS.InvokeVoidAsync("libraryControls.disconnect"); } catch (JSDisconnectedException) { }
        controlsObserverRef?.Dispose();
    }

    private void HandleAiAccessChanged()
    {
        var available = AiDrawer.AccessLoaded && AiDrawer.IsAllowed;
        if (aiAvailable == available) return;
        aiAvailable = available;
        _ = InvokeAsync(StateHasChanged);
    }

    private static IReadOnlyList<AiContextMenuItem> GetArtistAiMenuItems(string artistId, string artistName) =>
        string.IsNullOrWhiteSpace(artistId)
            ? Array.Empty<AiContextMenuItem>()
            : new[]
            {
                new AiContextMenuItem("Zapytaj AI o wykonawcę", new AiChatContext
                {
                    ItemType = "artist",
                    SpotifyItemId = artistId,
                    DisplayName = artistName
                })
            };

    private async Task LoadSavedFilters()
    {
        var res = await Http.GetAsync("api/library/filters?scope=artists");
        if (!res.IsSuccessStatusCode) return;
        savedFilters = await res.Content.ReadFromJsonAsync<List<SavedFilterItem>>() ?? new List<SavedFilterItem>();
    }

    private ArtistFilterSnapshot CaptureCurrentFilters()
    {
        if (HasTagCriteria)
            searchOutsideLibrary = false;

        return new ArtistFilterSnapshot(sortKey, sortOrder, selectedGenre, selectedTagFilter, selectedTagSort, localSearch, includeMode, excludeMode, includeTagIds.OrderBy(id => id).ToArray(), excludeTagIds.OrderBy(id => id).ToArray(), TagStrengthFilters.Capture(includeTagIds, tagStrengthFilters), TagStrengthFilters.Capture(excludeTagIds, tagStrengthFilters), searchOutsideLibrary);
    }

    private async Task ApplyFiltersAsync()
    {
        var filters = CaptureCurrentFilters();
        if (await LoadArtists(filters))
            appliedFilters = filters;
    }

    private async Task<bool> LoadArtists(ArtistFilterSnapshot? requestedFilters = null)
    {
        var filters = requestedFilters ?? appliedFilters ?? CaptureCurrentFilters();
        var query = new List<string> { $"sort={filters.SortKey}", $"order={filters.SortOrder}" };

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter)) query.Add($"tags={filters.SelectedTagFilter}");
        if (!string.IsNullOrEmpty(filters.SelectedGenre)) query.Add($"genre={Uri.EscapeDataString(filters.SelectedGenre)}");
        if (!string.IsNullOrEmpty(filters.SelectedTagSort)) query.Add($"sortTagId={filters.SelectedTagSort}");
        if (!string.IsNullOrWhiteSpace(filters.LocalSearch)) query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");
        if (filters.SearchOutsideLibrary && !string.IsNullOrWhiteSpace(filters.LocalSearch)) query.Add("includeExternal=true");
        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
            var strengths = TagStrengthFilters.ToQuery(filters.IncludeTagStrengths);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"includeTagStrengths={Uri.EscapeDataString(strengths)}");
        }
        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
            var strengths = TagStrengthFilters.ToQuery(filters.ExcludeTagStrengths);
            if (!string.IsNullOrEmpty(strengths)) query.Add($"excludeTagStrengths={Uri.EscapeDataString(strengths)}");
        }

        var res = await Http.GetAsync($"api/library/artists?{string.Join('&', query)}");
        if (!res.IsSuccessStatusCode)
            return false;

        var payload = await res.Content.ReadFromJsonAsync<ArtistsResponse>();
        artists = payload?.items ?? new List<Artist>();
        // Utrzymaj wybór tagu jeśli nadal istnieje
        foreach (var a in artists)
        {
            if (!selectedTagByArtist.ContainsKey(a.Id))
            {
                selectedTagByArtist[a.Id] = null;
            }
        }

        ApplyLocalFilter(filters.LocalSearch);
        await LoadArtistTagCounts(filters);

        await SaveToStore();
        return true;
    }

    private async Task LoadAvailableTags()
    {
        // Pobierz wszystkie tagi użytkownika i filtruj tylko ForArtist
        var tagsRequest = Http.GetAsync("api/tags");
        var groupsRequest = Http.GetAsync("api/tags-group");
        await Task.WhenAll(tagsRequest, groupsRequest);

        var res = await tagsRequest;
        if (!res.IsSuccessStatusCode)
            return;

        var allTags = await res.Content.ReadFromJsonAsync<List<TagDto>>() ?? new List<TagDto>();
        var groupsResponse = await groupsRequest;
        tagGroups = groupsResponse.IsSuccessStatusCode
            ? await groupsResponse.Content.ReadFromJsonAsync<List<TagGroupDto>>() ?? new List<TagGroupDto>()
            : new List<TagGroupDto>();
        availableTags = allTags.Where(t => t.ForArtist).OrderBy(t => t.Name).ToList();
        artistTagItems = availableTags.Select(t => new TagItem { Id = t.Id, Name = t.Name, Aliases = t.Aliases, TagGroupId = t.TagGroupId, IsPinned = t.IsPinned }).ToList();
        await LoadArtistTagCounts();
    }

    private async Task LoadGenres()
    {
        var res = await Http.GetAsync("api/library/artists/genres");
        if (!res.IsSuccessStatusCode)
            return;
        var list = await res.Content.ReadFromJsonAsync<List<string>>() ?? new List<string>();
        availableGenres = list;
    }

    private RenderFragment StarRating(string key, float value, Func<float, Task> onChange) => builder =>
    {
        int seq = 0;
        var display = hoverByKey.TryGetValue(key, out var h) && h.HasValue ? h.Value : value;
        builder.OpenElement(seq++, "span");
        builder.AddAttribute(seq++, "style", "display:inline-flex; align-items:center;");
        builder.AddAttribute(seq++, "title", $"{display:0.0}");
        for (int i = 1; i <= 6; i++)
        {
            var star = i;
            var fill = display >= star ? 1.0f : (display >= star - 0.5f ? 0.5f : 0f);

            // kontener gwiazdki
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "style", "position:relative; display:inline-block; width:2rem; height:2rem; line-height:2rem; font-size:2rem; margin-right:6px;");
            builder.AddAttribute(seq++, "onmouseleave", EventCallback.Factory.Create(this, () => { if (hoverByKey.ContainsKey(key)) hoverByKey.Remove(key); }));

            // pusty kontur
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-secondary");
            builder.AddAttribute(seq++, "style", "position:absolute; inset:0; pointer-events:none;");
            builder.AddContent(seq++, "☆");
            builder.CloseElement();

            // wypełnienie (połówka/całość) przycięte szerokością
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "text-warning");
            var width = fill >= 1.0f ? "100%" : (fill >= 0.5f ? "50%" : "0%");
            builder.AddAttribute(seq++, "style", $"position:absolute; inset:0; width:{width}; overflow:hidden; white-space:nowrap; pointer-events:none;");
            builder.AddContent(seq++, "★");
            builder.CloseElement();

            // hit area lewa połowa
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; left:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star - 0.5f; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star - 0.5f)));
            builder.CloseElement();

            // hit area prawa połowa
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "role", "button");
            builder.AddAttribute(seq++, "style", "position:absolute; right:0; top:0; width:50%; height:100%; background:transparent;");
            builder.AddAttribute(seq++, "onmouseover", EventCallback.Factory.Create(this, () => { hoverByKey[key] = star; }));
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, async () => await onChange(star)));
            builder.CloseElement();

            builder.CloseElement();
        }
        builder.CloseElement();
    };

