    private int GetTagState(long tagId)
    {
        if (includeTagIds.Contains(tagId))
            return 1; // include

        if (excludeTagIds.Contains(tagId))
            return 2; // exclude

        return 0; // none
    }

    private void CycleTagState(long tagId)
    {
        var state = GetTagState(tagId);

        if (state == 0)
        {
            includeTagIds.Add(tagId);
            tagStrengthFilters.TryAdd(tagId, new TagStrengthFilterState());
            searchOutsideLibrary = false;
            return;
        }

        if (state == 1)
        {
            includeTagIds.Remove(tagId);
            excludeTagIds.Add(tagId);
            searchOutsideLibrary = false;
            return;
        }

        // state == 2
        excludeTagIds.Remove(tagId);
        tagStrengthFilters.Remove(tagId);
    }

    private TagStrengthFilterState? GetTagStrengthRule(long tagId) => GetTagState(tagId) == 0 ? null : tagStrengthFilters.GetValueOrDefault(tagId) ?? (tagStrengthFilters[tagId] = new TagStrengthFilterState());
    private async Task CycleTagStrengthOperator(long tagId)
    {
        var rule = GetTagStrengthRule(tagId);
        if (rule is null) return;
        rule.Operator = rule.Operator == "gte" ? "lte" : rule.Operator == "lte" ? "all" : "gte";
        await SaveToStore();
    }
    private async Task SetTagStrength(TagStrengthValueChanged change)
    {
        var rule = GetTagStrengthRule(change.TagId);
        if (rule is null) return;
        rule.Value = change.Value;
        await SaveToStore();
    }

    private void ToggleIncludeMode()
    {
        includeMode = includeMode == "and" ? "or" : "and";
    }

    private void ToggleExcludeMode()
    {
        excludeMode = excludeMode == "and" ? "or" : "and";
    }
    private async Task ToggleTagFilters()
    {
        showTagFilters = !showTagFilters;
        await SaveToStore();
    }

    private async Task LoadTagLayout()
    {
        showTagsGrouped = await Store.GetItemAsync<bool?>(TagLayoutStoreKey) ?? false;
    }

    private async Task ToggleTagLayout()
    {
        showTagsGrouped = !showTagsGrouped;
        await Store.SetItemAsync(TagLayoutStoreKey, showTagsGrouped);
    }

    private async Task LoadTagVisibility()
    {
        showUnassignedTags = await Store.GetItemAsync<bool?>(TagVisibilityStoreKey) ?? false;
    }

    private Task SaveTagVisibility() => Store.SetItemAsync(TagVisibilityStoreKey, showUnassignedTags);

    private IEnumerable<TagDto> GetNormalVisibleTags() => ExpandTagVariants(showUnassignedTags
        ? availableTags
        : availableTags.Where(tag => GetTagCount(tag.Id) > 0 || includeTagIds.Contains(tag.Id) || excludeTagIds.Contains(tag.Id)))
        .Where(tag => string.IsNullOrWhiteSpace(tagSearch) || tag.Name.Contains(tagSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private IEnumerable<TagDto> GetVisibleTags()
    {
        var tags = GetNormalVisibleTags().ToList();
        return tags.Where(tag => tag.IsPinned).Select(CreatePinnedShortcut).Concat(tags);
    }

    private static IEnumerable<TagDto> ExpandTagVariants(IEnumerable<TagDto> tags) => tags.SelectMany(tag => new[] { tag }.Concat(tag.Aliases
        .Where(alias => !string.Equals(alias, tag.Name, StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Select(alias => new TagDto { Id = tag.Id, Name = alias, ForArtist = tag.ForArtist, IsPinned = tag.IsPinned, TagGroupId = tag.TagGroupId })));

    private static TagDto CreatePinnedShortcut(TagDto tag) => new() { Id = tag.Id, Name = tag.Name, ForArtist = tag.ForArtist, IsPinned = true, IsPinnedShortcut = true, TagGroupId = tag.TagGroupId };

    private void ClearTagSearch() => tagSearch = null;

    private IEnumerable<TagGroupView> GetGroupedTags()
    {
        var groupedTagIds = tagGroups.Select(group => group.Id).ToHashSet();
        var visibleTags = GetNormalVisibleTags().ToList();
        var pinnedTags = visibleTags.Where(tag => tag.IsPinned).Select(CreatePinnedShortcut).ToList();
        var groups = tagGroups.OrderBy(group => group.Name).Select(group => new TagGroupView { Name = group.Name, Tags = visibleTags.Where(tag => tag.TagGroupId == group.Id).OrderBy(tag => tag.Name).ToList() }).Where(group => group.Tags.Count > 0).ToList();
        if (pinnedTags.Count > 0)
            groups.Insert(0, new TagGroupView { Name = "Przypięte", Tags = pinnedTags, IsPinnedGroup = true });
        var ungroupedTags = visibleTags.Where(tag => !groupedTagIds.Contains(tag.TagGroupId)).OrderBy(tag => tag.Name).ToList();
        if (ungroupedTags.Count > 0)
            groups.Add(new TagGroupView { Name = "Pozostałe tagi", Tags = ungroupedTags });
        return groups;
    }

    private async Task LoadArtistTagCounts(ArtistFilterSnapshot? requestedFilters = null)
    {
        var filters = requestedFilters ?? appliedFilters ?? CaptureCurrentFilters();
        var query = new List<string>();

        if (!string.IsNullOrEmpty(filters.SelectedTagFilter))
            query.Add($"tags={filters.SelectedTagFilter}");

        if (!string.IsNullOrEmpty(filters.SelectedGenre))
            query.Add($"genre={Uri.EscapeDataString(filters.SelectedGenre)}");

        if (!string.IsNullOrWhiteSpace(filters.LocalSearch))
            query.Add($"search={Uri.EscapeDataString(filters.LocalSearch)}");

        if (filters.IncludeTagIds.Length > 0)
        {
            query.Add($"includeTags={string.Join(',', filters.IncludeTagIds)}");
            query.Add($"includeMode={filters.IncludeMode}");
        }

        if (filters.ExcludeTagIds.Length > 0)
        {
            query.Add($"excludeTags={string.Join(',', filters.ExcludeTagIds)}");
            query.Add($"excludeMode={filters.ExcludeMode}");
        }

        var res = await Http.GetAsync($"api/library/artists/tags/counts?{string.Join('&', query)}");

        if (!res.IsSuccessStatusCode)
            return;

        var list = await res.Content.ReadFromJsonAsync<List<TagCountItem>>() ?? new List<TagCountItem>();
        tagCounts = list.ToDictionary(x => x.id, x => x.count);
        await InvokeAsync(StateHasChanged);
    }

    private int GetTagCount(long tagId)
    {
        return tagCounts.TryGetValue(tagId, out var c) ? c : 0;
    }

    private sealed class TagCountItem { public long id { get; set; } public string name { get; set; } = string.Empty; public int count { get; set; } }
}


