    private List<ActiveFilterChip> GetActiveFilterChips()
    {
        var chips = new List<ActiveFilterChip>();
        if (!string.IsNullOrWhiteSpace(localSearch)) chips.Add(new($"Szukaj: {localSearch}", "active-library-filter-chip", () => { localSearch = null; return Task.CompletedTask; }));
        if (!string.IsNullOrWhiteSpace(selectedGenre)) chips.Add(new($"Gatunek: {selectedGenre}", "active-library-filter-chip", () => { selectedGenre = null; return Task.CompletedTask; }));
        if (sortKey != "name" || sortOrder != "asc") chips.Add(new($"Sortowanie: {sortKey} ({sortOrder})", "active-library-filter-chip", () => { sortKey = "name"; sortOrder = "asc"; return Task.CompletedTask; }));
        foreach (var id in includeTagIds) { var name = availableTags.FirstOrDefault(tag => tag.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Włącz: {name} ({includeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-include", () => { includeTagIds.Remove(id); return Task.CompletedTask; })); }
        foreach (var id in excludeTagIds) { var name = availableTags.FirstOrDefault(tag => tag.Id == id)?.Name ?? id.ToString(); chips.Add(new($"Wyklucz: {name} ({excludeMode.ToUpperInvariant()})", "active-library-filter-chip active-library-filter-chip-exclude", () => { excludeTagIds.Remove(id); return Task.CompletedTask; })); }
        return chips;
