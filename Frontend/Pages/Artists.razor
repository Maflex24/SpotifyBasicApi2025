    private string? GetBestImageUrl(List<SpotifyImage> images)
    {
        if (images == null || images.Count == 0)
            return null;

        var ordered = images
            .Where(i => !string.IsNullOrWhiteSpace(i.Url))
            .OrderByDescending(i => i.Width ?? 0)
            .ThenByDescending(i => i.Height ?? 0)
            .ToList();

        return ordered.FirstOrDefault()?.Url ?? images.FirstOrDefault()?.Url;
    }

    private async Task PlayArtistTopTracks(string artistId)
    {
        var top = await Http.GetFromJsonAsync<TopTracksResponse>($"api/spotify/artists/{artistId}/top-tracks");
        var uris = top?.items?.Where(t => !string.IsNullOrWhiteSpace(t.Uri)).Select(t => t.Uri).ToList() ?? new List<string>();

        if (uris.Count == 0)
            return;

        var body = new
        {
            uris = uris
        };

        var res = await Http.PutAsJsonAsync("api/player/play", body);

        if (!res.IsSuccessStatusCode)
        {
            // spróbuj przenieść odtwarzanie na pierwsze dostępne urządzenie i zagrać ponownie
            var devices = await Http.GetFromJsonAsync<DevicesResponse>("api/player/devices");

            var first = devices?.Devices?.FirstOrDefault();

            if (first != null)
            {
                await Http.PutAsync($"api/player?deviceIdsCsv={Uri.EscapeDataString(first.Id)}&play=true", null);
                await Http.PutAsJsonAsync("api/player/play", body);
            }
        }
    }

