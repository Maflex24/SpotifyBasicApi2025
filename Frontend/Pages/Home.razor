@page "/"

<PageTitle>Library Manager - Strona główna</PageTitle>

<div class="container py-3">
    <h3>Spotify Library</h3>
    <p class="text-secondary">Zaloguj się do Spotify, aby przeglądać bibliotekę. Po zalogowaniu połącz konto Spotify z kontem aplikacji, aby zabezpieczyć tagi i archiwum.</p>

    <button class="btn btn-primary" @onclick="Login">Zaloguj przez Spotify</button>
    <button class="btn btn-outline-light ms-2" @onclick="LinkSpotify">Połącz z kontem aplikacji</button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mt-3">@Message</div>
    }
</div>

@inject HttpClient Http
@code {
    private string? Message;

    private async Task Login()
    {
        try
        {
            var res = await Http.GetAsync("api/auth/login");

            if (!res.IsSuccessStatusCode)
            {
                Message = "Błąd podczas generowania adresu logowania";
                return;
            }

            var json = await res.Content.ReadFromJsonAsync<AuthUrlResponse>();

            if (json?.authUrl is null)
            {
                Message = "Brak URL";
                return;
            }

            Navigation.NavigateTo(json.authUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
    }

    private async Task LinkSpotify()
    {
        var response = await Http.PostAsync("api/app-auth/spotify-link", null);
        Message = response.IsSuccessStatusCode
            ? "Konto Spotify zostało połączone."
            : await response.Content.ReadAsStringAsync();
    }

    [Microsoft.AspNetCore.Components.Inject]
    public required NavigationManager Navigation { get; set; }

    

    private sealed class AuthUrlResponse { public string? authUrl { get; set; } }
}
