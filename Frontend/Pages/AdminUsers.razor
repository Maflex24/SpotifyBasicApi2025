@page "/admin-users"
@inject HttpClient Http

<PageTitle>Konta systemowe</PageTitle>
<h1>Konta systemowe</h1>
@if (error != null) { <div class="alert alert-danger">@error</div> }
else if (users == null) { <p>Wczytywanie…</p> }
else
{
    <div class="card app-form-surface mb-3"><div class="card-body">
        <h2 class="h5">Dodaj konto</h2>
        <div class="row g-2"><div class="col-md-4"><input class="form-control" @bind="newNick" placeholder="Nick" /></div><div class="col-md-4"><input class="form-control" type="password" @bind="newPassword" placeholder="Hasło (min. 12 znaków)" /></div><div class="col-md-2 form-check pt-2"><input class="form-check-input" type="checkbox" @bind="newIsAdmin" id="newIsAdmin" /><label class="form-check-label" for="newIsAdmin">Administrator</label></div><div class="col-md-2"><button class="btn btn-primary" @onclick="Create">Dodaj</button></div></div>
    </div></div>
    <div class="table-responsive app-form-surface"><table class="table table-dark"><thead><tr><th>Nick</th><th>Administrator</th><th>Nowe hasło</th><th></th></tr></thead><tbody>
    @foreach (var user in users)
    {
        <tr><td><input class="form-control" @bind="user.Nick" /></td><td><input class="form-check-input" type="checkbox" @bind="user.IsAdmin" /></td><td><input class="form-control" type="password" @bind="user.NewPassword" placeholder="pozostaw puste" /></td><td class="text-nowrap"><button class="btn btn-sm btn-primary me-1" @onclick="() => Save(user)">Zapisz</button><button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(user.Id)">Usuń</button></td></tr>
    }
    </tbody></table></div>
}

@code {
    private List<AppUser>? users;
    private string? error;
    private string newNick = string.Empty, newPassword = string.Empty;
    private bool newIsAdmin;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { try { users = await Http.GetFromJsonAsync<List<AppUser>>("api/admin/app-users"); } catch { error = "Ten ekran jest dostępny tylko dla administratora systemu."; } }
    private async Task Create() { var result = await Http.PostAsJsonAsync("api/admin/app-users", new { nick = newNick, password = newPassword, isAdmin = newIsAdmin }); if (!result.IsSuccessStatusCode) error = await result.Content.ReadAsStringAsync(); else { newNick = newPassword = string.Empty; newIsAdmin = false; await Load(); } }
    private async Task Save(AppUser user) { var result = await Http.PutAsJsonAsync($"api/admin/app-users/{user.Id}", new { nick = user.Nick, isAdmin = user.IsAdmin, newPassword = user.NewPassword }); if (!result.IsSuccessStatusCode) error = await result.Content.ReadAsStringAsync(); else user.NewPassword = string.Empty; }
    private async Task Delete(long id) { var result = await Http.DeleteAsync($"api/admin/app-users/{id}"); if (!result.IsSuccessStatusCode) error = await result.Content.ReadAsStringAsync(); else await Load(); }
    private sealed class AppUser { public long Id { get; set; } public string Nick { get; set; } = string.Empty; public bool IsAdmin { get; set; } public string? NewPassword { get; set; } }
}
